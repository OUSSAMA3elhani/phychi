# Dependances - ne jamais televerser sur l'hebergement (C10 / W004)
node_modules/

# Variables d'environnement - jamais dans le depot ni dans le zip (C8 / W001)
.env
.env.local
.env.*.local

# Journaux
logs/
*.log
npm-debug.log*

# Systeme
.DS_Store
Thumbs.db

# Editeurs
.vscode/
.idea/

# Artefacts de deploiement
*.zip

deploy/

# Uploads dynamiques - ne pas suivre les fichiers televerses par les utilisateurs
public/uploads/*
!public/uploads/.gitkeep

# Fichiers lourds (>= 10 Mo) deportes sur Cloudflare R2
public/assets/large_files/




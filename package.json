{
  "name": "phychi",
  "version": "1.0.0",
  "description": "PhyChi - plateforme de cours, d'exercices et de ressources en physique et chimie pour l'enseignement superieur",
  "main": "server.js",
  "scripts": {
    "build": "node tools/create-sample-pdfs.js",
    "start": "node server.js",
    "dev": "node --watch server.js",
    "db:init": "node database/init.js",
    "deploy:package": "node tools/package-deploy.mjs"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "physique",
    "chimie",
    "education",
    "express",
    "mysql"
  ],
  "license": "MIT",
  "private": true,
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "dotenv": "^17.2.4",
    "ejs": "^6.0.1",
    "express": "^4.21.2",
    "express-mysql-session": "^3.0.3",
    "express-session": "^1.18.2",
    "helmet": "^8.1.0",
    "multer": "^2.2.0",
    "mysql2": "^3.15.3"
  }
}

# =============================================================================
# PhyChi - modele de configuration
#
# LOCAL (XAMPP)  : copiez ce fichier en `.env`. Les valeurs ci-dessous
#                  correspondent deja a un XAMPP par defaut.
# GODADDY        : NE televersez PAS de fichier .env (regle C8 / W001).
#                  Saisissez ces variables dans le panneau "Environment
#                  Variables" de l'interface Node.js Hosting.
#                  DB_HOST, DB_PORT, DB_NAME, DB_USER et DB_PASSWORD sont
#                  injectees automatiquement par la plateforme : ne les
#                  definissez pas a la main.
# =============================================================================

# Port d'ecoute. Sur GoDaddy, la plateforme impose PORT : ne pas le definir.
PORT=3000

NODE_ENV=development

# --- Base de donnees -------------------------------------------------------
# Valeurs par defaut d'un XAMPP local : root, sans mot de passe.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=phychi
DB_USER=root
DB_PASSWORD=

# --- Sessions --------------------------------------------------------------
# OBLIGATOIRE en production. Generez une valeur aleatoire longue :
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=

# --- Formulaire de contact -------------------------------------------------
# Adresse qui recoit les messages du formulaire de contact.
# Sur GoDaddy, definissez-la dans l'interface d'hebergement (jamais en dur).
# Non definie : les messages sont enregistres en base, sans envoi d'e-mail.
CONTACT_FORM_RECIPIENT_EMAIL=

# --- CORS ------------------------------------------------------------------
# Le front est servi par ce meme serveur : CORS est inutile en temps normal.
# Renseignez une liste d'origines separees par des virgules uniquement si un
# client externe doit appeler l'API.
CORS_ORIGINS=

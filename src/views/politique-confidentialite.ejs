<!DOCTYPE html>
<html lang="fr" class="scroll-smooth">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="PhyChi - Politique de confidentialité. Découvrez comment nous collectons, utilisons et protégeons vos données personnelles.">
    <meta name="theme-color" content="#0f172a">
    <title>PhyChi - Politique de Confidentialité</title>

    <!-- Application du thème avant le rendu (évite le flash blanc) -->
    <script>
        (function () {
            try {
                var saved = localStorage.getItem('psychi_theme');
                var prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
                if (saved === 'dark' || (!saved && prefersDark)) {
                    document.documentElement.classList.add('dark-theme');
                }
            } catch (e) { /* localStorage indisponible */ }
        })();
    </script>

    <!-- Typographie -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter+Tight:wght@500;600;700;800&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">

    <!-- Tailwind CSS + design system partagé -->
    <script src="https://cdn.tailwindcss.com?plugins=forms"></script>
    <script src="assets/theme.js"></script>
    <link rel="stylesheet" href="assets/ui.css">

    <script src="assets/ui.js" defer></script>
    <script src="script.js" defer></script>
    <!-- Liaison des formulaires avec l'API Express (servi par public/js/app.js) -->
    <script src="/js/app.js" defer></script>
</head>

<body class="bg-slate-50 font-sans text-slate-600 antialiased selection:bg-brand-600 selection:text-white dark:bg-slate-950 dark:text-slate-400">

    <a href="#contenu"
       class="sr-only focus:not-sr-only focus:fixed focus:left-6 focus:top-6 focus:z-[60] focus:rounded-xl focus:bg-brand-600 focus:px-5 focus:py-3 focus:text-sm focus:font-semibold focus:text-white focus:shadow-lift">
        Aller au contenu principal
    </a>

    <!-- ==================================================================
         EN-TÊTE
         ================================================================== -->
    <%- include('partials/header') %>

    <main id="contenu">

        <!-- En-tête de page -->
        <section class="relative isolate overflow-hidden border-b border-slate-200 bg-white dark:border-slate-800 dark:bg-slate-950">
            <%- include('partials/hero-decor') %>

            <div class="relative mx-auto max-w-7xl px-6 py-20 sm:py-24 lg:px-8">
                <nav aria-label="Fil d'Ariane" class="mb-8">
                    <ol class="flex items-center gap-2 text-sm text-slate-500 dark:text-slate-400">
                        <li><a href="/" class="transition-colors hover:text-brand-600 dark:hover:text-brand-400">Accueil</a></li>
                        <li aria-hidden="true" class="text-slate-300 dark:text-slate-600">/</li>
                        <li class="font-medium text-slate-900 dark:text-white">Politique de confidentialité</li>
                    </ol>
                </nav>

                <p class="text-sm font-semibold uppercase tracking-[0.18em] text-brand-600 dark:text-brand-400">Vos données</p>
                <h1 class="mt-4 max-w-3xl font-display text-4xl font-extrabold leading-tight tracking-tight text-slate-900 sm:text-5xl dark:text-white">
                    Politique de Confidentialité
                </h1>
                <p class="mt-5 max-w-2xl text-lg leading-relaxed text-slate-600 dark:text-slate-400">
                    Protection de vos données personnelles et respect de votre vie privée sur la plateforme PhyChi.
                </p>
            </div>
        </section>

        <!-- Corps de la page -->
        <div class="mx-auto grid max-w-7xl gap-12 px-6 py-16 lg:grid-cols-12 lg:gap-16 lg:px-8">

            <!-- Sommaire -->
            <aside class="lg:col-span-3">
                <nav aria-label="Sommaire de la page" class="lg:sticky lg:top-28">
                    <h2 class="text-xs font-semibold uppercase tracking-[0.16em] text-slate-400 dark:text-slate-500">Sur cette page</h2>
                    <ul class="mt-4 grid gap-1">
                            <li><a href="#collecte" class="block rounded-lg px-3 py-2 text-sm text-slate-500 transition-colors hover:bg-slate-100 hover:text-slate-900 dark:text-slate-400 dark:hover:bg-slate-800 dark:hover:text-white">1. Collecte des données personnelles</a></li>
                            <li><a href="#utilisation" class="block rounded-lg px-3 py-2 text-sm text-slate-500 transition-colors hover:bg-slate-100 hover:text-slate-900 dark:text-slate-400 dark:hover:bg-slate-800 dark:hover:text-white">2. Utilisation des données</a></li>
                            <li><a href="#conservation" class="block rounded-lg px-3 py-2 text-sm text-slate-500 transition-colors hover:bg-slate-100 hover:text-slate-900 dark:text-slate-400 dark:hover:bg-slate-800 dark:hover:text-white">3. Conservation et sécurité des données</a></li>
                            <li><a href="#cookies" class="block rounded-lg px-3 py-2 text-sm text-slate-500 transition-colors hover:bg-slate-100 hover:text-slate-900 dark:text-slate-400 dark:hover:bg-slate-800 dark:hover:text-white">4. Gestion des cookies</a></li>
                            <li><a href="#droits" class="block rounded-lg px-3 py-2 text-sm text-slate-500 transition-colors hover:bg-slate-100 hover:text-slate-900 dark:text-slate-400 dark:hover:bg-slate-800 dark:hover:text-white">5. Vos droits (accès, rectification, suppression)</a></li>
                    </ul>
                </nav>
            </aside>

            <!-- Article -->
            <article class="lg:col-span-9">
                <div class="grid gap-10 rounded-3xl border border-slate-200 bg-white p-8 shadow-soft sm:p-10 dark:border-slate-800 dark:bg-slate-900">
                    <section id="collecte" class="scroll-mt-28 border-b border-slate-200 pb-10 last:border-0 dark:border-slate-800">
                        <h2 class="font-display text-2xl font-extrabold tracking-tight text-slate-900 dark:text-white">1. Collecte des données personnelles</h2>
                        <div class="mt-4 grid gap-4">
                        <p class="text-[15px] leading-relaxed text-slate-600 dark:text-slate-400">Dans le cadre de l'utilisation du site PhyChi, nous pouvons être amenés à collecter les données personnelles suivantes :</p>
                        <ul class="mt-4 grid gap-3">
                            <li class="flex gap-3 text-[15px] leading-relaxed text-slate-600 dark:text-slate-400"><span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-brand-500" aria-hidden="true"></span><span><strong class="font-semibold text-slate-900 dark:text-white">Lors de l'inscription :</strong> nom, prénom, adresse e-mail et niveau d'études. <strong class="font-semibold text-slate-900 dark:text-white">Lors de l'envoi d'un message :</strong> nom, adresse e-mail et contenu du message envoyé via la page de <a href="/contact" class="font-semibold text-brand-600 underline-offset-4 hover:underline dark:text-brand-400">contact</a>. <strong class="font-semibold text-slate-900 dark:text-white">Données de navigation :</strong> adresse IP, type de navigateur et pages consultées à des fins purement statistiques.</span></li>
                        </ul>
                        </div>
                    </section>

                    <section id="utilisation" class="scroll-mt-28 border-b border-slate-200 pb-10 last:border-0 dark:border-slate-800">
                        <h2 class="font-display text-2xl font-extrabold tracking-tight text-slate-900 dark:text-white">2. Utilisation des données</h2>
                        <div class="mt-4 grid gap-4">
                        <p class="text-[15px] leading-relaxed text-slate-600 dark:text-slate-400">Les données collectées sont utilisées exclusivement pour :</p>
                        <ul class="mt-4 grid gap-3">
                            <li class="flex gap-3 text-[15px] leading-relaxed text-slate-600 dark:text-slate-400"><span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-brand-500" aria-hidden="true"></span><span>Gérer votre compte utilisateur et vos éléments sauvegardés dans la page <a href="/favoris" class="font-semibold text-brand-600 underline-offset-4 hover:underline dark:text-brand-400">favoris</a>.</span></li>
                            <li class="flex gap-3 text-[15px] leading-relaxed text-slate-600 dark:text-slate-400"><span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-brand-500" aria-hidden="true"></span><span>Répondre à vos demandes envoyées via le formulaire de contact.</span></li>
                            <li class="flex gap-3 text-[15px] leading-relaxed text-slate-600 dark:text-slate-400"><span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-brand-500" aria-hidden="true"></span><span>Améliorer la qualité des cours, des exercices et des services de la plateforme.</span></li>
                        </ul>
                        <p class="text-[15px] leading-relaxed text-slate-600 dark:text-slate-400">Vos données personnelles ne seront en aucun cas vendues, louées ou cédées à des tiers à des fins commerciales.</p>
                        </div>
                    </section>

                    <section id="conservation" class="scroll-mt-28 border-b border-slate-200 pb-10 last:border-0 dark:border-slate-800">
                        <h2 class="font-display text-2xl font-extrabold tracking-tight text-slate-900 dark:text-white">3. Conservation et sécurité des données</h2>
                        <div class="mt-4 grid gap-4">
                        <p class="text-[15px] leading-relaxed text-slate-600 dark:text-slate-400">Vos informations sont conservées de manière sécurisée tant que votre compte utilisateur reste actif. Vous pouvez à tout moment demander la suppression de vos données personnelles ou de votre compte en nous contactant.</p>
                        </div>
                    </section>

                    <section id="cookies" class="scroll-mt-28 border-b border-slate-200 pb-10 last:border-0 dark:border-slate-800">
                        <h2 class="font-display text-2xl font-extrabold tracking-tight text-slate-900 dark:text-white">4. Gestion des cookies</h2>
                        <div class="mt-4 grid gap-4">
                        <p class="text-[15px] leading-relaxed text-slate-600 dark:text-slate-400">Le site PhyChi peut utiliser des cookies techniquement nécessaires au bon fonctionnement de la session (maintien de la connexion au compte utilisateur, mémorisation des préférences de navigation).</p>
                        <p class="text-[15px] leading-relaxed text-slate-600 dark:text-slate-400">Vous pouvez configurer votre navigateur pour bloquer ou supprimer les cookies, bien que cela puisse altérer le fonctionnement de certaines fonctionnalités du site.</p>
                        </div>
                    </section>

                    <section id="droits" class="scroll-mt-28 border-b border-slate-200 pb-10 last:border-0 dark:border-slate-800">
                        <h2 class="font-display text-2xl font-extrabold tracking-tight text-slate-900 dark:text-white">5. Vos droits (accès, rectification, suppression)</h2>
                        <div class="mt-4 grid gap-4">
                        <p class="text-[15px] leading-relaxed text-slate-600 dark:text-slate-400">Conformément à la réglementation sur la protection des données personnelles, vous disposez d'un droit d'accès, de rectification, de modification et de suppression des données qui vous concernent.</p>
                        <p class="text-[15px] leading-relaxed text-slate-600 dark:text-slate-400">Pour exercer ces droits, vous pouvez modifier vos données depuis votre <a href="/profil" class="font-semibold text-brand-600 underline-offset-4 hover:underline dark:text-brand-400">profil</a> ou nous adresser une demande par e-mail via notre page de <a href="/contact" class="font-semibold text-brand-600 underline-offset-4 hover:underline dark:text-brand-400">contact</a>.</p>
                        </div>
                    </section>
                </div>

                <!-- Appel à l'action -->
                <div class="mt-8 flex flex-col items-start justify-between gap-5 rounded-3xl border border-slate-200 bg-white p-8 shadow-soft sm:flex-row sm:items-center dark:border-slate-800 dark:bg-slate-900">
                    <div>
                        <h2 class="font-display text-lg font-bold tracking-tight text-slate-900 dark:text-white">Exercer vos droits</h2>
                        <p class="mt-2 max-w-xl text-[15px] leading-relaxed text-slate-500 dark:text-slate-400">Pour toute demande d'accès, de rectification ou de suppression de vos données, contactez notre équipe.</p>
                    </div>
                    <a href="/contact" class="group inline-flex shrink-0 items-center gap-2 rounded-2xl bg-brand-600 px-6 py-3.5 text-sm font-semibold text-white shadow-glow transition-all duration-300 hover:-translate-y-0.5 hover:bg-brand-700">
                        Nous contacter
                        <svg class="h-4 w-4 transition-transform duration-300 group-hover:translate-x-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
                    </a>
                </div>
            </article>
        </div>
    </main>
    <!-- ==================================================================
         PIED DE PAGE
         ================================================================== -->
    <%- include('partials/footer') %>
</body>
</html>

<!DOCTYPE html>
<html lang="fr" class="scroll-smooth">
<head>
    <meta charset="UTF-8">
    <title><%= title %> - PhyChi Admin</title>
    <script src="https://cdn.tailwindcss.com?plugins=forms"></script>
    <script src="/assets/theme.js"></script>
    <link rel="stylesheet" href="/assets/ui.css">
    <script src="/assets/ui.js" defer></script>
    <script src="/js/app.js" defer></script>
</head>
<body class="bg-slate-50 font-sans text-slate-600 antialiased dark:bg-slate-950 dark:text-slate-400">
    <%- include('partials/sidebar') %>
    <div class="pl-72">
        <%- include('partials/header') %>
        <main class="p-8">

            <% if (typeof error !== 'undefined' && error) { %>
                <div role="alert" class="mb-6 flex items-start gap-3 rounded-2xl border border-rose-200 bg-rose-50 px-5 py-4 text-sm font-medium text-rose-800 dark:border-rose-500/30 dark:bg-rose-500/10 dark:text-rose-300">
                    <svg class="mt-0.5 h-5 w-5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="M12 8v4M12 16h.01"/></svg>
                    <span><%= error %></span>
                </div>
            <% } %>

            <div class="overflow-hidden rounded-3xl border border-slate-200 bg-white shadow-soft dark:border-slate-800 dark:bg-slate-900">
                <div class="flex flex-wrap items-center justify-between gap-4 border-b border-slate-200 p-6 dark:border-slate-800">
                    <div>
                        <h2 class="font-display text-lg font-bold text-slate-900 dark:text-white">Chapitres &amp; Fichiers PDF (<%= courses.length %>)</h2>
                        <p class="mt-1 text-sm text-slate-500 dark:text-slate-400">Organisation pédagogique : <strong>Discipline → Cours / Module → Chapitres</strong>.</p>
                    </div>
                    <div class="flex flex-wrap items-center gap-3">
                        <!-- Filtre par Discipline -->
                        <select id="admin-filter-discipline" class="rounded-xl border border-slate-200 bg-slate-50/50 py-2 px-3 text-xs font-medium text-slate-900 focus:border-brand-500 dark:border-slate-800 dark:bg-slate-950 dark:text-white">
                            <option value="toutes">Toutes les disciplines</option>
                            <% (typeof disciplines !== 'undefined' ? disciplines : []).forEach(function(d) { %>
                                <option value="<%= d.slug %>"><%= d.nom %></option>
                            <% }); %>
                        </select>

                        <!-- Filtre par Cours / Module -->
                        <select id="admin-filter-module" class="rounded-xl border border-slate-200 bg-slate-50/50 py-2 px-3 text-xs font-medium text-slate-900 focus:border-brand-500 dark:border-slate-800 dark:bg-slate-950 dark:text-white">
                            <option value="tous">Tous les cours / modules</option>
                            <% chapters.forEach(function(ch) { %>
                                <option value="<%= ch.id %>" data-disc-slug="<%= ch.discipline_slug %>"><%= ch.discipline_nom %> — <%= ch.titre %></option>
                            <% }); %>
                        </select>

                        <div class="relative min-w-[12rem] sm:min-w-[15rem]">
                            <div class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-3.5">
                                <svg class="h-4 w-4 text-slate-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
                            </div>
                            <input type="search"
                                   data-table-search
                                   placeholder="Recherche de chapitre..."
                                   class="w-full rounded-xl border border-slate-200 bg-slate-50/50 py-2 pl-10 pr-12 text-xs font-medium text-slate-900 placeholder-slate-400 transition-all focus:border-brand-500 focus:bg-white focus:outline-none focus:ring-2 focus:ring-brand-500/20 dark:border-slate-800 dark:bg-slate-950/50 dark:text-white dark:focus:border-brand-400 dark:focus:bg-slate-950">
                        </div>

                        <button type="button"
                                data-modal-open="course-modal"
                                data-modal-title="Créer un nouveau Chapitre"
                                data-fields='{"id":"","chapter_id":"","titre":"","description":"","contenu":"","niveau":"l1","order_num":"1"}'
                                class="inline-flex items-center gap-2 rounded-xl bg-brand-600 px-5 py-2.5 text-sm font-semibold text-white shadow-glow transition-all hover:-translate-y-0.5 hover:bg-brand-700">
                            <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg>
                            Nouveau Chapitre
                        </button>
                    </div>
                </div>

                <div class="overflow-x-auto">
                    <table class="w-full min-w-[54rem] text-left text-sm" id="admin-courses-table">
                        <thead class="border-b border-slate-200 bg-slate-50 text-xs uppercase tracking-wider text-slate-500 dark:border-slate-800 dark:bg-slate-950/50">
                            <tr>
                                <th class="px-6 py-4">Ordre</th>
                                <th class="px-6 py-4">Titre du Chapitre</th>
                                <th class="px-6 py-4">Cours / Module Parent</th>
                                <th class="px-6 py-4">Fichier PDF Attaché</th>
                                <th class="px-6 py-4 text-right">Actions</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-slate-100 dark:divide-slate-800">
                            <% courses.forEach(function(c) { %>
                                <tr data-discipline-slug="<%= c.discipline_slug %>" data-module-id="<%= c.chapter_id %>" class="transition-colors hover:bg-slate-50 dark:hover:bg-slate-800/50">
                                    <td class="px-6 py-4">
                                        <span class="inline-flex h-8 w-8 items-center justify-center rounded-lg bg-slate-100 text-xs font-bold text-slate-700 dark:bg-slate-800 dark:text-slate-300"><%= c.order_num %></span>
                                    </td>
                                    <td class="px-6 py-4 font-bold text-slate-900 dark:text-white">
                                        <%= c.titre %><br><span class="text-xs font-normal text-slate-500"><%= c.description || '' %></span>
                                    </td>
                                    <td class="px-6 py-4 text-xs">
                                        <span class="font-semibold text-slate-900 dark:text-white"><%= c.chapter_titre %></span><br>
                                        <span class="inline-flex items-center rounded-full px-2 py-0.5 text-[10px] font-bold uppercase <%= c.discipline_slug === 'chimie' ? 'bg-flask-50 text-flask-700 dark:bg-flask-500/10 dark:text-flask-400' : 'bg-brand-50 text-brand-700 dark:bg-brand-500/10 dark:text-brand-400' %>">
                                            <%= c.discipline_nom %>
                                        </span>
                                    </td>
                                    <td class="px-6 py-4 text-xs">
                                        <% if (c.course_file) { %>
                                            <div class="flex flex-wrap items-center gap-2">
                                                <button type="button"
                                                        data-file-modal
                                                        data-file-url="<%= c.course_file %>"
                                                        data-file-title="<%= c.titre %>"
                                                        data-file-label="Fichier de cours"
                                                        class="inline-flex items-center gap-1.5 rounded-lg bg-brand-50 px-3 py-1.5 font-semibold text-brand-700 transition-colors hover:bg-brand-100 dark:bg-brand-500/10 dark:text-brand-400 dark:hover:bg-brand-500/20">
                                                    <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z"/><circle cx="12" cy="12" r="3"/></svg>
                                                    Liseuse PDF
                                                </button>
                                                <a href="<%= c.course_file %>" target="_blank" rel="noopener" class="font-medium text-slate-500 hover:text-brand-600 hover:underline dark:text-slate-400">Ouvrir</a>
                                            </div>
                                        <% } else { %>
                                            <span class="text-slate-400">Aucun fichier</span>
                                        <% } %>
                                    </td>
                                    <td class="px-6 py-4 text-right">
                                        <div class="flex items-center justify-end gap-3">
                                            <button type="button"
                                                    data-modal-open="course-modal"
                                                    data-modal-title="Modifier le chapitre"
                                                    data-fields="<%= JSON.stringify({ id: c.id, chapter_id: c.chapter_id, titre: c.titre, description: c.description || '', contenu: c.contenu || '', niveau: c.niveau, order_num: c.order_num }) %>"
                                                    class="text-xs font-semibold text-brand-600 hover:text-brand-700 dark:text-brand-400">
                                                Modifier
                                            </button>
                                            <form action="/admin/courses/<%= c.id %>/delete" method="post" onsubmit="return confirm('Supprimer ce chapitre ?')" class="inline">
                                                <button type="submit" class="text-xs font-semibold text-rose-600 hover:text-rose-700 dark:text-rose-400">Supprimer</button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            <% }); %>

                            <% if (courses.length === 0) { %>
                                <tr><td colspan="5" class="px-6 py-12 text-center text-sm text-slate-500 dark:text-slate-400">Aucun chapitre enregistré.</td></tr>
                            <% } %>
                        </tbody>
                    </table>
                </div>
            </div>
        </main>
    </div>

    <!-- ====================== MODALE CRÉER / MODIFIER CHAPITRE ====================== -->
    <div id="course-modal" data-admin-modal
         class="fixed inset-0 z-[120] hidden items-center justify-center p-4"
         role="dialog" aria-modal="true" aria-labelledby="course-modal-title">

        <div data-modal-dismiss class="absolute inset-0 bg-slate-900/70 backdrop-blur-sm" aria-hidden="true"></div>

        <div class="relative z-10 flex max-h-[90vh] w-full max-w-2xl flex-col overflow-hidden rounded-3xl border border-slate-200 bg-white shadow-lift dark:border-slate-800 dark:bg-slate-900">
            <header class="flex items-start justify-between gap-4 border-b border-slate-200 px-6 py-5 dark:border-slate-800">
                <h3 id="course-modal-title" data-modal-title class="font-display text-lg font-bold text-slate-900 dark:text-white">Créer un nouveau chapitre</h3>
                <button type="button" data-modal-dismiss aria-label="Fermer"
                        class="grid h-10 w-10 shrink-0 place-items-center rounded-xl border border-slate-200 text-slate-500 transition-colors hover:bg-slate-100 hover:text-slate-900 dark:border-slate-700 dark:text-slate-400 dark:hover:bg-slate-800">
                    <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M18 6 6 18M6 6l12 12"/></svg>
                </button>
            </header>

            <form action="/admin/courses/save" method="post" enctype="multipart/form-data" class="grid flex-1 gap-4 overflow-auto p-6">
                <input type="hidden" name="id" value="">

                <!-- Cascade 1: Sélection de la Discipline -->
                <div>
                    <label class="mb-1 block text-xs font-semibold uppercase tracking-wider text-slate-500">1. Discipline</label>
                    <select id="modal-discipline-select" class="w-full rounded-xl border-slate-200 text-sm text-slate-900 dark:border-slate-700 dark:bg-slate-950 dark:text-white">
                        <option value="">Toutes les disciplines</option>
                        <% (typeof disciplines !== 'undefined' ? disciplines : []).forEach(function(d) { %>
                            <option value="<%= d.id %>" data-slug="<%= d.slug %>"><%= d.nom %></option>
                        <% }); %>
                    </select>
                </div>

                <!-- Cascade 2: Sélection du Cours / Module -->
                <div>
                    <label class="mb-1 block text-xs font-semibold uppercase tracking-wider text-slate-500">2. Cours / Module Parent *</label>
                    <select name="chapter_id" id="modal-module-select" required class="w-full rounded-xl border-slate-200 text-sm text-slate-900 dark:border-slate-700 dark:bg-slate-950 dark:text-white">
                        <% chapters.forEach(function(ch) { %>
                            <option value="<%= ch.id %>" data-disc-id="<%= ch.discipline_id %>" data-disc-slug="<%= ch.discipline_slug %>">
                                <%= ch.discipline_nom %> — <%= ch.titre %>
                            </option>
                        <% }); %>
                    </select>
                </div>

                <!-- Titre du chapitre -->
                <div>
                    <label class="mb-1 block text-xs font-semibold uppercase tracking-wider text-slate-500">3. Titre du Chapitre *</label>
                    <input type="text" name="titre" required placeholder="ex. Chapitre 1 - Ondes acoustiques dans un fluide" class="w-full rounded-xl border-slate-200 text-sm text-slate-900 dark:border-slate-700 dark:bg-slate-950 dark:text-white">
                </div>

                <!-- Description -->
                <div>
                    <label class="mb-1 block text-xs font-semibold uppercase tracking-wider text-slate-500">Description pédagogique</label>
                    <textarea name="description" rows="2" placeholder="Objectifs et notions clés abordées..." class="w-full rounded-xl border-slate-200 text-sm text-slate-900 dark:border-slate-700 dark:bg-slate-950 dark:text-white"></textarea>
                </div>

                <!-- Fichier PDF -->
                <div>
                    <label class="mb-1 block text-xs font-semibold uppercase tracking-wider text-slate-500">Fichier PDF du Chapitre</label>
                    <input type="file" name="course_file" accept=".pdf,image/*" class="w-full rounded-xl border border-slate-200 text-sm text-slate-900 file:mr-4 file:rounded-xl file:border-0 file:bg-brand-50 file:px-4 file:py-2 file:text-xs file:font-semibold file:text-brand-700 dark:border-slate-700 dark:bg-slate-950 dark:text-white dark:file:bg-brand-500/10 dark:file:text-brand-400">
                    <p class="mt-1.5 text-xs text-slate-400">En modification, laisser vide conserve le document déjà en place.</p>
                </div>

                <div class="grid grid-cols-2 gap-3">
                    <div>
                        <label class="mb-1 block text-xs font-semibold uppercase tracking-wider text-slate-500">Niveau</label>
                        <select name="niveau" class="w-full rounded-xl border-slate-200 text-sm text-slate-900 dark:border-slate-700 dark:bg-slate-950 dark:text-white">
                            <option value="l1">L1 / CPGE 1</option>
                            <option value="l2">L2 / CPGE 2</option>
                            <option value="l3">L3</option>
                            <option value="master">Master</option>
                        </select>
                    </div>
                    <div>
                        <label class="mb-1 block text-xs font-semibold uppercase tracking-wider text-slate-500">Ordre dans le cours (1, 2, 3...)</label>
                        <input type="number" name="order_num" value="1" min="1" class="w-full rounded-xl border-slate-200 text-sm text-slate-900 dark:border-slate-700 dark:bg-slate-950 dark:text-white">
                    </div>
                </div>

                <div class="mt-2 flex flex-wrap justify-end gap-3 border-t border-slate-200 pt-5 dark:border-slate-800">
                    <button type="button" data-modal-dismiss class="rounded-xl border border-slate-200 px-5 py-2.5 text-sm font-semibold text-slate-700 transition-colors hover:bg-slate-50 dark:border-slate-700 dark:text-slate-200 dark:hover:bg-slate-800">Annuler</button>
                    <button type="submit" class="rounded-xl bg-brand-600 px-6 py-2.5 text-sm font-semibold text-white shadow-glow transition-all hover:bg-brand-700">Enregistrer</button>
                </div>
            </form>
        </div>
    </div>

    <%- include('../partials/file-modal') %>

    <!-- Script d'interaction pour le filtrage du tableau et la cascade du formulaire admin -->
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const filterDisc = document.getElementById('admin-filter-discipline');
            const filterMod = document.getElementById('admin-filter-module');
            const tableRows = document.querySelectorAll('#admin-courses-table tbody tr');

            function applyTableFilters() {
                const discVal = filterDisc ? filterDisc.value : 'toutes';
                const modVal = filterMod ? filterMod.value : 'tous';

                tableRows.forEach(row => {
                    const rowDisc = row.dataset.disciplineSlug;
                    const rowMod = row.dataset.moduleId;

                    const discMatch = (discVal === 'toutes' || rowDisc === discVal);
                    const modMatch = (modVal === 'tous' || rowMod === modVal);

                    if (discMatch && modMatch) {
                        row.style.display = '';
                    } else {
                        row.style.display = 'none';
                    }
                });
            }

            if (filterDisc) filterDisc.addEventListener('change', applyTableFilters);
            if (filterMod) filterMod.addEventListener('change', applyTableFilters);

            // Cascade Discipline -> Module dans la modale
            const modalDiscSelect = document.getElementById('modal-discipline-select');
            const modalModuleSelect = document.getElementById('modal-module-select');

            if (modalDiscSelect && modalModuleSelect) {
                const allModuleOptions = Array.from(modalModuleSelect.querySelectorAll('option'));

                modalDiscSelect.addEventListener('change', () => {
                    const selectedDiscId = modalDiscSelect.value;
                    modalModuleSelect.innerHTML = '';

                    const matchingOptions = allModuleOptions.filter(opt => {
                        if (!selectedDiscId) return true;
                        return opt.dataset.discId === selectedDiscId;
                    });

                    matchingOptions.forEach(opt => modalModuleSelect.appendChild(opt));

                    if (matchingOptions.length === 0) {
                        const emptyOpt = document.createElement('option');
                        emptyOpt.value = '';
                        emptyOpt.textContent = 'Aucun cours/module disponible';
                        modalModuleSelect.appendChild(emptyOpt);
                    }
                });
            }
        });
    </script>
</body>
</html>

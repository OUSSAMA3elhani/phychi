<!DOCTYPE html>
<html lang="fr" class="scroll-smooth">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %> - PhyChi Admin</title>
    <script src="https://cdn.tailwindcss.com?plugins=forms"></script>
    <script src="/assets/theme.js"></script>
    <link rel="stylesheet" href="/assets/ui.css">
    <script src="/assets/ui.js" defer></script>
    <script src="/js/app.js" defer></script>
</head>
<body class="bg-slate-50 font-sans text-slate-600 antialiased dark:bg-slate-950 dark:text-slate-400">

    <%- include('partials/sidebar') %>

    <div class="pl-72">
        <%- include('partials/header') %>

        <main class="p-8">
            <!-- Metric Cards -->
            <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
                <div class="rounded-3xl border border-slate-200 bg-white p-6 shadow-soft dark:border-slate-800 dark:bg-slate-900">
                    <div class="flex items-center justify-between">
                        <span class="text-xs font-semibold uppercase tracking-wider text-slate-400">Utilisateurs</span>
                        <span class="grid h-10 w-10 place-items-center rounded-xl bg-brand-50 text-brand-600 dark:bg-brand-500/10 dark:text-brand-400">
                            <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/></svg>
                        </span>
                    </div>
                    <div class="mt-4 font-display text-3xl font-extrabold text-slate-900 dark:text-white"><%= stats.usersCount %></div>
                    <p class="mt-1 text-xs text-slate-500">Comptes enregistrés</p>
                </div>

                <div class="rounded-3xl border border-slate-200 bg-white p-6 shadow-soft dark:border-slate-800 dark:bg-slate-900">
                    <div class="flex items-center justify-between">
                        <span class="text-xs font-semibold uppercase tracking-wider text-slate-400">Cours</span>
                        <span class="grid h-10 w-10 place-items-center rounded-xl bg-brand-50 text-brand-600 dark:bg-brand-500/10 dark:text-brand-400">
                            <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 7v14"/><path d="M3 18a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1h5a4 4 0 0 1 4 4 4 4 0 0 1 4-4h5a1 1 0 0 1 1 1v13a1 1 0 0 1-1 1h-6a3 3 0 0 0-3 3 3 3 0 0 0-3-3z"/></svg>
                        </span>
                    </div>
                    <div class="mt-4 font-display text-3xl font-extrabold text-slate-900 dark:text-white"><%= stats.coursesCount %></div>
                    <p class="mt-1 text-xs text-slate-500">Fiches de cours</p>
                </div>

                <div class="rounded-3xl border border-slate-200 bg-white p-6 shadow-soft dark:border-slate-800 dark:bg-slate-900">
                    <div class="flex items-center justify-between">
                        <span class="text-xs font-semibold uppercase tracking-wider text-slate-400">Exercices</span>
                        <span class="grid h-10 w-10 place-items-center rounded-xl bg-flask-50 text-flask-600 dark:bg-flask-500/10 dark:text-flask-400">
                            <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M10 2v7.31a2 2 0 0 1-.24.95l-5.5 9.9A2 2 0 0 0 6 23h12a2 2 0 0 0 1.74-2.84l-5.5-9.9a2 2 0 0 1-.24-.95V2"/></svg>
                        </span>
                    </div>
                    <div class="mt-4 font-display text-3xl font-extrabold text-slate-900 dark:text-white"><%= stats.exercisesCount %></div>
                    <p class="mt-1 text-xs text-slate-500">Séries d'exercices</p>
                </div>

                <div class="rounded-3xl border border-slate-200 bg-white p-6 shadow-soft dark:border-slate-800 dark:bg-slate-900">
                    <div class="flex items-center justify-between">
                        <span class="text-xs font-semibold uppercase tracking-wider text-slate-400">Messages</span>
                        <span class="grid h-10 w-10 place-items-center rounded-xl bg-amber-50 text-amber-600 dark:bg-amber-500/10 dark:text-amber-400">
                            <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
                        </span>
                    </div>
                    <div class="mt-4 font-display text-3xl font-extrabold text-slate-900 dark:text-white"><%= stats.contactsCount %></div>
                    <p class="mt-1 text-xs text-slate-500">Soumissions contact</p>
                </div>
            </div>

            <div class="mt-8 grid gap-8 lg:grid-cols-2">
                <!-- Recent Contacts -->
                <div class="rounded-3xl border border-slate-200 bg-white p-6 shadow-soft dark:border-slate-800 dark:bg-slate-900">
                    <div class="flex items-center justify-between border-b border-slate-100 pb-4 dark:border-slate-800">
                        <h2 class="font-display text-lg font-bold text-slate-900 dark:text-white">Derniers messages reçus</h2>
                        <a href="/admin/contacts" class="text-xs font-semibold text-brand-600 hover:text-brand-700 dark:text-brand-400">Tout voir →</a>
                    </div>
                    <div class="mt-4 divide-y divide-slate-100 dark:divide-slate-800">
                        <% if (recentContacts && recentContacts.length > 0) { %>
                            <% recentContacts.forEach(function(c) { %>
                                <div class="py-3">
                                    <div class="flex items-center justify-between">
                                        <span class="font-semibold text-sm text-slate-900 dark:text-white"><%= c.nom %></span>
                                        <span class="rounded-full bg-slate-100 px-2.5 py-0.5 text-[11px] font-semibold text-slate-600 dark:bg-slate-800 dark:text-slate-300"><%= c.statut %></span>
                                    </div>
                                    <p class="mt-1 text-xs text-slate-500"><%= c.email %> • <%= c.sujet %></p>
                                    <p class="mt-1 text-sm text-slate-600 line-clamp-1 dark:text-slate-400"><%= c.message %></p>
                                </div>
                            <% }); %>
                        <% } else { %>
                            <p class="py-4 text-center text-sm text-slate-400">Aucun message pour le moment.</p>
                        <% } %>
                    </div>
                </div>

                <!-- Recent Users -->
                <div class="rounded-3xl border border-slate-200 bg-white p-6 shadow-soft dark:border-slate-800 dark:bg-slate-900">
                    <div class="flex items-center justify-between border-b border-slate-100 pb-4 dark:border-slate-800">
                        <h2 class="font-display text-lg font-bold text-slate-900 dark:text-white">Utilisateurs récents</h2>
                        <a href="/admin/users" class="text-xs font-semibold text-brand-600 hover:text-brand-700 dark:text-brand-400">Gérer →</a>
                    </div>
                    <div class="mt-4 divide-y divide-slate-100 dark:divide-slate-800">
                        <% if (recentUsers && recentUsers.length > 0) { %>
                            <% recentUsers.forEach(function(u) { %>
                                <div class="flex items-center justify-between py-3">
                                    <div>
                                        <p class="font-semibold text-sm text-slate-900 dark:text-white"><%= u.prenom %> <%= u.nom %></p>
                                        <p class="text-xs text-slate-500"><%= u.email %></p>
                                    </div>
                                    <span class="rounded-full px-2.5 py-1 text-xs font-semibold <%= u.role === 'admin' ? 'bg-amber-50 text-amber-700 dark:bg-amber-500/10 dark:text-amber-400' : 'bg-slate-100 text-slate-600 dark:bg-slate-800 dark:text-slate-300' %>">
                                        <%= u.role.toUpperCase() %>
                                    </span>
                                </div>
                            <% }); %>
                        <% } else { %>
                            <p class="py-4 text-center text-sm text-slate-400">Aucun utilisateur enregistré.</p>
                        <% } %>
                    </div>
                </div>
            </div>
        </main>
    </div>
</body>
</html>

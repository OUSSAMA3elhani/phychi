<!DOCTYPE html>
<html lang="fr" class="scroll-smooth">
<head>
    <meta charset="UTF-8">
    <title><%= title %> - PhyChi Admin</title>
    <script src="https://cdn.tailwindcss.com?plugins=forms"></script>
    <script src="/assets/theme.js"></script>
    <link rel="stylesheet" href="/assets/ui.css">
    <script src="/assets/ui.js" defer></script>
    <script src="/js/app.js" defer></script>
</head>
<body class="bg-slate-50 font-sans text-slate-600 antialiased dark:bg-slate-950 dark:text-slate-400">
    <%- include('partials/sidebar') %>
    <div class="pl-72">
        <%- include('partials/header') %>
        <main class="p-8">

            <% if (typeof error !== 'undefined' && error) { %>
                <div role="alert" class="mb-6 flex items-start gap-3 rounded-2xl border border-rose-200 bg-rose-50 px-5 py-4 text-sm font-medium text-rose-800 dark:border-rose-500/30 dark:bg-rose-500/10 dark:text-rose-300">
                    <svg class="mt-0.5 h-5 w-5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="M12 8v4M12 16h.01"/></svg>
                    <span><%= error %></span>
                </div>
            <% } %>

            <div class="overflow-hidden rounded-3xl border border-slate-200 bg-white shadow-soft dark:border-slate-800 dark:bg-slate-900">
                <div class="flex flex-wrap items-center justify-between gap-4 border-b border-slate-200 p-6 dark:border-slate-800">
                    <h2 class="font-display text-lg font-bold text-slate-900 dark:text-white">Séries d'Exercices (<%= exercises.length %>)</h2>
                    <div class="flex flex-wrap items-center gap-3">
                        <div class="relative min-w-[14rem] sm:min-w-[18rem]">
                            <div class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-3.5">
                                <svg class="h-4 w-4 text-slate-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
                            </div>
                            <input type="search"
                                   data-table-search
                                   placeholder="Recherche intelligente..."
                                   class="w-full rounded-xl border border-slate-200 bg-slate-50/50 py-2 pl-10 pr-16 text-xs font-medium text-slate-900 placeholder-slate-400 transition-all focus:border-brand-500 focus:bg-white focus:outline-none focus:ring-2 focus:ring-brand-500/20 dark:border-slate-800 dark:bg-slate-950/50 dark:text-white dark:focus:border-brand-400 dark:focus:bg-slate-950">
                            <span data-search-count class="pointer-events-none absolute inset-y-0 right-3 flex items-center text-[11px] font-bold text-brand-600 dark:text-brand-400"></span>
                        </div>
                        <button type="button"
                                data-modal-open="exercise-modal"
                                data-modal-title="Créer une série d'exercices"
                                data-fields='{"id":"","chapter_id":"","titre":"","description":"","niveau":"l1","difficulte":"moyen"}'
                                class="inline-flex items-center gap-2 rounded-xl bg-brand-600 px-5 py-2.5 text-sm font-semibold text-white shadow-glow transition-all hover:-translate-y-0.5 hover:bg-brand-700">
                            <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg>
                            Nouvelle série
                        </button>
                    </div>
                </div>

                <div class="overflow-x-auto">
                    <table class="w-full min-w-[52rem] text-left text-sm">
                        <thead class="border-b border-slate-200 bg-slate-50 text-xs uppercase tracking-wider text-slate-500 dark:border-slate-800 dark:bg-slate-950/50">
                            <tr>
                                <th class="px-6 py-4">Série d'Exercices</th>
                                <th class="px-6 py-4">Fichiers (Énoncé / Corrigé)</th>
                                <th class="px-6 py-4">Niveau / Diff.</th>
                                <th class="px-6 py-4 text-right">Actions</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-slate-100 dark:divide-slate-800">
                            <% exercises.forEach(function(e) { %>
                                <tr class="transition-colors hover:bg-slate-50 dark:hover:bg-slate-800/50">
                                    <td class="px-6 py-4 font-bold text-slate-900 dark:text-white">
                                        <%= e.titre %><br><span class="text-xs font-normal text-slate-500"><%= e.chapter_titre %></span>
                                    </td>
                                    <td class="px-6 py-4 text-xs">
                                        <div class="flex flex-col items-start gap-1.5">
                                            <% if (e.enonce_file) { %>
                                                <button type="button"
                                                        data-file-modal
                                                        data-file-url="<%= e.enonce_file %>"
                                                        data-file-title="<%= e.titre %>"
                                                        data-file-label="Énoncé"
                                                        class="inline-flex items-center gap-1.5 rounded-lg bg-brand-50 px-3 py-1.5 font-semibold text-brand-700 transition-colors hover:bg-brand-100 dark:bg-brand-500/10 dark:text-brand-400 dark:hover:bg-brand-500/20">
                                                    <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z"/><circle cx="12" cy="12" r="3"/></svg>
                                                    Aperçu de l'énoncé
                                                </button>
                                            <% } else { %>
                                                <span class="text-slate-400">Énoncé : aucun</span>
                                            <% } %>

                                            <% if (e.correction_file) { %>
                                                <button type="button"
                                                        data-file-modal
                                                        data-file-url="<%= e.correction_file %>"
                                                        data-file-title="<%= e.titre %>"
                                                        data-file-label="Correction"
                                                        class="inline-flex items-center gap-1.5 rounded-lg bg-emerald-50 px-3 py-1.5 font-semibold text-emerald-700 transition-colors hover:bg-emerald-100 dark:bg-emerald-500/10 dark:text-emerald-400 dark:hover:bg-emerald-500/20">
                                                    <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><path d="m9 11 3 3L22 4"/></svg>
                                                    Aperçu du corrigé
                                                </button>
                                            <% } else { %>
                                                <span class="text-slate-400">Corrigé : aucun</span>
                                            <% } %>
                                        </div>
                                    </td>
                                    <td class="px-6 py-4 text-xs">
                                        <span class="font-semibold uppercase text-slate-700 dark:text-slate-300"><%= e.niveau %></span>
                                        • <span class="capitalize text-slate-500"><%= e.difficulte %></span>
                                    </td>
                                    <td class="px-6 py-4 text-right">
                                        <div class="flex items-center justify-end gap-3">
                                            <button type="button"
                                                    data-modal-open="exercise-modal"
                                                    data-modal-title="Modifier la série d'exercices"
                                                    data-fields="<%= JSON.stringify({ id: e.id, chapter_id: e.chapter_id, titre: e.titre, description: e.description || '', niveau: e.niveau, difficulte: e.difficulte }) %>"
                                                    class="text-xs font-semibold text-brand-600 hover:text-brand-700 dark:text-brand-400">
                                                Modifier
                                            </button>
                                            <form action="/admin/exercises/<%= e.id %>/delete" method="post" onsubmit="return confirm('Supprimer cet exercice ?')" class="inline">
                                                <button type="submit" class="text-xs font-semibold text-rose-600 hover:text-rose-700 dark:text-rose-400">Supprimer</button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            <% }); %>

                            <% if (exercises.length === 0) { %>
                                <tr><td colspan="4" class="px-6 py-12 text-center text-sm text-slate-500 dark:text-slate-400">Aucune série d'exercices pour le moment.</td></tr>
                            <% } %>
                        </tbody>
                    </table>
                </div>
            </div>
        </main>
    </div>

    <!-- ====================== MODALE CRÉER / MODIFIER ====================== -->
    <div id="exercise-modal" data-admin-modal
         class="fixed inset-0 z-[120] hidden items-center justify-center p-4"
         role="dialog" aria-modal="true" aria-labelledby="exercise-modal-title">

        <div data-modal-dismiss class="absolute inset-0 bg-slate-900/70 backdrop-blur-sm" aria-hidden="true"></div>

        <div class="relative z-10 flex max-h-[90vh] w-full max-w-2xl flex-col overflow-hidden rounded-3xl border border-slate-200 bg-white shadow-lift dark:border-slate-800 dark:bg-slate-900">
            <header class="flex items-start justify-between gap-4 border-b border-slate-200 px-6 py-5 dark:border-slate-800">
                <h3 id="exercise-modal-title" data-modal-title class="font-display text-lg font-bold text-slate-900 dark:text-white">Créer une série d'exercices</h3>
                <button type="button" data-modal-dismiss aria-label="Fermer"
                        class="grid h-10 w-10 shrink-0 place-items-center rounded-xl border border-slate-200 text-slate-500 transition-colors hover:bg-slate-100 hover:text-slate-900 dark:border-slate-700 dark:text-slate-400 dark:hover:bg-slate-800">
                    <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M18 6 6 18M6 6l12 12"/></svg>
                </button>
            </header>

            <form action="/admin/exercises/save" method="post" enctype="multipart/form-data" class="grid flex-1 gap-4 overflow-auto p-6">
                <input type="hidden" name="id" value="">

                <div>
                    <label class="mb-1 block text-xs font-semibold uppercase tracking-wider text-slate-500">Chapitre Associé</label>
                    <select name="chapter_id" required class="w-full rounded-xl border-slate-200 text-sm text-slate-900 dark:border-slate-700 dark:bg-slate-950 dark:text-white">
                        <% chapters.forEach(function(ch) { %>
                            <option value="<%= ch.id %>"><%= ch.discipline_nom %> — <%= ch.titre %></option>
                        <% }); %>
                    </select>
                </div>

                <div>
                    <label class="mb-1 block text-xs font-semibold uppercase tracking-wider text-slate-500">Titre de l'Exercice</label>
                    <input type="text" name="titre" required class="w-full rounded-xl border-slate-200 text-sm text-slate-900 dark:border-slate-700 dark:bg-slate-950 dark:text-white">
                </div>

                <div>
                    <label class="mb-1 block text-xs font-semibold uppercase tracking-wider text-slate-500">Description / Énoncé court</label>
                    <textarea name="description" rows="2" class="w-full rounded-xl border-slate-200 text-sm text-slate-900 dark:border-slate-700 dark:bg-slate-950 dark:text-white"></textarea>
                </div>

                <div class="grid gap-4 sm:grid-cols-2">
                    <div>
                        <label class="mb-1 block text-xs font-semibold uppercase tracking-wider text-slate-500">Fichier de l'Énoncé</label>
                        <input type="file" name="enonce_file" accept=".pdf,image/*" class="w-full rounded-xl border border-slate-200 text-sm text-slate-900 file:mr-4 file:rounded-xl file:border-0 file:bg-brand-50 file:px-4 file:py-2 file:text-xs file:font-semibold file:text-brand-700 dark:border-slate-700 dark:bg-slate-950 dark:text-white dark:file:bg-brand-500/10 dark:file:text-brand-400">
                    </div>
                    <div>
                        <label class="mb-1 block text-xs font-semibold uppercase tracking-wider text-slate-500">Fichier du Corrigé</label>
                        <input type="file" name="correction_file" accept=".pdf,image/*" class="w-full rounded-xl border border-slate-200 text-sm text-slate-900 file:mr-4 file:rounded-xl file:border-0 file:bg-emerald-50 file:px-4 file:py-2 file:text-xs file:font-semibold file:text-emerald-700 dark:border-slate-700 dark:bg-slate-950 dark:text-white dark:file:bg-emerald-500/10 dark:file:text-emerald-400">
                    </div>
                </div>
                <p class="-mt-2 text-xs text-slate-400">En modification, laisser un champ vide conserve le document déjà en place.</p>

                <div class="grid grid-cols-2 gap-3">
                    <div>
                        <label class="mb-1 block text-xs font-semibold uppercase tracking-wider text-slate-500">Niveau</label>
                        <select name="niveau" class="w-full rounded-xl border-slate-200 text-sm text-slate-900 dark:border-slate-700 dark:bg-slate-950 dark:text-white">
                            <option value="l1">L1 / CPGE 1</option>
                            <option value="l2">L2 / CPGE 2</option>
                            <option value="l3">L3</option>
                            <option value="master">Master</option>
                        </select>
                    </div>
                    <div>
                        <label class="mb-1 block text-xs font-semibold uppercase tracking-wider text-slate-500">Difficulté</label>
                        <select name="difficulte" class="w-full rounded-xl border-slate-200 text-sm text-slate-900 dark:border-slate-700 dark:bg-slate-950 dark:text-white">
                            <option value="facile">Facile</option>
                            <option value="moyen">Moyen</option>
                            <option value="difficile">Difficile</option>
                            <option value="avance">Avancé</option>
                        </select>
                    </div>
                </div>

                <div class="mt-2 flex flex-wrap justify-end gap-3 border-t border-slate-200 pt-5 dark:border-slate-800">
                    <button type="button" data-modal-dismiss class="rounded-xl border border-slate-200 px-5 py-2.5 text-sm font-semibold text-slate-700 transition-colors hover:bg-slate-50 dark:border-slate-700 dark:text-slate-200 dark:hover:bg-slate-800">Annuler</button>
                    <button type="submit" class="rounded-xl bg-brand-600 px-6 py-2.5 text-sm font-semibold text-white shadow-glow transition-all hover:bg-brand-700">Enregistrer</button>
                </div>
            </form>
        </div>
    </div>

    <%- include('../partials/file-modal') %>
</body>
</html>

<!DOCTYPE html>
<html lang="fr" class="scroll-smooth">
<head>
    <meta charset="UTF-8">
    <title><%= title %> - PhyChi Admin</title>
    <script src="https://cdn.tailwindcss.com?plugins=forms"></script>
    <script src="/assets/theme.js"></script>
    <link rel="stylesheet" href="/assets/ui.css">
    <script src="/assets/ui.js" defer></script>
    <script src="/js/app.js" defer></script>
</head>
<body class="bg-slate-50 font-sans text-slate-600 antialiased dark:bg-slate-950 dark:text-slate-400">
    <%- include('partials/sidebar') %>
    <div class="pl-72">
        <%- include('partials/header') %>
        <main class="p-8">
            <% if (typeof successMsg !== 'undefined' && successMsg) { %>
                <div class="mb-6 rounded-2xl border border-emerald-200 bg-emerald-50 p-4 text-sm font-semibold text-emerald-700 dark:border-emerald-900/50 dark:bg-emerald-950/40 dark:text-emerald-300 flex items-center justify-between">
                    <span>✅ <%= successMsg %></span>
                </div>
            <% } %>

            <% if (typeof errorMsg !== 'undefined' && errorMsg) { %>
                <div class="mb-6 rounded-2xl border border-rose-200 bg-rose-50 p-4 text-sm font-semibold text-rose-700 dark:border-rose-900/50 dark:bg-rose-950/40 dark:text-rose-300 flex items-center justify-between">
                    <span>⚠️ <%= errorMsg %></span>
                </div>
            <% } %>

            <div class="overflow-hidden rounded-3xl border border-slate-200 bg-white shadow-soft dark:border-slate-800 dark:bg-slate-900">
                <div class="p-6 border-b border-slate-200 dark:border-slate-800 flex justify-between items-center">
                    <h2 class="font-display text-lg font-bold text-slate-900 dark:text-white">Gestion des Utilisateurs (<%= users.length %>)</h2>
                </div>
                <div class="overflow-x-auto">
                    <table class="w-full text-left text-sm">
                        <thead class="bg-slate-50 text-xs uppercase tracking-wider text-slate-500 border-b border-slate-200 dark:bg-slate-950/50 dark:border-slate-800">
                            <tr>
                                <th class="px-6 py-4">Nom & Prénom</th>
                                <th class="px-6 py-4">Email</th>
                                <th class="px-6 py-4">Niveau</th>
                                <th class="px-6 py-4">Changer le Rôle</th>
                                <th class="px-6 py-4 text-right">Actions</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-slate-100 dark:divide-slate-800">
                            <% users.forEach(function(u) { %>
                                <tr class="hover:bg-slate-50 dark:hover:bg-slate-800/50 transition-colors">
                                    <td class="px-6 py-4 font-semibold text-slate-900 dark:text-white">
                                        <%= u.prenom %> <%= u.nom %>
                                        <% if (locals.user && locals.user.id === u.id) { %>
                                            <span class="ml-2 text-[10px] uppercase tracking-wider font-extrabold px-2 py-0.5 rounded-md bg-brand-100 text-brand-700 dark:bg-brand-500/20 dark:text-brand-300">(Vous)</span>
                                        <% } %>
                                    </td>
                                    <td class="px-6 py-4 text-slate-600 dark:text-slate-300"><%= u.email %></td>
                                    <td class="px-6 py-4">
                                        <span class="uppercase text-xs font-semibold px-2.5 py-1 rounded-full bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300"><%= u.niveau %></span>
                                    </td>
                                    <td class="px-6 py-4">
                                        <form action="/admin/users/<%= u.id %>/role" method="post" class="inline-flex items-center gap-2">
                                            <select name="role" class="text-xs rounded-xl border-slate-200 dark:border-slate-700 dark:bg-slate-950 text-slate-900 dark:text-white py-1.5 pl-3 pr-8 focus:ring-brand-500">
                                                <option value="user" <%= u.role === 'user' ? 'selected' : '' %>>Utilisateur</option>
                                                <option value="admin" <%= u.role === 'admin' ? 'selected' : '' %>>Administrateur</option>
                                            </select>
                                            <button type="submit" class="rounded-xl bg-brand-600 px-3 py-1.5 text-xs font-semibold text-white hover:bg-brand-700 transition-colors shadow-sm">
                                                Enregistrer
                                            </button>
                                        </form>
                                    </td>
                                    <td class="px-6 py-4 text-right">
                                        <% if (!locals.user || locals.user.id !== u.id) { %>
                                            <form action="/admin/users/<%= u.id %>/delete" method="post" onsubmit="return confirm('Supprimer cet utilisateur ?')" class="inline">
                                                <button type="submit" class="text-rose-600 hover:text-rose-700 font-medium text-xs dark:text-rose-400">Supprimer</button>
                                            </form>
                                        <% } else { %>
                                            <span class="text-xs text-slate-400 font-medium">—</span>
                                        <% } %>
                                    </td>
                                </tr>
                            <% }); %>
                        </tbody>
                    </table>
                </div>
            </div>
        </main>
    </div>
</body>
</html>

<!DOCTYPE html>
<html lang="fr" class="scroll-smooth">
<head>
    <meta charset="UTF-8">
    <title><%= title %> - PhyChi Admin</title>
    <script src="https://cdn.tailwindcss.com?plugins=forms"></script>
    <script src="/assets/theme.js"></script>
    <link rel="stylesheet" href="/assets/ui.css">
    <script src="/assets/ui.js" defer></script>
    <script src="/js/app.js" defer></script>
</head>
<body class="bg-slate-50 font-sans text-slate-600 antialiased dark:bg-slate-950 dark:text-slate-400">
    <%- include('partials/sidebar') %>
    <div class="pl-72">
        <%- include('partials/header') %>
        <main class="p-8">
            <div class="overflow-hidden rounded-3xl border border-slate-200 bg-white shadow-soft dark:border-slate-800 dark:bg-slate-900">
                <div class="p-6 border-b border-slate-200 dark:border-slate-800 flex justify-between items-center">
                    <h2 class="font-display text-lg font-bold text-slate-900 dark:text-white">Liste des Utilisateurs (<%= users.length %>)</h2>
                </div>
                <div class="overflow-x-auto">
                    <table class="w-full text-left text-sm">
                        <thead class="bg-slate-50 text-xs uppercase tracking-wider text-slate-500 border-b border-slate-200 dark:bg-slate-950/50 dark:border-slate-800">
                            <tr>
                                <th class="px-6 py-4">Nom & Prénom</th>
                                <th class="px-6 py-4">Email</th>
                                <th class="px-6 py-4">Niveau</th>
                                <th class="px-6 py-4">Rôle</th>
                                <th class="px-6 py-4 text-right">Actions</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-slate-100 dark:divide-slate-800">
                            <% users.forEach(function(u) { %>
                                <tr class="hover:bg-slate-50 dark:hover:bg-slate-800/50 transition-colors">
                                    <td class="px-6 py-4 font-semibold text-slate-900 dark:text-white"><%= u.prenom %> <%= u.nom %></td>
                                    <td class="px-6 py-4 text-slate-600 dark:text-slate-300"><%= u.email %></td>
                                    <td class="px-6 py-4"><span class="uppercase text-xs font-semibold px-2.5 py-1 rounded-full bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300"><%= u.niveau %></span></td>
                                    <td class="px-6 py-4">
                                        <form action="/admin/users/<%= u.id %>/role" method="post" class="inline-flex">
                                            <select name="role" onchange="this.form.submit()" class="text-xs rounded-xl border-slate-200 dark:border-slate-700 dark:bg-slate-950 text-slate-900 dark:text-white py-1 pl-3 pr-8 focus:ring-brand-500">
                                                <option value="user" <%= u.role === 'user' ? 'selected' : '' %>>Utilisateur</option>
                                                <option value="admin" <%= u.role === 'admin' ? 'selected' : '' %>>Administrateur</option>
                                            </select>
                                        </form>
                                    </td>
                                    <td class="px-6 py-4 text-right">
                                        <form action="/admin/users/<%= u.id %>/delete" method="post" onsubmit="return confirm('Supprimer cet utilisateur ?')" class="inline">
                                            <button type="submit" class="text-rose-600 hover:text-rose-700 font-medium text-xs dark:text-rose-400">Supprimer</button>
                                        </form>
                                    </td>
                                </tr>
                            <% }); %>
                        </tbody>
                    </table>
                </div>
            </div>
        </main>
    </div>
</body>
</html>

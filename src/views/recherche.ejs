<!DOCTYPE html>
<html lang="fr" class="scroll-smooth">
<%- include('partials/head') %>

<body class="bg-slate-50 font-sans text-slate-600 antialiased selection:bg-brand-600 selection:text-white dark:bg-slate-950 dark:text-slate-400">

    <a href="#contenu"
       class="sr-only focus:not-sr-only focus:fixed focus:left-6 focus:top-6 focus:z-[60] focus:rounded-xl focus:bg-brand-600 focus:px-5 focus:py-3 focus:text-sm focus:font-semibold focus:text-white focus:shadow-lift">
        Aller au contenu principal
    </a>

    <!-- ==================================================================
         EN-TÊTE
         ================================================================== -->
    <%- include('partials/header') %>

    <main id="contenu">

        <!-- En-tête + moteur de recherche -->
        <section class="search-form-section relative isolate overflow-hidden border-b border-slate-200 bg-white dark:border-slate-800 dark:bg-slate-950" aria-labelledby="titre-recherche">
            <%- include('partials/hero-decor') %>

            <div class="relative mx-auto max-w-4xl px-6 py-20 text-center sm:py-24 lg:px-8">
                <nav aria-label="Fil d'Ariane" class="mb-8">
                    <ol class="flex items-center justify-center gap-2 text-sm text-slate-500 dark:text-slate-400">
                        <li><a href="/" class="transition-colors hover:text-brand-600 dark:hover:text-brand-400">Accueil</a></li>
                        <li aria-hidden="true" class="text-slate-300 dark:text-slate-600">/</li>
                        <li class="font-medium text-slate-900 dark:text-white">Recherche</li>
                    </ol>
                </nav>

                <h1 id="titre-recherche" class="font-display text-4xl font-extrabold leading-tight tracking-tight text-slate-900 sm:text-5xl dark:text-white">
                    Recherche de contenus
                </h1>
                <p class="mx-auto mt-5 max-w-2xl text-lg leading-relaxed text-slate-600 dark:text-slate-400">
                    Trouvez rapidement des leçons, des formules, des exercices corrigés ou des documents à télécharger.
                </p>

                <form action="/recherche" method="get" class="mx-auto mt-10 max-w-3xl text-left">
                    <div class="relative">
                        <label for="q" class="sr-only">Mots-clés ou termes de recherche</label>
                        <span class="pointer-events-none absolute left-5 top-1/2 -translate-y-1/2 text-slate-400" aria-hidden="true">
                            <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
                        </span>
                        <input type="search" id="q" name="q" value="<%= typeof q !== 'undefined' ? q : '' %>" required placeholder="Ex : Maxwell, Navier-Stokes, Nernst, SN1, Thermochimie…"
                               class="w-full rounded-2xl border-slate-200 bg-white py-4 pl-14 pr-36 text-[15px] text-slate-900 shadow-lift transition-colors placeholder:text-slate-400 focus:border-brand-500 focus:ring-4 focus:ring-brand-500/10 dark:border-slate-700 dark:bg-slate-900 dark:text-white">
                        <button type="submit"
                                class="absolute right-2 top-1/2 -translate-y-1/2 rounded-xl bg-brand-600 px-5 py-2.5 text-sm font-semibold text-white transition-colors hover:bg-brand-700">
                            Rechercher
                        </button>
                    </div>
                </form>
            </div>
        </section>

        <!-- Recherches fréquentes -->
        <section class="popular-searches mx-auto max-w-7xl px-6 py-8 lg:px-8" aria-labelledby="titre-populaires">
            <h2 id="titre-populaires" class="text-xs font-semibold uppercase tracking-[0.16em] text-slate-400 dark:text-slate-500">
                Recherches fréquentes
            </h2>
            <ul class="mt-4 flex flex-wrap gap-2">
                <li><a href="/recherche?q=Thermodynamique" class="inline-flex items-center rounded-full border border-slate-200 bg-white px-4 py-2 text-sm font-medium text-slate-700 shadow-sm transition-all hover:-translate-y-0.5 hover:border-brand-300 hover:text-brand-600 dark:border-slate-800 dark:bg-slate-900 dark:text-slate-300 dark:hover:border-brand-700 dark:hover:text-brand-400">Thermodynamique</a></li>
                <li><a href="/recherche?q=Oscillateur" class="inline-flex items-center rounded-full border border-slate-200 bg-white px-4 py-2 text-sm font-medium text-slate-700 shadow-sm transition-all hover:-translate-y-0.5 hover:border-brand-300 hover:text-brand-600 dark:border-slate-800 dark:bg-slate-900 dark:text-slate-300 dark:hover:border-brand-700 dark:hover:text-brand-400">Oscillateur</a></li>
                <li><a href="/recherche?q=Chimie" class="inline-flex items-center rounded-full border border-slate-200 bg-white px-4 py-2 text-sm font-medium text-slate-700 shadow-sm transition-all hover:-translate-y-0.5 hover:border-flask-300 hover:text-flask-600 dark:border-slate-800 dark:bg-slate-900 dark:text-slate-300 dark:hover:border-flask-700 dark:hover:text-flask-400">Chimie</a></li>
                <li><a href="/recherche?q=Centrale" class="inline-flex items-center rounded-full border border-slate-200 bg-white px-4 py-2 text-sm font-medium text-slate-700 shadow-sm transition-all hover:-translate-y-0.5 hover:border-brand-300 hover:text-brand-600 dark:border-slate-800 dark:bg-slate-900 dark:text-slate-300 dark:hover:border-brand-700 dark:hover:text-brand-400">Centrale</a></li>
                <li><a href="/recherche?q=Mines" class="inline-flex items-center rounded-full border border-slate-200 bg-white px-4 py-2 text-sm font-medium text-slate-700 shadow-sm transition-all hover:-translate-y-0.5 hover:border-flask-300 hover:text-flask-600 dark:border-slate-800 dark:bg-slate-900 dark:text-slate-300 dark:hover:border-flask-700 dark:hover:text-flask-400">Mines-Ponts</a></li>
                <li><a href="/recherche?q=H-Prepa" class="inline-flex items-center rounded-full border border-slate-200 bg-white px-4 py-2 text-sm font-medium text-slate-700 shadow-sm transition-all hover:-translate-y-0.5 hover:border-flask-300 hover:text-flask-600 dark:border-slate-800 dark:bg-slate-900 dark:text-slate-300 dark:hover:border-flask-700 dark:hover:text-flask-400">H-Prépa</a></li>
            </ul>
        </section>

        <!-- Filtres par catégorie -->
        <% if (typeof q !== 'undefined' && q) { %>
            <div class="mx-auto max-w-7xl px-6 pt-4 pb-2 lg:px-8">
                <div class="flex flex-wrap items-center gap-2 border-b border-slate-200 pb-4 dark:border-slate-800">
                    <span class="text-xs font-bold uppercase tracking-wider text-slate-400 dark:text-slate-500 mr-2">Filtrer par :</span>
                    <% var curType = typeof type !== 'undefined' ? type : 'tous'; %>
                    <a href="/recherche?q=<%= encodeURIComponent(q) %>&type=tous" class="rounded-xl px-4 py-2 text-xs font-bold transition-all <%= curType === 'tous' ? 'bg-brand-600 text-white shadow-soft' : 'bg-slate-100 text-slate-600 hover:bg-slate-200 dark:bg-slate-800 dark:text-slate-300' %>">Tous les types</a>
                    <a href="/recherche?q=<%= encodeURIComponent(q) %>&type=concours" class="rounded-xl px-4 py-2 text-xs font-bold transition-all <%= curType === 'concours' ? 'bg-indigo-600 text-white shadow-soft' : 'bg-slate-100 text-slate-600 hover:bg-slate-200 dark:bg-slate-800 dark:text-slate-300' %>">Concours & Annales</a>
                    <a href="/recherche?q=<%= encodeURIComponent(q) %>&type=livres" class="rounded-xl px-4 py-2 text-xs font-bold transition-all <%= curType === 'livres' ? 'bg-emerald-600 text-white shadow-soft' : 'bg-slate-100 text-slate-600 hover:bg-slate-200 dark:bg-slate-800 dark:text-slate-300' %>">Livres Physique / Chimie</a>
                    <a href="/recherche?q=<%= encodeURIComponent(q) %>&type=exercices" class="rounded-xl px-4 py-2 text-xs font-bold transition-all <%= curType === 'exercices' ? 'bg-amber-600 text-white shadow-soft' : 'bg-slate-100 text-slate-600 hover:bg-slate-200 dark:bg-slate-800 dark:text-slate-300' %>">Exercices & TD</a>
                </div>
            </div>
        <% } %>

        <!-- Résultats -->
        <section class="search-results mx-auto max-w-7xl px-6 pb-16 lg:px-8" aria-labelledby="titre-resultats">
            <div class="flex flex-wrap items-baseline justify-between gap-3 border-b border-slate-200 pb-6 dark:border-slate-800">
                <h2 id="titre-resultats" class="font-display text-2xl font-extrabold tracking-tight text-slate-900 sm:text-3xl dark:text-white">
                    <% if (typeof q !== 'undefined' && q) { %>
                        Résultats pour « <span class="text-brand-600 dark:text-brand-400"><%= q %></span> »
                    <% } else { %>
                        Résultats de la recherche
                    <% } %>
                </h2>
                <p class="text-sm font-semibold text-slate-500 dark:text-slate-400">
                    <%= typeof results !== 'undefined' && results ? results.length : 0 %> résultat<%= (typeof results !== 'undefined' && results && results.length > 1) ? 's' : '' %> trouvé<%= (typeof results !== 'undefined' && results && results.length > 1) ? 's' : '' %>
                </p>
            </div>

            <div class="mt-8 grid gap-4">
                <% if (typeof results !== 'undefined' && results && results.length > 0) { %>
                    <% results.forEach(function (r) { %>
                        <article class="result-card group relative flex flex-col rounded-3xl border border-slate-200 bg-white p-7 shadow-soft transition-all duration-300 hover:-translate-y-1 hover:border-brand-200 hover:shadow-lift dark:border-slate-800 dark:bg-slate-900">
                            <div class="flex flex-wrap items-center gap-2">
                                <span class="badge inline-flex items-center rounded-full px-3 py-1 text-xs font-semibold <%= r.badgeClass %>"><%= r.type %></span>
                            </div>
                            <h3 class="mt-4 font-display text-lg font-bold tracking-tight text-slate-900 dark:text-white">
                                <a href="<%= r.url %>" class="transition-colors hover:text-brand-600 dark:hover:text-brand-400">
                                    <span class="absolute inset-0" aria-hidden="true"></span>
                                    <%= r.titre %>
                                </a>
                            </h3>
                            <p class="mt-3 max-w-3xl text-[15px] leading-relaxed text-slate-500 dark:text-slate-400">
                                <%= r.description %>
                            </p>
                            <div class="mt-5 flex flex-wrap items-center gap-3">
                                <span class="inline-flex items-center gap-2 text-sm font-semibold text-brand-600 dark:text-brand-400">
                                    Voir la fiche
                                    <svg class="h-4 w-4 transition-transform duration-300 group-hover:translate-x-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
                                </span>
                                <% if (r.file) { %>
                                    <button type="button"
                                            data-file-modal
                                            data-file-url="<%= r.file %>"
                                            data-file-title="<%= r.titre %>"
                                            data-file-label="<%= r.type %>"
                                            class="relative z-10 inline-flex items-center gap-1.5 rounded-xl border border-slate-200 bg-slate-50 px-3 py-1.5 text-xs font-bold text-slate-800 shadow-sm transition-all hover:bg-slate-100 hover:text-brand-600 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200">
                                        <svg width="14" height="14" class="h-3.5 w-3.5 text-brand-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z"/><circle cx="12" cy="12" r="3"/></svg>
                                        Consulter dans le lecteur
                                    </button>
                                <% } %>
                            </div>
                        </article>
                    <% }); %>
                <% } else if (typeof q !== 'undefined' && q) { %>
                    <div class="rounded-3xl border border-dashed border-slate-300 bg-white p-12 text-center dark:border-slate-700 dark:bg-slate-900">
                        <svg class="mx-auto h-12 w-12 text-slate-400 dark:text-slate-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
                        <h3 class="mt-4 font-display text-lg font-bold text-slate-900 dark:text-white">Aucun résultat trouvé</h3>
                        <p class="mt-2 text-sm text-slate-500 dark:text-slate-400">Aucun contenu ne correspond à vos termes de recherche « <%= q %> ».</p>
                        <a href="/recherche" class="mt-6 inline-flex items-center gap-2 rounded-xl bg-brand-600 px-5 py-2.5 text-sm font-semibold text-white shadow-soft hover:bg-brand-700">Effacer la recherche</a>
                    </div>
                <% } else { %>
                    <div class="rounded-3xl border border-slate-200 bg-white p-12 text-center dark:border-slate-800 dark:bg-slate-900">
                        <svg class="mx-auto h-12 w-12 text-brand-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
                        <h3 class="mt-4 font-display text-lg font-bold text-slate-900 dark:text-white">Saisissez vos mots-clés ci-dessus</h3>
                        <p class="mt-2 text-sm text-slate-500 dark:text-slate-400">Recherchez un concours, un manuel CPGE ou une série d'exercices.</p>
                    </div>
                <% } %>
            </div>
        </section>
    </main>

    <!-- ==================================================================
         PIED DE PAGE
         ================================================================== -->
    <%- include('partials/file-modal') %>
    <%- include('partials/footer') %>
</body>
</html>

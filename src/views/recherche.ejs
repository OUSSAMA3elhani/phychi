<!DOCTYPE html>
<html lang="fr" class="scroll-smooth">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="PhyChi - Moteur de recherche de cours, d'exercices, de corrigés et de documents PDF de physique et chimie pour l'enseignement supérieur.">
    <meta name="theme-color" content="#0f172a">
    <title>PhyChi - Recherche de Contenus</title>

    <!-- Application du thème avant le rendu (évite le flash blanc) -->
    <script>
        (function () {
            try {
                var saved = localStorage.getItem('psychi_theme');
                var prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
                if (saved === 'dark' || (!saved && prefersDark)) {
                    document.documentElement.classList.add('dark-theme');
                }
            } catch (e) { /* localStorage indisponible */ }
        })();
    </script>

    <!-- Typographie -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter+Tight:wght@500;600;700;800&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">

    <!-- Tailwind CSS + design system partagé -->
    <script src="https://cdn.tailwindcss.com?plugins=forms"></script>
    <script src="assets/theme.js"></script>
    <link rel="stylesheet" href="assets/ui.css">

    <script src="assets/ui.js" defer></script>
    <script src="script.js" defer></script>
    <!-- Liaison des formulaires avec l'API Express (servi par public/js/app.js) -->
    <script src="/js/app.js" defer></script>
</head>

<body class="bg-slate-50 font-sans text-slate-600 antialiased selection:bg-brand-600 selection:text-white dark:bg-slate-950 dark:text-slate-400">

    <a href="#contenu"
       class="sr-only focus:not-sr-only focus:fixed focus:left-6 focus:top-6 focus:z-[60] focus:rounded-xl focus:bg-brand-600 focus:px-5 focus:py-3 focus:text-sm focus:font-semibold focus:text-white focus:shadow-lift">
        Aller au contenu principal
    </a>

    <!-- ==================================================================
         EN-TÊTE
         ================================================================== -->
    <%- include('partials/header') %>

    <main id="contenu">

        <!-- En-tête + moteur de recherche -->
        <section class="search-form-section relative isolate overflow-hidden border-b border-slate-200 bg-white dark:border-slate-800 dark:bg-slate-950" aria-labelledby="titre-recherche">
            <%- include('partials/hero-decor') %>

            <div class="relative mx-auto max-w-4xl px-6 py-20 text-center sm:py-24 lg:px-8">
                <nav aria-label="Fil d'Ariane" class="mb-8">
                    <ol class="flex items-center justify-center gap-2 text-sm text-slate-500 dark:text-slate-400">
                        <li><a href="/" class="transition-colors hover:text-brand-600 dark:hover:text-brand-400">Accueil</a></li>
                        <li aria-hidden="true" class="text-slate-300 dark:text-slate-600">/</li>
                        <li class="font-medium text-slate-900 dark:text-white">Recherche</li>
                    </ol>
                </nav>

                <h1 id="titre-recherche" class="font-display text-4xl font-extrabold leading-tight tracking-tight text-slate-900 sm:text-5xl dark:text-white">
                    Recherche de contenus
                </h1>
                <p class="mx-auto mt-5 max-w-2xl text-lg leading-relaxed text-slate-600 dark:text-slate-400">
                    Trouvez rapidement des leçons, des formules, des exercices corrigés ou des documents à télécharger.
                </p>

                <form action="/recherche" method="get" class="mx-auto mt-10 max-w-3xl text-left">
                    <div class="relative">
                        <label for="q" class="sr-only">Mots-clés ou termes de recherche</label>
                        <span class="pointer-events-none absolute left-5 top-1/2 -translate-y-1/2 text-slate-400" aria-hidden="true">
                            <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
                        </span>
                        <input type="search" id="q" name="q" required placeholder="Ex : Maxwell, Navier-Stokes, Nernst, SN1, Thermochimie…"
                               class="w-full rounded-2xl border-slate-200 bg-white py-4 pl-14 pr-36 text-[15px] text-slate-900 shadow-lift transition-colors placeholder:text-slate-400 focus:border-brand-500 focus:ring-4 focus:ring-brand-500/10 dark:border-slate-700 dark:bg-slate-900 dark:text-white">
                        <button type="submit"
                                class="absolute right-2 top-1/2 -translate-y-1/2 rounded-xl bg-brand-600 px-5 py-2.5 text-sm font-semibold text-white transition-colors hover:bg-brand-700">
                            Rechercher
                        </button>
                    </div>

                    <fieldset class="mt-6">
                        <legend class="sr-only">Affiner la recherche</legend>
                        <div class="grid gap-4 sm:grid-cols-3">
                            <div>
                                <label for="type" class="block text-sm font-medium text-slate-700 dark:text-slate-300">Type de document</label>
                                <select name="type" id="type"
                                        class="mt-2 w-full rounded-xl border-slate-200 bg-white py-3 pl-4 pr-10 text-sm text-slate-900 shadow-sm transition-colors focus:border-brand-500 focus:ring-4 focus:ring-brand-500/10 dark:border-slate-700 dark:bg-slate-900 dark:text-white">
                                    <option value="tous">Tous les types</option>
                                    <option value="cours">Cours &amp; leçons</option>
                                    <option value="exercices">Exercices &amp; TD</option>
                                    <option value="solutions">Corrigés &amp; solutions</option>
                                    <option value="fiches">Fiches de synthèse PDF</option>
                                </select>
                            </div>
                            <div>
                                <label for="matiere" class="block text-sm font-medium text-slate-700 dark:text-slate-300">Matière</label>
                                <select name="matiere" id="matiere"
                                        class="mt-2 w-full rounded-xl border-slate-200 bg-white py-3 pl-4 pr-10 text-sm text-slate-900 shadow-sm transition-colors focus:border-brand-500 focus:ring-4 focus:ring-brand-500/10 dark:border-slate-700 dark:bg-slate-900 dark:text-white">
                                    <option value="toutes">Physique &amp; Chimie</option>
                                    <option value="physique">Physique uniquement</option>
                                    <option value="chimie">Chimie uniquement</option>
                                </select>
                            </div>
                            <div>
                                <label for="niveau" class="block text-sm font-medium text-slate-700 dark:text-slate-300">Niveau</label>
                                <select name="niveau" id="niveau"
                                        class="mt-2 w-full rounded-xl border-slate-200 bg-white py-3 pl-4 pr-10 text-sm text-slate-900 shadow-sm transition-colors focus:border-brand-500 focus:ring-4 focus:ring-brand-500/10 dark:border-slate-700 dark:bg-slate-900 dark:text-white">
                                    <option value="tous">Tous les niveaux</option>
                                    <option value="l1">L1 / CPGE 1ère année</option>
                                    <option value="l2">L2 / CPGE 2ème année</option>
                                    <option value="l3">L3 / Master / Agrégation</option>
                                </select>
                            </div>
                        </div>
                    </fieldset>
                </form>
            </div>
        </section>

        <!-- Recherches fréquentes -->
        <section class="popular-searches mx-auto max-w-7xl px-6 py-12 lg:px-8" aria-labelledby="titre-populaires">
            <h2 id="titre-populaires" class="text-xs font-semibold uppercase tracking-[0.16em] text-slate-400 dark:text-slate-500">
                Recherches fréquentes
            </h2>
            <ul class="mt-4 flex flex-wrap gap-2">
                <li><a href="/recherche?q=Thermodynamique" class="inline-flex items-center rounded-full border border-slate-200 bg-white px-4 py-2 text-sm font-medium text-slate-700 shadow-sm transition-all hover:-translate-y-0.5 hover:border-brand-300 hover:text-brand-600 dark:border-slate-800 dark:bg-slate-900 dark:text-slate-300 dark:hover:border-brand-700 dark:hover:text-brand-400">Thermodynamique</a></li>
                <li><a href="/recherche?q=Oscillateur+harmonique" class="inline-flex items-center rounded-full border border-slate-200 bg-white px-4 py-2 text-sm font-medium text-slate-700 shadow-sm transition-all hover:-translate-y-0.5 hover:border-brand-300 hover:text-brand-600 dark:border-slate-800 dark:bg-slate-900 dark:text-slate-300 dark:hover:border-brand-700 dark:hover:text-brand-400">Oscillateur harmonique</a></li>
                <li><a href="/recherche?q=Chimie+organique" class="inline-flex items-center rounded-full border border-slate-200 bg-white px-4 py-2 text-sm font-medium text-slate-700 shadow-sm transition-all hover:-translate-y-0.5 hover:border-flask-300 hover:text-flask-600 dark:border-slate-800 dark:bg-slate-900 dark:text-slate-300 dark:hover:border-flask-700 dark:hover:text-flask-400">Chimie organique</a></li>
                <li><a href="/recherche?q=Equations+de+Maxwell" class="inline-flex items-center rounded-full border border-slate-200 bg-white px-4 py-2 text-sm font-medium text-slate-700 shadow-sm transition-all hover:-translate-y-0.5 hover:border-brand-300 hover:text-brand-600 dark:border-slate-800 dark:bg-slate-900 dark:text-slate-300 dark:hover:border-brand-700 dark:hover:text-brand-400">Équations de Maxwell</a></li>
                <li><a href="/recherche?q=Diagramme+E-pH" class="inline-flex items-center rounded-full border border-slate-200 bg-white px-4 py-2 text-sm font-medium text-slate-700 shadow-sm transition-all hover:-translate-y-0.5 hover:border-flask-300 hover:text-flask-600 dark:border-slate-800 dark:bg-slate-900 dark:text-slate-300 dark:hover:border-flask-700 dark:hover:text-flask-400">Diagramme E-pH</a></li>
                <li><a href="/recherche?q=Cinétique+chimique" class="inline-flex items-center rounded-full border border-slate-200 bg-white px-4 py-2 text-sm font-medium text-slate-700 shadow-sm transition-all hover:-translate-y-0.5 hover:border-flask-300 hover:text-flask-600 dark:border-slate-800 dark:bg-slate-900 dark:text-slate-300 dark:hover:border-flask-700 dark:hover:text-flask-400">Cinétique chimique</a></li>
            </ul>
        </section>

        <!-- Résultats -->
        <section class="search-results mx-auto max-w-7xl px-6 pb-4 lg:px-8" aria-labelledby="titre-resultats">
            <div class="flex flex-wrap items-baseline justify-between gap-3 border-b border-slate-200 pb-6 dark:border-slate-800">
                <h2 id="titre-resultats" class="font-display text-2xl font-extrabold tracking-tight text-slate-900 sm:text-3xl dark:text-white">
                    Résultats de la recherche
                </h2>
                <p class="text-sm text-slate-500 dark:text-slate-400">4 résultats trouvés</p>
            </div>

            <div class="mt-8 grid gap-4">

                <article class="result-card group relative flex flex-col rounded-3xl border border-slate-200 bg-white p-7 shadow-soft transition-all duration-300 hover:-translate-y-1 hover:border-brand-200 hover:shadow-lift dark:border-slate-800 dark:bg-slate-900 dark:hover:border-brand-900">
                    <div class="flex flex-wrap items-center gap-2">
                        <span class="badge badge-cours inline-flex items-center rounded-full bg-amber-50 px-3 py-1 text-xs font-semibold text-amber-700 dark:bg-amber-500/10 dark:text-amber-400">Cours</span>
                        <span class="text-xs font-medium text-slate-400 dark:text-slate-500">Physique</span>
                        <span aria-hidden="true" class="text-xs text-slate-300 dark:text-slate-600">•</span>
                        <span class="text-xs font-medium text-slate-400 dark:text-slate-500">L2 / CPGE 2</span>
                    </div>
                    <h3 class="mt-4 font-display text-lg font-bold tracking-tight text-slate-900 dark:text-white">
                        <a href="/cours#electromag">
                            <span class="absolute inset-0" aria-hidden="true"></span>
                            Équations de Maxwell et ondes électromagnétiques
                        </a>
                    </h3>
                    <p class="mt-3 max-w-3xl text-[15px] leading-relaxed text-slate-500 dark:text-slate-400">
                        Formes locales et intégrales des équations de Maxwell, équation de d'Alembert dans le vide, potentiel vecteur et bilan de Poynting…
                    </p>
                    <p class="mt-5 inline-flex items-center gap-2 text-sm font-semibold text-brand-600 dark:text-brand-400">
                        Consulter le cours complet
                        <svg class="h-4 w-4 transition-transform duration-300 group-hover:translate-x-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
                    </p>
                </article>

                <article class="result-card group relative flex flex-col rounded-3xl border border-slate-200 bg-white p-7 shadow-soft transition-all duration-300 hover:-translate-y-1 hover:border-brand-200 hover:shadow-lift dark:border-slate-800 dark:bg-slate-900 dark:hover:border-brand-900">
                    <div class="flex flex-wrap items-center gap-2">
                        <span class="badge badge-exercice inline-flex items-center rounded-full bg-violet-50 px-3 py-1 text-xs font-semibold text-violet-700 dark:bg-violet-500/10 dark:text-violet-400">Exercice</span>
                        <span class="text-xs font-medium text-slate-400 dark:text-slate-500">Physique</span>
                        <span aria-hidden="true" class="text-xs text-slate-300 dark:text-slate-600">•</span>
                        <span class="text-xs font-medium text-slate-400 dark:text-slate-500">L1 / CPGE 1</span>
                    </div>
                    <h3 class="mt-4 font-display text-lg font-bold tracking-tight text-slate-900 dark:text-white">
                        <a href="/exercices-physique#meca-osc">
                            <span class="absolute inset-0" aria-hidden="true"></span>
                            Série 1 : Oscillateur harmonique amorti et forcé
                        </a>
                    </h3>
                    <p class="mt-3 max-w-3xl text-[15px] leading-relaxed text-slate-500 dark:text-slate-400">
                        Problèmes d'oscillations mécaniques, facteur de qualité, régimes apériodique, critique et pseudo-périodique, résonance…
                    </p>
                    <p class="mt-5 inline-flex items-center gap-2 text-sm font-semibold text-brand-600 dark:text-brand-400">
                        Accéder à l'exercice
                        <svg class="h-4 w-4 transition-transform duration-300 group-hover:translate-x-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
                    </p>
                </article>

                <article class="result-card group relative flex flex-col rounded-3xl border border-slate-200 bg-white p-7 shadow-soft transition-all duration-300 hover:-translate-y-1 hover:border-flask-200 hover:shadow-lift dark:border-slate-800 dark:bg-slate-900 dark:hover:border-flask-900">
                    <div class="flex flex-wrap items-center gap-2">
                        <span class="badge badge-solution inline-flex items-center rounded-full bg-flask-50 px-3 py-1 text-xs font-semibold text-flask-700 dark:bg-flask-500/10 dark:text-flask-400">Corrigé</span>
                        <span class="text-xs font-medium text-slate-400 dark:text-slate-500">Chimie</span>
                        <span aria-hidden="true" class="text-xs text-slate-300 dark:text-slate-600">•</span>
                        <span class="text-xs font-medium text-slate-400 dark:text-slate-500">L1 / CPGE 1</span>
                    </div>
                    <h3 class="mt-4 font-display text-lg font-bold tracking-tight text-slate-900 dark:text-white">
                            <span class="absolute inset-0" aria-hidden="true"></span>
                            Corrigé — Cinétique chimique et régimes réactionnels
                        </a>
                    </h3>
                    <p class="mt-3 max-w-3xl text-[15px] leading-relaxed text-slate-500 dark:text-slate-400">
                        Démonstration de l'intégration de la loi de vitesse, détermination expérimentale de l'ordre d'une réaction et calcul de l'énergie d'activation…
                    </p>
                    <p class="mt-5 inline-flex items-center gap-2 text-sm font-semibold text-flask-600 dark:text-flask-400">
                        Voir le corrigé détaillé
                        <svg class="h-4 w-4 transition-transform duration-300 group-hover:translate-x-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
                    </p>
                </article>

                <article class="result-card group relative flex flex-col rounded-3xl border border-slate-200 bg-white p-7 shadow-soft transition-all duration-300 hover:-translate-y-1 hover:border-brand-200 hover:shadow-lift dark:border-slate-800 dark:bg-slate-900 dark:hover:border-brand-900">
                    <div class="flex flex-wrap items-center gap-2">
                        <span class="badge badge-pdf inline-flex items-center rounded-full bg-rose-50 px-3 py-1 text-xs font-semibold text-rose-700 dark:bg-rose-500/10 dark:text-rose-400">PDF</span>
                        <span class="text-xs font-medium text-slate-400 dark:text-slate-500">Physique</span>
                        <span aria-hidden="true" class="text-xs text-slate-300 dark:text-slate-600">•</span>
                        <span class="text-xs font-medium text-slate-400 dark:text-slate-500">1.2 Mo</span>
                    </div>
                    <h3 class="mt-4 font-display text-lg font-bold tracking-tight text-slate-900 dark:text-white">
                            <span class="absolute inset-0" aria-hidden="true"></span>
                            Fiche récapitulative de Thermodynamique Macroscopique
                        </a>
                    </h3>
                    <p class="mt-3 max-w-3xl text-[15px] leading-relaxed text-slate-500 dark:text-slate-400">
                        Résumé des formules clés du 1er et 2nd principes, coefficients thermoélastiques, bilans d'entropie et relations de Clapeyron…
                    </p>
                    <p class="mt-5 inline-flex items-center gap-2 text-sm font-semibold text-brand-600 dark:text-brand-400">
                        Télécharger le document PDF
                        <svg class="h-4 w-4 transition-transform duration-300 group-hover:translate-x-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
                    </p>
                </article>
            </div>
        </section>

        <!-- Pagination -->
        <nav aria-label="Pagination des résultats de recherche" class="mx-auto max-w-7xl px-6 py-16 lg:px-8">
            <ul class="flex items-center justify-center gap-2">
                <li><span class="inline-flex cursor-not-allowed items-center rounded-xl px-4 py-2.5 text-sm font-medium text-slate-300 dark:text-slate-600">Précédent</span></li>
                <li><a href="#" aria-current="page" class="inline-flex h-11 w-11 items-center justify-center rounded-xl bg-brand-600 text-sm font-semibold text-white shadow-glow">1</a></li>
                <li><a href="#" class="inline-flex h-11 w-11 items-center justify-center rounded-xl border border-slate-200 bg-white text-sm font-semibold text-slate-700 transition-colors hover:border-brand-300 hover:text-brand-600 dark:border-slate-800 dark:bg-slate-900 dark:text-slate-300">2</a></li>
                <li><a href="#" class="inline-flex items-center rounded-xl border border-slate-200 bg-white px-4 py-2.5 text-sm font-semibold text-slate-700 transition-colors hover:border-brand-300 hover:text-brand-600 dark:border-slate-800 dark:bg-slate-900 dark:text-slate-300">Suivant</a></li>
            </ul>
        </nav>
    </main>

    <!-- ==================================================================
         PIED DE PAGE
         ================================================================== -->
    <%- include('partials/footer') %>
</body>
</html>

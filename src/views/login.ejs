<!DOCTYPE html>
<html lang="fr" class="scroll-smooth">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="PhyChi - Espace de connexion pour accéder à votre compte, vos ressources enregistrées et vos favoris.">
    <meta name="theme-color" content="#0f172a">
    <title>PhyChi - Connexion</title>

    <!-- Application du thème avant le rendu (évite le flash blanc) -->
    <script>
        (function () {
            try {
                var saved = localStorage.getItem('psychi_theme');
                var prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
                if (saved === 'dark' || (!saved && prefersDark)) {
                    document.documentElement.classList.add('dark-theme');
                }
            } catch (e) { /* localStorage indisponible */ }
        })();
    </script>

    <!-- Typographie -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter+Tight:wght@500;600;700;800&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">

    <!-- Tailwind CSS + design system partagé -->
    <script src="https://cdn.tailwindcss.com?plugins=forms"></script>
    <script src="assets/theme.js"></script>
    <link rel="stylesheet" href="assets/ui.css">

    <script src="assets/ui.js" defer></script>
    <script src="script.js" defer></script>
    <!-- Liaison des formulaires avec l'API Express (servi par public/js/app.js) -->
    <script src="/js/app.js" defer></script>
</head>

<body class="bg-slate-50 font-sans text-slate-600 antialiased selection:bg-brand-600 selection:text-white dark:bg-slate-950 dark:text-slate-400">

    <a href="#contenu"
       class="sr-only focus:not-sr-only focus:fixed focus:left-6 focus:top-6 focus:z-[60] focus:rounded-xl focus:bg-brand-600 focus:px-5 focus:py-3 focus:text-sm focus:font-semibold focus:text-white focus:shadow-lift">
        Aller au contenu principal
    </a>

    <!-- ==================================================================
         EN-TÊTE
         ================================================================== -->
    <%- include('partials/header') %>

    <main id="contenu">
        <div class="relative isolate overflow-hidden">
            <%- include('partials/hero-decor', { heroCompact: true }) %>

            <div class="relative mx-auto grid max-w-7xl items-center gap-14 px-6 py-20 lg:grid-cols-2 lg:gap-20 lg:px-8 lg:py-28">

                <!-- Formulaire -->
                <section class="auth-section order-2 lg:order-1" aria-labelledby="titre-connexion">
                    <div class="mx-auto w-full max-w-md rounded-3xl border border-slate-200 bg-white p-8 shadow-lift sm:p-10 dark:border-slate-800 dark:bg-slate-900">
                        <h1 id="titre-connexion" class="font-display text-3xl font-extrabold tracking-tight text-slate-900 dark:text-white">
                            Connexion
                        </h1>
                        <p class="mt-3 text-[15px] leading-relaxed text-slate-500 dark:text-slate-400">
                            Accédez à vos cours sauvegardés, vos exercices favoris et votre espace personnel.
                        </p>

                        <form id="login-form" action="/api/auth/login" method="post"
                              data-endpoint="/api/auth/login" data-method="POST" data-redirect="/profil.html"
                              class="mt-8 grid gap-5">
                            <div>
                                <label for="email" class="block text-sm font-medium text-slate-700 dark:text-slate-300">
                                    Adresse e-mail ou nom d'utilisateur
                                </label>
                                <input type="text" id="email" name="email" required autocomplete="username" placeholder="exemple@domaine.com"
                                       class="mt-2 w-full rounded-xl border-slate-200 bg-white px-4 py-3 text-sm text-slate-900 shadow-sm transition-colors placeholder:text-slate-400 focus:border-brand-500 focus:ring-4 focus:ring-brand-500/10 dark:border-slate-700 dark:bg-slate-950 dark:text-white">
                            </div>

                            <div>
                                <div class="flex items-baseline justify-between gap-3">
                                    <label for="password" class="block text-sm font-medium text-slate-700 dark:text-slate-300">
                                        Mot de passe
                                    </label>
                                    <a href="#" class="text-xs font-semibold text-brand-600 underline-offset-4 hover:underline dark:text-brand-400">
                                        Mot de passe oublié ?
                                    </a>
                                </div>
                                <input type="password" id="password" name="password" required autocomplete="current-password" placeholder="Votre mot de passe"
                                       class="mt-2 w-full rounded-xl border-slate-200 bg-white px-4 py-3 text-sm text-slate-900 shadow-sm transition-colors placeholder:text-slate-400 focus:border-brand-500 focus:ring-4 focus:ring-brand-500/10 dark:border-slate-700 dark:bg-slate-950 dark:text-white">
                            </div>

                            <div class="flex items-center gap-3">
                                <input type="checkbox" id="remember" name="remember"
                                       class="h-5 w-5 rounded-md border-slate-300 text-brand-600 transition-colors focus:ring-brand-500/30 dark:border-slate-600 dark:bg-slate-950">
                                <label for="remember" class="text-sm text-slate-600 dark:text-slate-400">Se souvenir de moi</label>
                            </div>

                            <button type="submit"
                                    class="mt-2 inline-flex w-full items-center justify-center gap-2 rounded-2xl bg-brand-600 px-6 py-3.5 text-sm font-semibold text-white shadow-glow transition-all duration-300 hover:-translate-y-0.5 hover:bg-brand-700">
                                Se connecter
                                <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
                            </button>
                        </form>

                        <div class="auth-redirect mt-8 border-t border-slate-200 pt-6 text-center dark:border-slate-800">
                            <p class="text-sm text-slate-500 dark:text-slate-400">Vous n'avez pas encore de compte ?</p>
                            <a href="/inscription" class="mt-2 inline-flex items-center gap-1.5 text-sm font-semibold text-brand-600 underline-offset-4 hover:underline dark:text-brand-400">
                                Créer un compte PhyChi gratuitement
                            </a>
                        </div>
                    </div>
                </section>

                <!-- Panneau de valorisation -->
                <section class="order-1 lg:order-2" aria-labelledby="titre-avantages">
                    <nav aria-label="Fil d'Ariane" class="mb-8">
                        <ol class="flex items-center gap-2 text-sm text-slate-500 dark:text-slate-400">
                            <li><a href="/" class="transition-colors hover:text-brand-600 dark:hover:text-brand-400">Accueil</a></li>
                            <li aria-hidden="true" class="text-slate-300 dark:text-slate-600">/</li>
                            <li class="font-medium text-slate-900 dark:text-white">Connexion</li>
                        </ol>
                    </nav>

                    <p class="text-sm font-semibold uppercase tracking-[0.18em] text-brand-600 dark:text-brand-400">Espace personnel</p>
                    <h2 id="titre-avantages" class="mt-4 max-w-lg font-display text-4xl font-extrabold leading-tight tracking-tight text-slate-900 sm:text-5xl dark:text-white">
                        Reprenez là où vous vous êtes arrêté.
                    </h2>

                    <ul class="mt-10 grid max-w-lg gap-5">
                        <li class="flex gap-4">
                            <span class="grid h-11 w-11 shrink-0 place-items-center rounded-2xl bg-brand-50 text-brand-600 dark:bg-brand-500/10 dark:text-brand-400" aria-hidden="true">
                                <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"/></svg>
                            </span>
                            <div>
                                <h3 class="font-display text-base font-bold tracking-tight text-slate-900 dark:text-white">Vos favoris, partout</h3>
                                <p class="mt-1 text-[15px] leading-relaxed text-slate-500 dark:text-slate-400">Retrouvez vos cours et exercices enregistrés d'une session à l'autre.</p>
                            </div>
                        </li>
                        <li class="flex gap-4">
                            <span class="grid h-11 w-11 shrink-0 place-items-center rounded-2xl bg-flask-50 text-flask-600 dark:bg-flask-500/10 dark:text-flask-400" aria-hidden="true">
                                <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><path d="m9 11 3 3L22 4"/></svg>
                            </span>
                            <div>
                                <h3 class="font-display text-base font-bold tracking-tight text-slate-900 dark:text-white">Suivi de progression</h3>
                                <p class="mt-1 text-[15px] leading-relaxed text-slate-500 dark:text-slate-400">Visualisez les chapitres parcourus et ceux qu'il vous reste à travailler.</p>
                            </div>
                        </li>
                        <li class="flex gap-4">
                            <span class="grid h-11 w-11 shrink-0 place-items-center rounded-2xl bg-brand-50 text-brand-600 dark:bg-brand-500/10 dark:text-brand-400" aria-hidden="true">
                                <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><path d="m7 10 5 5 5-5"/><path d="M12 15V3"/></svg>
                            </span>
                            <div>
                                <h3 class="font-display text-base font-bold tracking-tight text-slate-900 dark:text-white">Téléchargements rapides</h3>
                                <p class="mt-1 text-[15px] leading-relaxed text-slate-500 dark:text-slate-400">Accédez en un clic à vos fiches PDF et sujets de TP récents.</p>
                            </div>
                        </li>
                    </ul>
                </section>
            </div>
        </div>
    </main>

    <!-- ==================================================================
         PIED DE PAGE
         ================================================================== -->
    <%- include('partials/footer') %>
</body>
</html>

<!DOCTYPE html>
<html lang="fr" class="scroll-smooth">
<%- include('partials/head') %>

<body class="bg-slate-50 font-sans text-slate-600 antialiased selection:bg-brand-600 selection:text-white dark:bg-slate-950 dark:text-slate-400">

    <a href="#contenu"
       class="sr-only focus:not-sr-only focus:fixed focus:left-6 focus:top-6 focus:z-[60] focus:rounded-xl focus:bg-brand-600 focus:px-5 focus:py-3 focus:text-sm focus:font-semibold focus:text-white focus:shadow-lift">
        Aller au contenu principal
    </a>

    <!-- ==================================================================
         EN-TÊTE
         ================================================================== -->
    <%- include('partials/header') %>

    <main id="contenu">

        <!-- En-tête de page -->
        <section class="relative isolate overflow-hidden border-b border-slate-200 bg-white dark:border-slate-800 dark:bg-slate-950">
            <%- include('partials/hero-decor') %>

            <div class="relative mx-auto max-w-7xl px-6 py-20 sm:py-24 lg:px-8">
                <nav aria-label="Fil d'Ariane" class="mb-8">
                    <ol class="flex items-center gap-2 text-sm text-slate-500 dark:text-slate-400">
                        <li><a href="/" class="transition-colors hover:text-brand-600 dark:hover:text-brand-400">Accueil</a></li>
                        <li aria-hidden="true" class="text-slate-300 dark:text-slate-600">/</li>
                        <li class="font-medium text-slate-900 dark:text-white">Favoris</li>
                    </ol>
                </nav>

                <p class="text-sm font-semibold uppercase tracking-[0.18em] text-brand-600 dark:text-brand-400">Ma sélection</p>
                <h1 class="mt-4 max-w-3xl font-display text-4xl font-extrabold leading-tight tracking-tight text-slate-900 sm:text-5xl dark:text-white">
                    Mes Contenus Favoris
                </h1>
                <p class="mt-5 max-w-2xl text-lg leading-relaxed text-slate-600 dark:text-slate-400">
                    Retrouvez rapidement l'ensemble des cours, exercices, solutions et documents que vous avez enregistrés.
                </p>
            </div>
        </section>

        <!-- Filtres -->
        <section class="filter-section mx-auto max-w-7xl px-6 py-12 lg:px-8" aria-labelledby="titre-filtres">
            <div class="rounded-3xl border border-slate-200 bg-white p-7 shadow-soft dark:border-slate-800 dark:bg-slate-900">
                <h2 id="titre-filtres" class="font-display text-lg font-bold tracking-tight text-slate-900 dark:text-white">
                    Filtrer mes favoris
                </h2>

                <form action="/favoris" method="get" class="mt-6 grid gap-5 md:grid-cols-[1fr_1fr_auto] md:items-end">
                    <div>
                        <label for="categorie" class="block text-sm font-medium text-slate-700 dark:text-slate-300">Catégorie</label>
                        <select name="categorie" id="categorie"
                                class="mt-2 w-full rounded-xl border-slate-200 bg-white py-3 pl-4 pr-10 text-sm text-slate-900 shadow-sm transition-colors focus:border-brand-500 focus:ring-4 focus:ring-brand-500/10 dark:border-slate-700 dark:bg-slate-950 dark:text-white">
                            <option value="toutes" <%= (typeof selectedCategorie === 'undefined' || selectedCategorie === 'toutes') ? 'selected' : '' %>>Toutes les catégories</option>
                            <option value="cours" <%= (typeof selectedCategorie !== 'undefined' && selectedCategorie === 'cours') ? 'selected' : '' %>>Cours</option>
                            <option value="exercices" <%= (typeof selectedCategorie !== 'undefined' && selectedCategorie === 'exercices') ? 'selected' : '' %>>Exercices</option>
                            <option value="livres" <%= (typeof selectedCategorie !== 'undefined' && selectedCategorie === 'livres') ? 'selected' : '' %>>Livres &amp; Manuels</option>
                            <option value="concours" <%= (typeof selectedCategorie !== 'undefined' && selectedCategorie === 'concours') ? 'selected' : '' %>>Concours &amp; Annales</option>
                            <option value="telechargements" <%= (typeof selectedCategorie !== 'undefined' && selectedCategorie === 'telechargements') ? 'selected' : '' %>>Fichiers PDF</option>
                        </select>
                    </div>

                    <div>
                        <label for="matiere" class="block text-sm font-medium text-slate-700 dark:text-slate-300">Matière</label>
                        <select name="matiere" id="matiere"
                                class="mt-2 w-full rounded-xl border-slate-200 bg-white py-3 pl-4 pr-10 text-sm text-slate-900 shadow-sm transition-colors focus:border-brand-500 focus:ring-4 focus:ring-brand-500/10 dark:border-slate-700 dark:bg-slate-950 dark:text-white">
                            <option value="toutes" <%= (typeof selectedMatiere === 'undefined' || selectedMatiere === 'toutes') ? 'selected' : '' %>>Toutes les matières</option>
                            <option value="physique" <%= (typeof selectedMatiere !== 'undefined' && selectedMatiere === 'physique') ? 'selected' : '' %>>Physique</option>
                            <option value="chimie" <%= (typeof selectedMatiere !== 'undefined' && selectedMatiere === 'chimie') ? 'selected' : '' %>>Chimie</option>
                        </select>
                    </div>

                    <button type="submit"
                            class="inline-flex items-center justify-center gap-2 rounded-xl bg-brand-600 px-6 py-3 text-sm font-semibold text-white shadow-glow transition-all duration-300 hover:-translate-y-0.5 hover:bg-brand-700">
                        <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 6h18M7 12h10M11 18h2"/></svg>
                        Filtrer
                    </button>
                </form>
            </div>
        </section>

        <!-- Liste des favoris -->
        <section class="favorites-list mx-auto max-w-7xl px-6 pb-4 lg:px-8" aria-labelledby="titre-favoris">
                <div class="flex flex-wrap items-baseline justify-between gap-3">
                    <h2 id="titre-favoris" class="font-display text-2xl font-extrabold tracking-tight text-slate-900 sm:text-3xl dark:text-white">
                        Ressources enregistrées
                    </h2>
                    <p class="text-sm text-slate-500 dark:text-slate-400">
                        <span data-favorites-count><%= total %></span> élément<%= total > 1 ? 's' : '' %>
                    </p>
                </div>

                <!-- Etat vide : revele par app.js quand le dernier favori est retire -->
                <div data-favorites-empty
                     class="mt-8 rounded-3xl border border-dashed border-slate-300 bg-white p-12 text-center dark:border-slate-700 dark:bg-slate-900"
                     <%= total > 0 ? 'hidden' : '' %>>
                    <h3 class="font-display text-lg font-bold text-slate-900 dark:text-white">Vous n'avez encore rien enregistré</h3>
                    <p class="mx-auto mt-2 max-w-md text-[15px] leading-relaxed text-slate-500 dark:text-slate-400">
                        Parcourez les fiches de cours et les séries d'exercices, puis utilisez le bouton
                        « Ajouter aux favoris » pour retrouver vos ressources ici.
                    </p>
                    <div class="mt-6 flex flex-wrap justify-center gap-3">
                        <a href="/cours" class="inline-flex items-center rounded-xl bg-brand-600 px-5 py-2.5 text-sm font-semibold text-white shadow-glow transition-all hover:-translate-y-0.5 hover:bg-brand-700">Voir les cours</a>
                        <a href="/exercices-physique" class="inline-flex items-center rounded-xl border border-slate-200 px-5 py-2.5 text-sm font-semibold text-slate-700 transition-colors hover:bg-slate-50 dark:border-slate-700 dark:text-slate-200 dark:hover:bg-slate-800">Voir les exercices</a>
                    </div>
                </div>

                <!-- ============================ COURS ============================ -->
                <div data-favorites-group class="mt-10" <%= favoriteCourses.length > 0 ? '' : 'hidden' %>>
                    <h3 class="font-display text-lg font-bold tracking-tight text-slate-900 dark:text-white">
                        Fiches de cours <span class="font-medium text-slate-400">(<%= favoriteCourses.length %>)</span>
                    </h3>

                    <div class="mt-6 grid gap-6 lg:grid-cols-2">
                        <% favoriteCourses.forEach(function (c) { %>
                            <% var isChimie = c.discipline_slug === 'chimie'; %>
                            <article data-favorite-card class="favorite-card flex flex-col rounded-3xl border border-slate-200 bg-white p-7 shadow-soft transition-all duration-300 hover:-translate-y-1 hover:shadow-lift dark:border-slate-800 dark:bg-slate-900">
                                <header>
                                    <div class="flex flex-wrap items-center gap-2">
                                        <span class="badge badge-cours inline-flex items-center rounded-full bg-amber-50 px-3 py-1 text-xs font-semibold text-amber-700 dark:bg-amber-500/10 dark:text-amber-400">Cours</span>
                                        <span class="inline-flex items-center rounded-full px-3 py-1 text-xs font-semibold <%= isChimie ? 'bg-flask-50 text-flask-700 dark:bg-flask-500/10 dark:text-flask-400' : 'bg-brand-50 text-brand-700 dark:bg-brand-500/10 dark:text-brand-400' %>">
                                            <%= c.discipline_nom %>
                                        </span>
                                    </div>
                                    <h4 class="mt-4 font-display text-lg font-bold tracking-tight text-slate-900 dark:text-white"><%= c.titre %></h4>
                                </header>

                                <p class="mt-2 text-xs font-medium text-slate-400 dark:text-slate-500">
                                    Niveau : <%= c.niveau.toUpperCase() %> &nbsp;•&nbsp; Chapitre : <%= c.chapter_titre %>
                                </p>
                                <p class="mt-4 flex-1 text-[15px] leading-relaxed text-slate-500 dark:text-slate-400"><%= c.description %></p>

                                <div class="card-actions mt-6 flex flex-wrap gap-2">
                                    <% if (c.course_file) { %>
                                        <button type="button"
                                                data-file-modal
                                                data-file-url="<%= c.course_file %>"
                                                data-file-title="<%= c.titre %>"
                                                data-file-label="Fiche de cours"
                                                class="inline-flex items-center gap-2 rounded-xl bg-slate-900 px-4 py-2.5 text-sm font-semibold text-white transition-colors hover:bg-brand-600 dark:bg-white dark:text-slate-900 dark:hover:bg-brand-500 dark:hover:text-white">
                                            <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z"/><circle cx="12" cy="12" r="3"/></svg>
                                            Consulter la fiche
                                        </button>
                                    <% } %>
                                    <a href="/cours/<%= c.chapter_id || c.id %>" class="inline-flex items-center rounded-xl border border-slate-200 px-4 py-2.5 text-sm font-semibold text-slate-700 transition-colors hover:bg-slate-50 dark:border-slate-700 dark:text-slate-200 dark:hover:bg-slate-800">
                                        Accéder au cours
                                    </a>
                                    <button type="button"
                                            data-fav-toggle
                                            data-item-type="<%= c.item_type || 'course' %>"
                                            data-item-id="<%= c.item_id || c.id %>"
                                            data-favorited="true"
                                            aria-pressed="true"
                                            class="inline-flex items-center gap-2 rounded-xl border border-rose-300 bg-rose-50 px-4 py-2.5 text-sm font-semibold text-rose-600 transition-colors hover:bg-rose-100 dark:border-rose-500/30 dark:bg-rose-500/10 dark:text-rose-400">
                                        <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z"/></svg>
                                        <span data-fav-label>Retirer des favoris</span>
                                    </button>
                                </div>
                            </article>
                        <% }); %>
                    </div>
                </div>

                <!-- ========================== EXERCICES ========================== -->
                <div data-favorites-group class="mt-12" <%= favoriteExercises.length > 0 ? '' : 'hidden' %>>
                    <h3 class="font-display text-lg font-bold tracking-tight text-slate-900 dark:text-white">
                        Séries d'exercices <span class="font-medium text-slate-400">(<%= favoriteExercises.length %>)</span>
                    </h3>

                    <div class="mt-6 grid gap-6 lg:grid-cols-2">
                        <% favoriteExercises.forEach(function (exo) { %>
                            <% var isChimie = exo.discipline_slug === 'chimie'; %>
                            <article data-favorite-card class="favorite-card flex flex-col rounded-3xl border border-slate-200 bg-white p-7 shadow-soft transition-all duration-300 hover:-translate-y-1 hover:shadow-lift dark:border-slate-800 dark:bg-slate-900">
                                <header>
                                    <div class="flex flex-wrap items-center gap-2">
                                        <span class="badge badge-exercice inline-flex items-center rounded-full bg-violet-50 px-3 py-1 text-xs font-semibold text-violet-700 dark:bg-violet-500/10 dark:text-violet-400">Exercice</span>
                                        <span class="inline-flex items-center rounded-full px-3 py-1 text-xs font-semibold <%= isChimie ? 'bg-flask-50 text-flask-700 dark:bg-flask-500/10 dark:text-flask-400' : 'bg-brand-50 text-brand-700 dark:bg-brand-500/10 dark:text-brand-400' %>">
                                            <%= exo.discipline_nom %>
                                        </span>
                                        <span class="inline-flex items-center rounded-full bg-slate-100 px-3 py-1 text-xs font-semibold capitalize text-slate-700 dark:bg-slate-800 dark:text-slate-300">
                                            <%= exo.difficulte %>
                                        </span>
                                    </div>
                                    <h4 class="mt-4 font-display text-lg font-bold tracking-tight text-slate-900 dark:text-white"><%= exo.titre %></h4>
                                </header>

                                <p class="mt-2 text-xs font-medium text-slate-400 dark:text-slate-500">
                                    Niveau : <%= exo.niveau.toUpperCase() %> &nbsp;•&nbsp; Chapitre : <%= exo.chapter_titre %>
                                </p>
                                <p class="mt-4 flex-1 text-[15px] leading-relaxed text-slate-500 dark:text-slate-400"><%= exo.description %></p>

                                <div class="card-actions mt-6 flex flex-wrap gap-2">
                                    <button type="button"
                                            data-file-modal
                                            data-file-url="<%= exo.enonce_file || '' %>"
                                            data-file-title="<%= exo.titre %>"
                                            data-file-label="Énoncé"
                                            data-file-empty="Aucun énoncé n'a encore été téléversé pour cet exercice."
                                            class="inline-flex items-center gap-2 rounded-xl bg-slate-900 px-4 py-2.5 text-sm font-semibold text-white transition-colors hover:bg-brand-600 dark:bg-white dark:text-slate-900 dark:hover:bg-brand-500 dark:hover:text-white">
                                        <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z"/><circle cx="12" cy="12" r="3"/></svg>
                                        Voir l'énoncé
                                    </button>
                                    <button type="button"
                                            data-file-modal
                                            data-file-url="<%= exo.correction_file || '' %>"
                                            data-file-title="<%= exo.titre %>"
                                            data-file-label="Correction"
                                            data-file-empty="La correction de cet exercice n'est pas encore disponible."
                                            class="inline-flex items-center gap-2 rounded-xl bg-emerald-600 px-4 py-2.5 text-sm font-semibold text-white transition-colors hover:bg-emerald-700">
                                        <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><path d="m9 11 3 3L22 4"/></svg>
                                        Voir la correction
                                    </button>
                                    <button type="button"
                                            data-fav-toggle
                                            data-item-type="exercise"
                                            data-item-id="<%= exo.id %>"
                                            data-favorited="true"
                                            aria-pressed="true"
                                            class="inline-flex items-center gap-2 rounded-xl border border-rose-300 bg-rose-50 px-4 py-2.5 text-sm font-semibold text-rose-600 transition-colors hover:bg-rose-100 dark:border-rose-500/30 dark:bg-rose-500/10 dark:text-rose-400">
                                        <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z"/></svg>
                                        <span data-fav-label>Retirer des favoris</span>
                                    </button>
                                </div>
                            </article>
                        <% }); %>
                    </div>
                </div>

                <!-- ============================ CHAPITRES ============================ -->
                <% if (typeof favoriteChapters !== 'undefined' && favoriteChapters && favoriteChapters.length > 0) { %>
                    <div data-favorites-group class="mt-12">
                        <h3 class="font-display text-lg font-bold tracking-tight text-slate-900 dark:text-white">
                            Modules de cours favoris <span class="font-medium text-slate-400">(<%= favoriteChapters.length %>)</span>
                        </h3>
                        <div class="mt-6 grid gap-6 lg:grid-cols-2">
                            <% favoriteChapters.forEach(function (ch) { %>
                                <article data-favorite-card class="favorite-card flex flex-col rounded-3xl border border-slate-200 bg-white p-7 shadow-soft transition-all duration-300 hover:-translate-y-1 dark:border-slate-800 dark:bg-slate-900">
                                    <header>
                                        <span class="inline-flex items-center rounded-full bg-brand-50 px-3 py-1 text-xs font-semibold text-brand-700 dark:bg-brand-500/10 dark:text-brand-400"><%= ch.discipline_nom %></span>
                                        <h4 class="mt-4 font-display text-lg font-bold text-slate-900 dark:text-white"><%= ch.titre %></h4>
                                    </header>
                                    <p class="mt-3 flex-1 text-sm text-slate-500 dark:text-slate-400"><%= ch.description %></p>
                                    <div class="mt-6 flex gap-2">
                                        <a href="/cours/<%= ch.id %>" class="inline-flex items-center gap-2 rounded-xl bg-brand-600 px-4 py-2 text-xs font-bold text-white shadow-sm hover:bg-brand-700">Accéder au cours</a>
                                        <button type="button" data-fav-toggle data-item-type="chapter" data-item-id="<%= ch.id %>" data-favorited="true" class="inline-flex items-center gap-1.5 rounded-xl border border-rose-300 bg-rose-50 px-3 py-2 text-xs font-bold text-rose-600">Retirer</button>
                                    </div>
                                </article>
                            <% }); %>
                        </div>
                    </div>
                <% } %>

                <!-- ============================ LIVRES ============================ -->
                <% if (typeof favoriteBooks !== 'undefined' && favoriteBooks && favoriteBooks.length > 0) { %>
                    <div data-favorites-group class="mt-12">
                        <h3 class="font-display text-lg font-bold tracking-tight text-slate-900 dark:text-white">
                            Livres & Manuels CPGE favoris <span class="font-medium text-slate-400">(<%= favoriteBooks.length %>)</span>
                        </h3>
                        <div class="mt-6 grid gap-6 lg:grid-cols-2">
                            <% favoriteBooks.forEach(function (bk) { %>
                                <article data-favorite-card class="favorite-card flex flex-col rounded-3xl border border-slate-200 bg-white p-7 shadow-soft transition-all duration-300 hover:-translate-y-1 dark:border-slate-800 dark:bg-slate-900">
                                    <header>
                                        <span class="inline-flex items-center rounded-full bg-amber-50 px-3 py-1 text-xs font-semibold text-amber-700 dark:bg-amber-500/10 dark:text-amber-400"><%= bk.auteur %></span>
                                        <h4 class="mt-4 font-display text-lg font-bold text-slate-900 dark:text-white"><%= bk.titre %></h4>
                                    </header>
                                    <p class="mt-3 flex-1 text-sm text-slate-500 dark:text-slate-400">Collection : <%= bk.collection %> &nbsp;•&nbsp; <%= bk.discipline %> (<%= bk.niveau %>)</p>
                                    <div class="mt-6 flex gap-2">
                                        <a href="/livres/<%= bk.id %>" class="inline-flex items-center gap-2 rounded-xl bg-slate-900 px-4 py-2 text-xs font-bold text-white shadow-sm hover:bg-brand-600 dark:bg-slate-800">Voir le livre</a>
                                        <button type="button" data-fav-toggle data-item-type="book" data-item-id="<%= bk.id %>" data-favorited="true" class="inline-flex items-center gap-1.5 rounded-xl border border-rose-300 bg-rose-50 px-3 py-2 text-xs font-bold text-rose-600">Retirer</button>
                                    </div>
                                </article>
                            <% }); %>
                        </div>
                    </div>
                <% } %>

                <!-- ============================ CONCOURS ============================ -->
                <% if (typeof favoriteConcours !== 'undefined' && favoriteConcours && favoriteConcours.length > 0) { %>
                    <div data-favorites-group class="mt-12">
                        <h3 class="font-display text-lg font-bold tracking-tight text-slate-900 dark:text-white">
                            Concours & Annales favoris <span class="font-medium text-slate-400">(<%= favoriteConcours.length %>)</span>
                        </h3>
                        <div class="mt-6 grid gap-6 lg:grid-cols-2">
                            <% favoriteConcours.forEach(function (cc) { %>
                                <article data-favorite-card class="favorite-card flex flex-col rounded-3xl border border-slate-200 bg-white p-7 shadow-soft transition-all duration-300 hover:-translate-y-1 dark:border-slate-800 dark:bg-slate-900">
                                    <header>
                                        <span class="inline-flex items-center rounded-full bg-brand-50 px-3 py-1 text-xs font-semibold text-brand-700 dark:bg-brand-500/10 dark:text-brand-400"><%= cc.ecole %> - <%= cc.annee %></span>
                                        <h4 class="mt-4 font-display text-lg font-bold text-slate-900 dark:text-white"><%= cc.titre %></h4>
                                    </header>
                                    <p class="mt-3 flex-1 text-sm text-slate-500 dark:text-slate-400"><%= cc.description %></p>
                                    <div class="mt-6 flex gap-2">
                                        <a href="/concours/<%= cc.id %>" class="inline-flex items-center gap-2 rounded-xl bg-slate-900 px-4 py-2 text-xs font-bold text-white shadow-sm hover:bg-brand-600 dark:bg-slate-800">Voir l'épreuve</a>
                                        <button type="button" data-fav-toggle data-item-type="concours" data-item-id="<%= cc.id %>" data-favorited="true" class="inline-flex items-center gap-1.5 rounded-xl border border-rose-300 bg-rose-50 px-3 py-2 text-xs font-bold text-rose-600">Retirer</button>
                                    </div>
                                </article>
                            <% }); %>
                        </div>
                    </div>
                <% } %>
        </section>

        <% if (total > 12) { %>
            <!-- Pagination -->
            <nav aria-label="Pagination des favoris" class="mx-auto max-w-7xl px-6 py-16 lg:px-8">
                <ul class="flex items-center justify-center gap-2">
                    <li><span class="inline-flex cursor-not-allowed items-center rounded-xl px-4 py-2.5 text-sm font-medium text-slate-300 dark:text-slate-600">Précédent</span></li>
                    <li><span aria-current="page" class="inline-flex h-11 w-11 items-center justify-center rounded-xl bg-brand-600 text-sm font-semibold text-white shadow-glow">1</span></li>
                    <li><span class="inline-flex cursor-not-allowed items-center rounded-xl border border-slate-200 bg-white px-4 py-2.5 text-sm font-semibold text-slate-400 dark:border-slate-800 dark:bg-slate-900 dark:text-slate-500">Suivant</span></li>
                </ul>
            </nav>
        <% } %>
    </main>

    <!-- ==================================================================
         PIED DE PAGE
         ================================================================== -->
    <%- include('partials/footer') %>

    <%- include('partials/file-modal') %>
</body>
</html>

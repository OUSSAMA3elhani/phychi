<!DOCTYPE html>
<html lang="fr" class="scroll-smooth">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="PhyChi - Mentions légales. Informations réglementaires, éditeur du site, hébergement et droits de propriété intellectuelle.">
    <meta name="theme-color" content="#0f172a">
    <title>PhyChi - Mentions Légales</title>

    <!-- Application du thème avant le rendu (évite le flash blanc) -->
    <script>
        (function () {
            try {
                var saved = localStorage.getItem('psychi_theme');
                var prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
                if (saved === 'dark' || (!saved && prefersDark)) {
                    document.documentElement.classList.add('dark-theme');
                }
            } catch (e) { /* localStorage indisponible */ }
        })();
    </script>

    <!-- Typographie -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter+Tight:wght@500;600;700;800&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">

    <!-- Tailwind CSS + design system partagé -->
    <script src="https://cdn.tailwindcss.com?plugins=forms"></script>
    <script src="assets/theme.js"></script>
    <link rel="stylesheet" href="assets/ui.css">

    <script src="assets/ui.js" defer></script>
    <script src="script.js" defer></script>
    <!-- Liaison des formulaires avec l'API Express (servi par public/js/app.js) -->
    <script src="/js/app.js" defer></script>
</head>

<body class="bg-slate-50 font-sans text-slate-600 antialiased selection:bg-brand-600 selection:text-white dark:bg-slate-950 dark:text-slate-400">

    <a href="#contenu"
       class="sr-only focus:not-sr-only focus:fixed focus:left-6 focus:top-6 focus:z-[60] focus:rounded-xl focus:bg-brand-600 focus:px-5 focus:py-3 focus:text-sm focus:font-semibold focus:text-white focus:shadow-lift">
        Aller au contenu principal
    </a>

    <!-- ==================================================================
         EN-TÊTE
         ================================================================== -->
    <%- include('partials/header') %>

    <main id="contenu">

        <!-- En-tête de page -->
        <section class="relative isolate overflow-hidden border-b border-slate-200 bg-white dark:border-slate-800 dark:bg-slate-950">
            <%- include('partials/hero-decor') %>

            <div class="relative mx-auto max-w-7xl px-6 py-20 sm:py-24 lg:px-8">
                <nav aria-label="Fil d'Ariane" class="mb-8">
                    <ol class="flex items-center gap-2 text-sm text-slate-500 dark:text-slate-400">
                        <li><a href="/" class="transition-colors hover:text-brand-600 dark:hover:text-brand-400">Accueil</a></li>
                        <li aria-hidden="true" class="text-slate-300 dark:text-slate-600">/</li>
                        <li class="font-medium text-slate-900 dark:text-white">Mentions légales</li>
                    </ol>
                </nav>

                <p class="text-sm font-semibold uppercase tracking-[0.18em] text-brand-600 dark:text-brand-400">Informations juridiques</p>
                <h1 class="mt-4 max-w-3xl font-display text-4xl font-extrabold leading-tight tracking-tight text-slate-900 sm:text-5xl dark:text-white">
                    Mentions Légales
                </h1>
                <p class="mt-5 max-w-2xl text-lg leading-relaxed text-slate-600 dark:text-slate-400">
                    Informations juridiques et réglementaires relatives à la publication et à l'hébergement du site PhyChi.
                </p>
            </div>
        </section>

        <!-- Corps de la page -->
        <div class="mx-auto grid max-w-7xl gap-12 px-6 py-16 lg:grid-cols-12 lg:gap-16 lg:px-8">

            <!-- Sommaire -->
            <aside class="lg:col-span-3">
                <nav aria-label="Sommaire de la page" class="lg:sticky lg:top-28">
                    <h2 class="text-xs font-semibold uppercase tracking-[0.16em] text-slate-400 dark:text-slate-500">Sur cette page</h2>
                    <ul class="mt-4 grid gap-1">
                            <li><a href="#edition" class="block rounded-lg px-3 py-2 text-sm text-slate-500 transition-colors hover:bg-slate-100 hover:text-slate-900 dark:text-slate-400 dark:hover:bg-slate-800 dark:hover:text-white">1. Édition du site</a></li>
                            <li><a href="#hebergement" class="block rounded-lg px-3 py-2 text-sm text-slate-500 transition-colors hover:bg-slate-100 hover:text-slate-900 dark:text-slate-400 dark:hover:bg-slate-800 dark:hover:text-white">2. Hébergement du site</a></li>
                            <li><a href="#propriete" class="block rounded-lg px-3 py-2 text-sm text-slate-500 transition-colors hover:bg-slate-100 hover:text-slate-900 dark:text-slate-400 dark:hover:bg-slate-800 dark:hover:text-white">3. Propriété intellectuelle et contrefaçons</a></li>
                            <li><a href="#responsabilite" class="block rounded-lg px-3 py-2 text-sm text-slate-500 transition-colors hover:bg-slate-100 hover:text-slate-900 dark:text-slate-400 dark:hover:bg-slate-800 dark:hover:text-white">4. Limitation de responsabilité</a></li>
                            <li><a href="#liens" class="block rounded-lg px-3 py-2 text-sm text-slate-500 transition-colors hover:bg-slate-100 hover:text-slate-900 dark:text-slate-400 dark:hover:bg-slate-800 dark:hover:text-white">5. Liens hypertextes</a></li>
                    </ul>
                </nav>
            </aside>

            <!-- Article -->
            <article class="lg:col-span-9">
                <div class="grid gap-10 rounded-3xl border border-slate-200 bg-white p-8 shadow-soft sm:p-10 dark:border-slate-800 dark:bg-slate-900">
                    <section id="edition" class="scroll-mt-28 border-b border-slate-200 pb-10 last:border-0 dark:border-slate-800">
                        <h2 class="font-display text-2xl font-extrabold tracking-tight text-slate-900 dark:text-white">1. Édition du site</h2>
                        <div class="mt-4 grid gap-4">
                        <p class="text-[15px] leading-relaxed text-slate-600 dark:text-slate-400">Le site internet <strong </p>
                        <ul class="mt-4 grid gap-3">
                            <li class="flex gap-3 text-[15px] leading-relaxed text-slate-600 dark:text-slate-400"><span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-brand-500" aria-hidden="true"></span><span><strong class="font-semibold text-slate-900 dark:text-white">Directeur de la publication :</strong> Équipe pédagogique PhyChi <strong class="font-semibold text-slate-900 dark:text-white">Contact e-mail :</strong> contact@psychi.org <strong class="font-semibold text-slate-900 dark:text-white">Responsable de la rédaction :</strong> Département de Physique &amp; Chimie</span></li>
                        </ul>
                        </div>
                    </section>

                    <section id="hebergement" class="scroll-mt-28 border-b border-slate-200 pb-10 last:border-0 dark:border-slate-800">
                        <h2 class="font-display text-2xl font-extrabold tracking-tight text-slate-900 dark:text-white">2. Hébergement du site</h2>
                        <div class="mt-4 grid gap-4">
                        <p class="text-[15px] leading-relaxed text-slate-600 dark:text-slate-400">Le site PhyChi est hébergé par :</p>
                        <ul class="mt-4 grid gap-3">
                            <li class="flex gap-3 text-[15px] leading-relaxed text-slate-600 dark:text-slate-400"><span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-brand-500" aria-hidden="true"></span><span><strong class="font-semibold text-slate-900 dark:text-white">Hébergeur :</strong> Services d'hébergement web <strong class="font-semibold text-slate-900 dark:text-white">Adresse de l'hébergeur :</strong> Service cloud, serveurs européens <strong class="font-semibold text-slate-900 dark:text-white">Site web de l'hébergeur :</strong> www.hebergeur-exemple.com</span></li>
                        </ul>
                        </div>
                    </section>

                    <section id="propriete" class="scroll-mt-28 border-b border-slate-200 pb-10 last:border-0 dark:border-slate-800">
                        <h2 class="font-display text-2xl font-extrabold tracking-tight text-slate-900 dark:text-white">3. Propriété intellectuelle et contrefaçons</h2>
                        <div class="mt-4 grid gap-4">
                        <p class="text-[15px] leading-relaxed text-slate-600 dark:text-slate-400">L'ensemble des éléments accessibles sur le site PhyChi (textes, cours, exercices, schémas, corrigés, fiches PDF, logo, icônes) reste la propriété exclusive de leurs auteurs au titre des droits d'auteur et de la propriété intellectuelle.</p>
                        <p class="text-[15px] leading-relaxed text-slate-600 dark:text-slate-400">Toute reproduction, représentation, modification, publication ou adaptation de tout ou partie des éléments du site, quel que soit le moyen ou le procédé utilisé, est interdite sans l'autorisation écrite préalable du responsable de la publication.</p>
                        <p class="text-[15px] leading-relaxed text-slate-600 dark:text-slate-400">Les contenus pédagogiques sont destinés à un usage strictement personnel, privé et non commercial à des fins d'apprentissage et d'enseignement.</p>
                        </div>
                    </section>

                    <section id="responsabilite" class="scroll-mt-28 border-b border-slate-200 pb-10 last:border-0 dark:border-slate-800">
                        <h2 class="font-display text-2xl font-extrabold tracking-tight text-slate-900 dark:text-white">4. Limitation de responsabilité</h2>
                        <div class="mt-4 grid gap-4">
                        <p class="text-[15px] leading-relaxed text-slate-600 dark:text-slate-400">L'équipe d'édition du site PhyChi s'efforce de fournir des informations et démonstrations scientifiques aussi précises que possible. Toutefois, elle ne pourra être tenue responsable des omissions, des inexactitudes ou des erreurs qui pourraient subsister dans les corrigés ou les fiches de cours.</p>
                        <p class="text-[15px] leading-relaxed text-slate-600 dark:text-slate-400">L'utilisateur est invité à signaler toute coquille ou erreur via le <a href="/contact" class="font-semibold text-brand-600 underline-offset-4 hover:underline dark:text-brand-400">formulaire de contact</a>.</p>
                        </div>
                    </section>

                    <section id="liens" class="scroll-mt-28 border-b border-slate-200 pb-10 last:border-0 dark:border-slate-800">
                        <h2 class="font-display text-2xl font-extrabold tracking-tight text-slate-900 dark:text-white">5. Liens hypertextes</h2>
                        <div class="mt-4 grid gap-4">
                        <p class="text-[15px] leading-relaxed text-slate-600 dark:text-slate-400">Le site PhyChi peut contenir des liens hypertextes renvoyant vers d'autres sites web. PhyChi ne dispose d'aucun moyen de contrôle du contenu de ces sites tiers et décline toute responsabilité quant à leur contenu ou leurs pratiques.</p>
                        </div>
                    </section>
                </div>

                <!-- Appel à l'action -->
                <div class="mt-8 flex flex-col items-start justify-between gap-5 rounded-3xl border border-slate-200 bg-white p-8 shadow-soft sm:flex-row sm:items-center dark:border-slate-800 dark:bg-slate-900">
                    <div>
                        <h2 class="font-display text-lg font-bold tracking-tight text-slate-900 dark:text-white">Une erreur à signaler ?</h2>
                        <p class="mt-2 max-w-xl text-[15px] leading-relaxed text-slate-500 dark:text-slate-400">L'utilisateur est invité à signaler toute coquille ou inexactitude via notre formulaire de contact.</p>
                    </div>
                    <a href="/contact" class="group inline-flex shrink-0 items-center gap-2 rounded-2xl bg-brand-600 px-6 py-3.5 text-sm font-semibold text-white shadow-glow transition-all duration-300 hover:-translate-y-0.5 hover:bg-brand-700">
                        Signaler une erreur
                        <svg class="h-4 w-4 transition-transform duration-300 group-hover:translate-x-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
                    </a>
                </div>
            </article>
        </div>
    </main>
    <!-- ==================================================================
         PIED DE PAGE
         ================================================================== -->
    <%- include('partials/footer') %>
</body>
</html>

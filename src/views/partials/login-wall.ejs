<%#
  « Mur de connexion » : apres 60 secondes de lecture, un visiteur non
  authentifie se voit proposer de creer un compte.

  N'est inclus que dans un test « si l'utilisateur n'est pas connecte » : le
  balisage n'existe donc jamais pour un utilisateur authentifie.
  (Un exemple litteral de ce test ne peut pas figurer ici : les delimiteurs EJS
  refermeraient ce commentaire par anticipation.)

  Note : cet ecran n'est pas une mesure de securite. Le contenu est deja dans
  le HTML envoye au navigateur et reste accessible en desactivant JavaScript.
  Pour reellement restreindre l'acces, il faudrait filtrer cote serveur.
-%>
<div id="login-wall"
     class="fixed inset-0 z-[200] hidden items-center justify-center p-4"
     role="dialog"
     aria-modal="true"
     aria-labelledby="login-wall-title">

    <!-- Voile opaque : volontairement sans gestionnaire de fermeture -->
    <div class="absolute inset-0 bg-slate-900/80 backdrop-blur-md" aria-hidden="true"></div>

    <div class="relative z-10 w-full max-w-md overflow-hidden rounded-3xl border border-slate-200 bg-white p-8 text-center shadow-lift dark:border-slate-800 dark:bg-slate-900">
        <span class="mx-auto grid h-16 w-16 place-items-center rounded-2xl bg-gradient-to-br from-brand-500 via-brand-600 to-flask-600 shadow-glow" aria-hidden="true">
            <svg class="h-8 w-8 text-white" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
                <rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/>
            </svg>
        </span>

        <h2 id="login-wall-title" class="mt-6 font-display text-2xl font-extrabold tracking-tight text-slate-900 dark:text-white">
            Connectez-vous ou inscrivez-vous pour continuer
        </h2>
        <p class="mt-3 text-[15px] leading-relaxed text-slate-500 dark:text-slate-400">
            La consultation libre est limitée. Créez un compte gratuit pour accéder sans interruption
            aux cours, aux énoncés et aux corrigés.
        </p>

        <div class="mt-8 grid gap-3">
            <a href="/inscription" class="inline-flex items-center justify-center rounded-xl bg-brand-600 px-6 py-3.5 text-sm font-semibold text-white shadow-glow transition-all hover:-translate-y-0.5 hover:bg-brand-700">
                Créer un compte gratuit
            </a>
            <a href="/login" class="inline-flex items-center justify-center rounded-xl border border-slate-200 px-6 py-3.5 text-sm font-semibold text-slate-700 transition-colors hover:bg-slate-50 dark:border-slate-700 dark:text-slate-200 dark:hover:bg-slate-800">
                J'ai déjà un compte — Se connecter
            </a>
        </div>
    </div>
</div>

<script>
    (function () {
        'use strict';

        var DELAY_MS = 60000; // 60 secondes

        window.setTimeout(function () {
            var wall = document.getElementById('login-wall');
            if (!wall) return;

            wall.classList.remove('hidden');
            wall.classList.add('flex');

            // Bloque le defilement de l'arriere-plan tant que le mur est affiche.
            document.body.classList.add('overflow-hidden');

            // Le premier lien recoit le focus, et la tabulation reste confinee
            // dans la fenetre : sans cela, le clavier continuerait de parcourir
            // la page situee derriere le voile.
            var focusables = wall.querySelectorAll('a[href]');
            if (focusables.length) focusables[0].focus();

            document.addEventListener('keydown', function (e) {
                if (wall.classList.contains('hidden')) return;

                // Aucune fermeture par Echap : la fenetre est volontairement bloquante.
                if (e.key === 'Escape') {
                    e.preventDefault();
                    return;
                }
                if (e.key === 'Tab' && focusables.length) {
                    var first = focusables[0];
                    var last = focusables[focusables.length - 1];
                    if (e.shiftKey && document.activeElement === first) {
                        e.preventDefault();
                        last.focus();
                    } else if (!e.shiftKey && document.activeElement === last) {
                        e.preventDefault();
                        first.focus();
                    }
                }
            });
        }, DELAY_MS);
    })();
</script>

<%# Pied de page partage - identique sur toutes les vues publiques.
    L etat actif des liens "Informations" derive du local `page`. -%>
<%
    var fcur = (typeof page !== 'undefined' && page) ? page : '';
    var FOOT_OFF = 'text-slate-500 transition-colors hover:text-brand-600 dark:text-slate-400 dark:hover:text-brand-400';
    var FOOT_ON  = 'font-semibold text-brand-600 dark:text-brand-400';
    var fnav = function (k) { return fcur === k ? ' aria-current="page"' : ''; };
%>
    <footer class="border-t border-slate-200 bg-white dark:border-slate-800 dark:bg-slate-950">
        <div class="mx-auto max-w-7xl px-6 py-20 lg:px-8">
            <div class="grid gap-12 lg:grid-cols-12">

                <div class="lg:col-span-4">
                    <a href="/" class="flex items-center gap-3" aria-label="PhyChi, retour à l'accueil">
                        <span class="grid h-10 w-10 place-items-center rounded-xl bg-gradient-to-br from-brand-500 via-brand-600 to-flask-600" aria-hidden="true">
                            <svg class="h-5 w-5 text-white" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
                                <circle cx="12" cy="12" r="1.4" fill="currentColor" stroke="none"/>
                                <path d="M20.2 20.2c2.04-2.03.02-7.36-4.5-11.9-4.54-4.52-9.87-6.54-11.9-4.5-2.04 2.03-.02 7.36 4.5 11.9 4.54 4.52 9.87 6.54 11.9 4.5Z"/>
                                <path d="M15.7 15.7c4.52-4.54 6.54-9.87 4.5-11.9-2.03-2.04-7.36-.02-11.9 4.5-4.52 4.54-6.54 9.87-4.5 11.9 2.03 2.04 7.36.02 11.9-4.5Z"/>
                            </svg>
                        </span>
                        <span class="font-display text-lg font-extrabold tracking-tight text-slate-900 dark:text-white">
                            Phy<span class="text-brand-600 dark:text-brand-400">Chi</span>
                        </span>
                    </a>
                    <p class="mt-6 max-w-sm text-[15px] leading-relaxed text-slate-500 dark:text-slate-400">
                        La plateforme d'apprentissage dédiée à la physique et à la chimie pour l'enseignement supérieur&nbsp;:
                        cours complets, exercices corrigés et ressources téléchargeables.
                    </p>
                </div>

                <div class="grid gap-10 sm:grid-cols-3 lg:col-span-8">
                    <nav aria-label="Ressources">
                        <h2 class="text-xs font-semibold uppercase tracking-[0.16em] text-slate-900 dark:text-white">Ressources</h2>
                        <ul class="mt-5 space-y-3 text-[15px]">
                            <li><a href="/cours" class="text-slate-500 transition-colors hover:text-brand-600 dark:text-slate-400 dark:hover:text-brand-400">Cours</a></li>
                            <li><a href="/chapitres" class="text-slate-500 transition-colors hover:text-brand-600 dark:text-slate-400 dark:hover:text-brand-400">Chapitres</a></li>
                            <li><a href="/exercices-physique" class="text-slate-500 transition-colors hover:text-brand-600 dark:text-slate-400 dark:hover:text-brand-400">Exercices Physique</a></li>
                            <li><a href="/exercices-chimie" class="text-slate-500 transition-colors hover:text-brand-600 dark:text-slate-400 dark:hover:text-brand-400">Exercices Chimie</a></li>
                        </ul>
                    </nav>

                    <nav aria-label="Mon espace">
                        <h2 class="text-xs font-semibold uppercase tracking-[0.16em] text-slate-900 dark:text-white">Mon espace</h2>
                        <ul class="mt-5 space-y-3 text-[15px]">
                            <li><a href="/login" class="text-slate-500 transition-colors hover:text-brand-600 dark:text-slate-400 dark:hover:text-brand-400">Connexion</a></li>
                            <li><a href="/inscription" class="text-slate-500 transition-colors hover:text-brand-600 dark:text-slate-400 dark:hover:text-brand-400">Inscription</a></li>
                            <li><a href="/profil" class="text-slate-500 transition-colors hover:text-brand-600 dark:text-slate-400 dark:hover:text-brand-400">Mon profil</a></li>
                            <li><a href="/favoris" class="text-slate-500 transition-colors hover:text-brand-600 dark:text-slate-400 dark:hover:text-brand-400">Favoris</a></li>
                        </ul>
                    </nav>

                    <nav aria-label="Navigation du pied de page">
                        <h2 class="text-xs font-semibold uppercase tracking-[0.16em] text-slate-900 dark:text-white">Informations</h2>
                        <ul class="mt-5 space-y-3 text-[15px]">
                            <li><a href="/apropos" data-fnav="apropos"<%- fnav('apropos') %> class="<%- fcur === 'apropos' ? FOOT_ON : FOOT_OFF %>">À propos</a></li>
                            <li><a href="/contact" data-fnav="contact"<%- fnav('contact') %> class="<%- fcur === 'contact' ? FOOT_ON : FOOT_OFF %>">Contact</a></li>
                            <li><a href="/faq" data-fnav="faq"<%- fnav('faq') %> class="<%- fcur === 'faq' ? FOOT_ON : FOOT_OFF %>">FAQ</a></li>
                            <li><a href="/mentions-legales" data-fnav="mentions-legales"<%- fnav('mentions-legales') %> class="<%- fcur === 'mentions-legales' ? FOOT_ON : FOOT_OFF %>">Mentions légales</a></li>
                            <li><a href="/politique-confidentialite" data-fnav="politique-confidentialite"<%- fnav('politique-confidentialite') %> class="<%- fcur === 'politique-confidentialite' ? FOOT_ON : FOOT_OFF %>">Politique de confidentialité</a></li>
                        </ul>
                    </nav>
                </div>
            </div>

            <div class="mt-16 flex flex-col items-center justify-between gap-4 border-t border-slate-200 pt-8 sm:flex-row dark:border-slate-800">
                <p class="text-sm text-slate-500 dark:text-slate-400">
                    &copy; 2026 PhyChi — Physique &amp; Chimie pour l'Enseignement Supérieur. Tous droits réservés.
                </p>
                <p class="text-sm text-slate-400 dark:text-slate-500">
                    Conçu pour l'enseignement supérieur.
                </p>
            </div>
        </div>
    </footer>

<%#
  En-tete partagee du site.

  Avant, ce balisage etait duplique a l'identique dans les 15 vues publiques :
  une modification de navigation devait etre repetee 15 fois. L'etat actif est
  desormais calcule a partir du local `page` fourni par pageController.

  Cles `page` reconnues : index, cours, chapitres, exercices-physique,
  exercices-chimie, exercice-details, recherche, favoris, login, inscription,
  profil, contact, apropos, faq, mentions-legales, politique-confidentialite.
-%>
<%
    var current = (typeof page !== 'undefined' && page) ? page : '';
    var on = function (key) { return current === key; };

    // Un groupe reste surligne quand l'une de ses entrees est la page courante.
    var inLearn = ['cours', 'chapitres'].indexOf(current) !== -1;
    var inTrain = ['exercices-physique', 'exercices-chimie', 'exercice-details'].indexOf(current) !== -1;

    var TOP_ON    = 'rounded-lg bg-brand-50 px-3.5 py-2 font-semibold text-brand-700 dark:bg-brand-500/10 dark:text-brand-400';
    var TOP_OFF   = 'rounded-lg px-3.5 py-2 text-slate-600 transition-colors hover:bg-slate-100 hover:text-slate-900 dark:text-slate-300 dark:hover:bg-slate-800 dark:hover:text-white';
    var GROUP_ON  = 'flex items-center gap-1.5 rounded-lg px-3.5 py-2 font-semibold text-brand-700 transition-colors hover:bg-brand-50 dark:text-brand-400 dark:hover:bg-brand-500/10';
    var GROUP_OFF = 'flex items-center gap-1.5 rounded-lg px-3.5 py-2 text-slate-600 transition-colors hover:bg-slate-100 hover:text-slate-900 dark:text-slate-300 dark:hover:bg-slate-800 dark:hover:text-white';
    var ITEM_ON   = 'flex items-start gap-3 rounded-xl bg-slate-50 px-3 py-2.5 transition-colors dark:bg-slate-800';
    var ITEM_OFF  = 'flex items-start gap-3 rounded-xl px-3 py-2.5 transition-colors hover:bg-slate-50 dark:hover:bg-slate-800';
    var MOB_ON    = 'block rounded-xl bg-brand-50 px-4 py-3 font-semibold text-brand-700 dark:bg-brand-500/10 dark:text-brand-400';
    var MOB_OFF   = 'block rounded-xl px-4 py-3 text-slate-700 transition-colors hover:bg-slate-100 dark:text-slate-300 dark:hover:bg-slate-800';

    // Les valeurs ci-dessous sont injectees en sortie brute (balise sans
    // echappement) et non en sortie echappee : ce sont des constantes de
    // gabarit, jamais des donnees utilisateur. La sortie echappee convertirait
    // les guillemets des attributs en entites et casserait le balisage.
    var aria = function (key) { return on(key) ? ' aria-current="page"' : ''; };
%>
    <header id="site-header"
            class="sticky top-0 z-50 border-b border-slate-200/80 bg-white/80 backdrop-blur-xl transition-shadow duration-300 dark:border-slate-800/80 dark:bg-slate-950/80">
        <div class="mx-auto flex max-w-7xl items-center justify-between gap-6 px-6 py-3.5 lg:px-8">

            <a href="/" class="group flex shrink-0 items-center gap-3" aria-label="PhyChi, retour à l'accueil">
                <span class="relative grid h-11 w-11 place-items-center rounded-2xl bg-gradient-to-br from-brand-500 via-brand-600 to-flask-600 shadow-glow transition-transform duration-300 group-hover:scale-105">
                    <svg class="h-6 w-6 text-white" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <circle cx="12" cy="12" r="1.4" fill="currentColor" stroke="none"/>
                        <path d="M20.2 20.2c2.04-2.03.02-7.36-4.5-11.9-4.54-4.52-9.87-6.54-11.9-4.5-2.04 2.03-.02 7.36 4.5 11.9 4.54 4.52 9.87 6.54 11.9 4.5Z"/>
                        <path d="M15.7 15.7c4.52-4.54 6.54-9.87 4.5-11.9-2.03-2.04-7.36-.02-11.9 4.5-4.52 4.54-6.54 9.87-4.5 11.9 2.03 2.04 7.36.02 11.9-4.5Z"/>
                    </svg>
                </span>
                <span class="flex flex-col leading-none">
                    <span class="font-display text-xl font-extrabold tracking-tight text-slate-900 dark:text-white">
                        Phy<span class="text-brand-600 dark:text-brand-400">Chi</span>
                    </span>
                    <span class="mt-1 hidden text-[11px] font-medium uppercase tracking-[0.16em] text-slate-400 sm:block dark:text-slate-500">
                        Physique &amp; Chimie
                    </span>
                </span>
            </a>

            <nav aria-label="Navigation principale" class="hidden xl:block">
                <ul class="flex items-center gap-1 text-sm font-medium">
                    <li>
                        <a href="/" data-nav="index"<%- aria('index') %> class="<%- on('index') ? TOP_ON : TOP_OFF %>">Accueil</a>
                    </li>

                    <li class="group relative">
                        <button type="button" data-navgroup="apprendre" class="<%- inLearn ? GROUP_ON : GROUP_OFF %>">
                            Apprendre
                            <svg class="h-4 w-4 text-slate-400 transition-transform duration-200 group-hover:rotate-180 group-focus-within:rotate-180" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
                        </button>
                        <div class="invisible absolute left-0 top-full z-10 w-64 translate-y-2 pt-3 opacity-0 transition-all duration-200 group-hover:visible group-hover:translate-y-0 group-hover:opacity-100 group-focus-within:visible group-focus-within:translate-y-0 group-focus-within:opacity-100">
                            <ul class="overflow-hidden rounded-2xl border border-slate-200 bg-white p-2 shadow-lift dark:border-slate-800 dark:bg-slate-900">
                                <li>
                                    <a href="/cours" data-nav="cours"<%- aria('cours') %> class="<%- on('cours') ? ITEM_ON : ITEM_OFF %>">
                                        <span class="mt-0.5 text-brand-600 dark:text-brand-400" aria-hidden="true">
                                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 7v14"/><path d="M3 18a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1h5a4 4 0 0 1 4 4 4 4 0 0 1 4-4h5a1 1 0 0 1 1 1v13a1 1 0 0 1-1 1h-6a3 3 0 0 0-3 3 3 3 0 0 0-3-3z"/></svg>
                                        </span>
                                        <span>
                                            <span class="block text-sm font-semibold text-slate-900 dark:text-white">Cours</span>
                                            <span class="block text-xs text-slate-500 dark:text-slate-400">Leçons complètes et structurées</span>
                                        </span>
                                    </a>
                                </li>
                                <li>
                                    <a href="/chapitres" data-nav="chapitres"<%- aria('chapitres') %> class="<%- on('chapitres') ? ITEM_ON : ITEM_OFF %>">
                                        <span class="mt-0.5 text-brand-600 dark:text-brand-400" aria-hidden="true">
                                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M8 6h13"/><path d="M8 12h13"/><path d="M8 18h13"/><path d="M3 6h.01"/><path d="M3 12h.01"/><path d="M3 18h.01"/></svg>
                                        </span>
                                        <span>
                                            <span class="block text-sm font-semibold text-slate-900 dark:text-white">Chapitres</span>
                                            <span class="block text-xs text-slate-500 dark:text-slate-400">Parcourir par programme</span>
                                        </span>
                                    </a>
                                </li>
                            </ul>
                        </div>
                    </li>

                    <li class="group relative">
                        <button type="button" data-navgroup="entrainer" class="<%- inTrain ? GROUP_ON : GROUP_OFF %>">
                            S'entraîner
                            <svg class="h-4 w-4 text-slate-400 transition-transform duration-200 group-hover:rotate-180 group-focus-within:rotate-180" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
                        </button>
                        <div class="invisible absolute left-0 top-full z-10 w-72 translate-y-2 pt-3 opacity-0 transition-all duration-200 group-hover:visible group-hover:translate-y-0 group-hover:opacity-100 group-focus-within:visible group-focus-within:translate-y-0 group-focus-within:opacity-100">
                            <ul class="overflow-hidden rounded-2xl border border-slate-200 bg-white p-2 shadow-lift dark:border-slate-800 dark:bg-slate-900">
                                <li>
                                    <a href="/exercices-physique" data-nav="exercices-physique"<%- aria('exercices-physique') %> class="<%- on('exercices-physique') ? ITEM_ON : ITEM_OFF %>">
                                        <span class="mt-0.5 text-brand-600 dark:text-brand-400" aria-hidden="true">
                                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="1"/><path d="M20.2 20.2c2.04-2.03.02-7.36-4.5-11.9-4.54-4.52-9.87-6.54-11.9-4.5-2.04 2.03-.02 7.36 4.5 11.9 4.54 4.52 9.87 6.54 11.9 4.5Z"/><path d="M15.7 15.7c4.52-4.54 6.54-9.87 4.5-11.9-2.03-2.04-7.36-.02-11.9 4.5-4.52 4.54-6.54 9.87-4.5 11.9 2.03 2.04 7.36.02 11.9-4.5Z"/></svg>
                                        </span>
                                        <span>
                                            <span class="block text-sm font-semibold text-slate-900 dark:text-white">Exercices de Physique</span>
                                            <span class="block text-xs text-slate-500 dark:text-slate-400">Mécanique, thermo, électromagnétisme</span>
                                        </span>
                                    </a>
                                </li>
                                <li>
                                    <a href="/exercices-chimie" data-nav="exercices-chimie"<%- aria('exercices-chimie') %> class="<%- on('exercices-chimie') ? ITEM_ON : ITEM_OFF %>">
                                        <span class="mt-0.5 text-flask-600 dark:text-flask-400" aria-hidden="true">
                                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10 2v7.31a2 2 0 0 1-.24.95l-5.5 9.9A2 2 0 0 0 6 23h12a2 2 0 0 0 1.74-2.84l-5.5-9.9a2 2 0 0 1-.24-.95V2"/><path d="M8.5 2h7"/><path d="M7 16h10"/></svg>
                                        </span>
                                        <span>
                                            <span class="block text-sm font-semibold text-slate-900 dark:text-white">Exercices de Chimie</span>
                                            <span class="block text-xs text-slate-500 dark:text-slate-400">Organique, cinétique, solutions</span>
                                        </span>
                                    </a>
                                </li>
                            </ul>
                        </div>
                    </li>

                    <li><a href="/recherche" data-nav="recherche"<%- aria('recherche') %> class="<%- on('recherche') ? TOP_ON : TOP_OFF %>">Recherche</a></li>
                    <li><a href="/favoris" data-nav="favoris"<%- aria('favoris') %> class="<%- on('favoris') ? TOP_ON : TOP_OFF %>">Favoris</a></li>
                </ul>
            </nav>

            <div class="flex items-center gap-2">
                <button type="button" id="theme-toggle-btn"
                        class="grid h-10 w-10 place-items-center rounded-xl border border-slate-200 bg-white text-slate-500 transition-all hover:border-slate-300 hover:text-slate-900 dark:border-slate-800 dark:bg-slate-900 dark:text-slate-400 dark:hover:text-white"
                        aria-label="Basculer entre le mode clair et le mode sombre">
                    <svg class="h-5 w-5 dark:hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"/></svg>
                    <svg class="hidden h-5 w-5 dark:block" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"/></svg>
                </button>

                <!-- Visiteur non connecté -->
                <span data-auth-slot="anonymous" class="contents">
                    <a href="/login" data-nav="login" class="hidden rounded-xl px-4 py-2.5 text-sm font-semibold text-slate-600 transition-colors hover:bg-slate-100 hover:text-slate-900 sm:inline-flex dark:text-slate-300 dark:hover:bg-slate-800 dark:hover:text-white">Connexion</a>
                    <a href="/inscription" data-nav="inscription" class="hidden rounded-xl bg-slate-900 px-4 py-2.5 text-sm font-semibold text-white shadow-soft transition-all hover:-translate-y-0.5 hover:bg-brand-600 hover:shadow-glow sm:inline-flex dark:bg-white dark:text-slate-900 dark:hover:bg-brand-500 dark:hover:text-white">Créer un compte</a>
                </span>

                <!-- Session active — révélé par public/js/app.js -->
                <span data-auth-slot="authenticated" class="contents" hidden>
                    <a href="/profil" class="hidden items-center gap-2 rounded-xl px-4 py-2.5 text-sm font-semibold text-slate-600 transition-colors hover:bg-slate-100 hover:text-slate-900 sm:inline-flex dark:text-slate-300 dark:hover:bg-slate-800 dark:hover:text-white">
                        <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
                        <span data-user-name>Mon profil</span>
                    </a>
                    <button type="button" data-logout class="hidden rounded-xl bg-slate-900 px-4 py-2.5 text-sm font-semibold text-white shadow-soft transition-all hover:-translate-y-0.5 hover:bg-rose-600 sm:inline-flex dark:bg-white dark:text-slate-900 dark:hover:bg-rose-500 dark:hover:text-white">Déconnexion</button>
                </span>

                <button type="button" id="mobile-menu-btn" aria-expanded="false" aria-controls="mobile-menu"
                        class="grid h-10 w-10 place-items-center rounded-xl border border-slate-200 bg-white text-slate-700 transition-colors hover:bg-slate-50 xl:hidden dark:border-slate-800 dark:bg-slate-900 dark:text-slate-200">
                    <span class="sr-only">Ouvrir le menu de navigation</span>
                    <svg id="icon-menu" class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M4 6h16M4 12h16M4 18h16"/></svg>
                    <svg id="icon-close" class="hidden h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M18 6 6 18M6 6l12 12"/></svg>
                </button>
            </div>
        </div>

        <nav id="mobile-menu" aria-label="Navigation mobile"
             class="hidden border-t border-slate-200 bg-white px-6 pb-8 pt-5 xl:hidden dark:border-slate-800 dark:bg-slate-950">
            <p class="px-1 pb-2 text-[11px] font-semibold uppercase tracking-[0.16em] text-slate-400 dark:text-slate-500">Navigation</p>
            <ul class="grid gap-1 text-[15px] font-medium sm:grid-cols-2">
                <li><a href="/" data-mnav="index"<%- aria('index') %> class="<%- on('index') ? MOB_ON : MOB_OFF %>">Accueil</a></li>
                <li><a href="/cours" data-mnav="cours"<%- aria('cours') %> class="<%- on('cours') ? MOB_ON : MOB_OFF %>">Cours</a></li>
                <li><a href="/chapitres" data-mnav="chapitres"<%- aria('chapitres') %> class="<%- on('chapitres') ? MOB_ON : MOB_OFF %>">Chapitres</a></li>
                <li><a href="/exercices-physique" data-mnav="exercices-physique"<%- aria('exercices-physique') %> class="<%- on('exercices-physique') ? MOB_ON : MOB_OFF %>">Exercices Physique</a></li>
                <li><a href="/exercices-chimie" data-mnav="exercices-chimie"<%- aria('exercices-chimie') %> class="<%- on('exercices-chimie') ? MOB_ON : MOB_OFF %>">Exercices Chimie</a></li>
                <li><a href="/recherche" data-mnav="recherche"<%- aria('recherche') %> class="<%- on('recherche') ? MOB_ON : MOB_OFF %>">Recherche</a></li>
                <li><a href="/favoris" data-mnav="favoris"<%- aria('favoris') %> class="<%- on('favoris') ? MOB_ON : MOB_OFF %>">Favoris</a></li>
            </ul>

            <p class="px-1 pb-2 pt-6 text-[11px] font-semibold uppercase tracking-[0.16em] text-slate-400 dark:text-slate-500">Mon compte</p>
            <div class="grid gap-3 sm:grid-cols-3">
                <a href="/login" data-mnav="login" class="rounded-xl border border-slate-200 px-4 py-3 text-center text-sm font-semibold text-slate-700 transition-colors hover:bg-slate-50 dark:border-slate-800 dark:text-slate-200 dark:hover:bg-slate-900">Connexion</a>
                <a href="/inscription" data-mnav="inscription" class="rounded-xl bg-brand-600 px-4 py-3 text-center text-sm font-semibold text-white transition-colors hover:bg-brand-700">Inscription</a>
                <a href="/profil" data-mnav="profil" class="rounded-xl border border-slate-200 px-4 py-3 text-center text-sm font-semibold text-slate-700 transition-colors hover:bg-slate-50 dark:border-slate-800 dark:text-slate-200 dark:hover:bg-slate-900">Mon profil</a>
            </div>
        </nav>
    </header>

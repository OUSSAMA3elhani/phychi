<%#
  Bouton de telechargement soumis a approbation.

  Parametres :
    dlType   'course' | 'exercise'
    dlId     identifiant de la ressource
    dlFile   chemin du fichier (vide/absent -> aucun document)
    dlStatus statut courant : undefined | 'pending' | 'approved' | 'rejected'
    dlLabel  libelle du document (ex. « l'énoncé »), facultatif

  Le lien de telechargement reel n'est rendu QUE si la demande est approuvee.
  Les autres etats n'exposent pas l'URL du fichier.
-%>
<%
    var _type = dlType;
    var _id = dlId;
    var _file = (typeof dlFile !== 'undefined' && dlFile) ? dlFile : null;
    var _status = (typeof dlStatus !== 'undefined') ? dlStatus : undefined;
    var _label = (typeof dlLabel !== 'undefined' && dlLabel) ? dlLabel : 'le document';
    var _user = (typeof user !== 'undefined') ? user : null;

    var BASE = 'inline-flex items-center gap-2 rounded-xl px-4 py-2.5 text-sm font-semibold transition-all';
%>

<% if (!_file) { %>
    <span class="<%= BASE %> border border-dashed border-slate-300 text-slate-400 dark:border-slate-700 dark:text-slate-500">
        Aucun document
    </span>

<% } else if (!_user) { %>
    <%# Visiteur : la demande exige un compte. %>
    <a href="/login?next=<%= encodeURIComponent(currentUrl || '/') %>" class="<%= BASE %> border border-slate-200 text-slate-700 hover:bg-slate-50 dark:border-slate-700 dark:text-slate-200 dark:hover:bg-slate-800">
        <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
        Connectez-vous pour demander <%= _label %>
    </a>

<% } else if (_status === 'approved') { %>
    <a href="<%= _file %>" download class="<%= BASE %> bg-emerald-600 text-white shadow-glow hover:-translate-y-0.5 hover:bg-emerald-700">
        <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><path d="m7 10 5 5 5-5"/><path d="M12 15V3"/></svg>
        Télécharger <%= _label %>
    </a>

<% } else if (_status === 'pending') { %>
    <span data-download-slot="<%= _type %>-<%= _id %>"
          class="<%= BASE %> cursor-not-allowed border border-amber-200 bg-amber-50 text-amber-700 dark:border-amber-500/30 dark:bg-amber-500/10 dark:text-amber-400"
          aria-disabled="true">
        <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg>
        En attente d'approbation
    </span>

<% } else { %>
    <%# Aucune demande, ou demande refusee : on peut (re)demander. %>
    <span data-download-slot="<%= _type %>-<%= _id %>" class="inline-flex flex-wrap items-center gap-2">
        <button type="button"
                data-download-request
                data-item-type="<%= _type %>"
                data-item-id="<%= _id %>"
                class="<%= BASE %> bg-slate-900 text-white hover:-translate-y-0.5 hover:bg-brand-600 dark:bg-white dark:text-slate-900 dark:hover:bg-brand-500 dark:hover:text-white">
            <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><path d="m7 10 5 5 5-5"/><path d="M12 15V3"/></svg>
            <span data-download-label>Demander le téléchargement</span>
        </button>

        <% if (_status === 'rejected') { %>
            <span class="inline-flex items-center rounded-full bg-rose-50 px-3 py-1 text-xs font-semibold text-rose-700 dark:bg-rose-500/10 dark:text-rose-400">
                Demande refusée
            </span>
        <% } %>
    </span>
<% } %>

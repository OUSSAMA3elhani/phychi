<%#
  Fenetre modale partagee d'apercu de fichier (PDF / image).

  Ouverte par public/js/app.js via window.openFileModal(), ou en declaratif
  depuis n'importe quel bouton portant :

      data-file-modal
      data-file-url    chemin du fichier a afficher      (obligatoire)
      data-file-title  titre affiche dans l'en-tete      (optionnel)
      data-file-label  sur-titre : « Enonce », « Corrige »… (optionnel)

  Le rendu utilise <iframe> et non <embed> : la CSP de helmet declare
  objectSrc 'none', qui bloquerait <embed> et <object>.
-%>
<div id="file-modal"
     class="fixed inset-0 z-[100] hidden items-center justify-center p-4 sm:p-6"
     role="dialog"
     aria-modal="true"
     aria-labelledby="file-modal-title">

    <!-- Voile : un clic ferme la fenetre -->
    <div data-modal-close class="absolute inset-0 bg-slate-900/70 backdrop-blur-sm" aria-hidden="true"></div>

    <div class="relative z-10 flex max-h-[90vh] w-full max-w-4xl flex-col overflow-hidden rounded-3xl border border-slate-200 bg-white shadow-lift dark:border-slate-800 dark:bg-slate-900">

        <header class="flex items-start justify-between gap-4 border-b border-slate-200 px-6 py-5 dark:border-slate-800">
            <div class="min-w-0">
                <p id="file-modal-label" class="text-xs font-semibold uppercase tracking-wider text-brand-600 dark:text-brand-400"></p>
                <h2 id="file-modal-title" class="mt-1 truncate font-display text-lg font-bold tracking-tight text-slate-900 dark:text-white"></h2>
            </div>
            <button type="button"
                    data-modal-close
                    aria-label="Fermer l'aperçu"
                    class="grid h-10 w-10 shrink-0 place-items-center rounded-xl border border-slate-200 text-slate-500 transition-colors hover:bg-slate-100 hover:text-slate-900 dark:border-slate-700 dark:text-slate-400 dark:hover:bg-slate-800 dark:hover:text-white">
                <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
                    <path d="M18 6 6 18M6 6l12 12"/>
                </svg>
            </button>
        </header>

        <!-- Corps : rempli dynamiquement par app.js -->
        <div id="file-modal-body" class="min-h-0 flex-1 overflow-auto bg-slate-50 p-4 dark:bg-slate-950"></div>

        <footer class="flex flex-wrap items-center justify-end gap-3 border-t border-slate-200 px-6 py-4 dark:border-slate-800">
            <button type="button"
                    data-modal-close
                    class="inline-flex items-center rounded-xl border border-slate-200 px-4 py-2.5 text-sm font-semibold text-slate-700 transition-colors hover:bg-slate-50 dark:border-slate-700 dark:text-slate-200 dark:hover:bg-slate-800">
                Fermer
            </button>
            <a id="file-modal-download"
               href="#"
               download
               class="inline-flex items-center gap-2 rounded-xl bg-brand-600 px-5 py-2.5 text-sm font-semibold text-white shadow-glow transition-all hover:-translate-y-0.5 hover:bg-brand-700">
                <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><path d="m7 10 5 5 5-5"/><path d="M12 15V3"/>
                </svg>
                Télécharger le fichier
            </a>
        </footer>
    </div>
</div>

<%#
  Fenetre modale partagee d'apercu de fichier (PDF / image).

  Ouverte par public/js/app.js via window.openFileModal(), ou en declaratif
  depuis n'importe quel bouton portant :

      data-file-modal
      data-file-url    chemin du fichier a afficher      (obligatoire)
      data-file-title  titre affiche dans l'en-tete      (optionnel)
      data-file-label  sur-titre : « Enonce », « Corrige »… (optionnel)

  Le rendu utilise <iframe> et non <embed> : la CSP de helmet declare
  objectSrc 'none', qui bloquerait <embed> et <object>.
-%>
<div id="file-modal"
     class="fixed inset-0 z-[100] hidden items-center justify-center p-2 sm:p-4 lg:p-6"
     role="dialog"
     aria-modal="true"
     aria-labelledby="file-modal-title">

    <!-- Voile : un clic ferme la fenetre -->
    <div data-modal-close class="absolute inset-0 bg-slate-950/80 backdrop-blur-md" aria-hidden="true"></div>

    <div id="file-modal-dialog" class="relative z-10 flex h-[92vh] max-h-[92vh] w-[96vw] max-w-7xl flex-col overflow-hidden rounded-3xl border border-slate-200 bg-white shadow-2xl transition-all duration-300 dark:border-slate-800 dark:bg-slate-900">

        <header class="flex items-center justify-between gap-4 border-b border-slate-200 px-6 py-4 dark:border-slate-800">
            <div class="min-w-0 flex-1">
                <p id="file-modal-label" class="text-xs font-bold uppercase tracking-wider text-brand-600 dark:text-brand-400"></p>
                <h2 id="file-modal-title" class="mt-0.5 truncate font-display text-lg font-bold tracking-tight text-slate-900 dark:text-white"></h2>
            </div>

            <div class="flex items-center gap-2">
                <!-- Bouton Ouvrir Nouvel Onglet -->
                <a id="file-modal-newtab"
                   href="#"
                   target="_blank"
                   rel="noopener noreferrer"
                   title="Ouvrir dans un nouvel onglet plein écran"
                   class="inline-flex items-center gap-1.5 rounded-xl border border-slate-200 bg-slate-50 px-3 py-2 text-xs font-semibold text-slate-700 transition-colors hover:bg-slate-100 hover:text-brand-600 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 dark:hover:bg-slate-700">
                    <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
                    <span class="hidden sm:inline">Plein Écran Web</span>
                </a>

                <!-- Bouton Fermer -->
                <button type="button"
                        data-modal-close
                        aria-label="Fermer l'aperçu"
                        class="grid h-10 w-10 shrink-0 place-items-center rounded-xl border border-slate-200 text-slate-500 transition-colors hover:bg-slate-100 hover:text-slate-900 dark:border-slate-700 dark:text-slate-400 dark:hover:bg-slate-800 dark:hover:text-white">
                    <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
                        <path d="M18 6 6 18M6 6l12 12"/>
                    </svg>
                </button>
            </div>
        </header>

        <!-- Corps : rempli dynamiquement par app.js -->
        <div id="file-modal-body" class="relative flex-1 overflow-hidden bg-slate-950/5 p-1 sm:p-2 dark:bg-slate-950"></div>

        <footer class="flex flex-wrap items-center justify-between gap-3 border-t border-slate-200 px-6 py-3.5 dark:border-slate-800">
            <div class="text-xs font-medium text-slate-500 dark:text-slate-400">
                💡 <span class="hidden sm:inline">Pour une meilleure lisibilité, utilisez le bouton « Plein Écran Web » ou téléchargez le PDF.</span>
            </div>

            <div class="flex items-center gap-3">
                <button type="button"
                        data-modal-close
                        class="inline-flex items-center rounded-xl border border-slate-200 px-4 py-2 text-xs font-semibold text-slate-700 transition-colors hover:bg-slate-50 dark:border-slate-700 dark:text-slate-200 dark:hover:bg-slate-800">
                    Fermer
                </button>
                <a id="file-modal-download"
                   href="#"
                   download
                   class="inline-flex items-center gap-2 rounded-xl bg-brand-600 px-4 py-2 text-xs font-bold text-white shadow-glow transition-all hover:-translate-y-0.5 hover:bg-brand-700">
                    <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><path d="m7 10 5 5 5-5"/><path d="M12 15V3"/>
                    </svg>
                    Télécharger PDF
                </a>
            </div>
        </footer>
    </div>
</div>


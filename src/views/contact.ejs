<!DOCTYPE html>
<html lang="fr" class="scroll-smooth">
<%- include('partials/head') %>

<body class="bg-slate-50 font-sans text-slate-600 antialiased selection:bg-brand-600 selection:text-white dark:bg-slate-950 dark:text-slate-400">

    <a href="#contenu"
       class="sr-only focus:not-sr-only focus:fixed focus:left-6 focus:top-6 focus:z-[60] focus:rounded-xl focus:bg-brand-600 focus:px-5 focus:py-3 focus:text-sm focus:font-semibold focus:text-white focus:shadow-lift">
        Aller au contenu principal
    </a>

    <!-- ==================================================================
         EN-TÊTE
         ================================================================== -->
    <%- include('partials/header') %>

    <main id="contenu">

        <!-- En-tête de page -->
        <section class="relative isolate overflow-hidden border-b border-slate-200 bg-white dark:border-slate-800 dark:bg-slate-950">
            <%- include('partials/hero-decor') %>

            <div class="relative mx-auto max-w-7xl px-6 py-20 sm:py-24 lg:px-8">
                <nav aria-label="Fil d'Ariane" class="mb-8">
                    <ol class="flex items-center gap-2 text-sm text-slate-500 dark:text-slate-400">
                        <li><a href="/" class="transition-colors hover:text-brand-600 dark:hover:text-brand-400">Accueil</a></li>
                        <li aria-hidden="true" class="text-slate-300 dark:text-slate-600">/</li>
                        <li class="font-medium text-slate-900 dark:text-white">Contact</li>
                    </ol>
                </nav>

                <p class="text-sm font-semibold uppercase tracking-[0.18em] text-brand-600 dark:text-brand-400">Nous écrire</p>
                <h1 class="mt-4 max-w-3xl font-display text-4xl font-extrabold leading-tight tracking-tight text-slate-900 sm:text-5xl dark:text-white">
                    Contactez-nous
                </h1>
                <p class="mt-5 max-w-2xl text-lg leading-relaxed text-slate-600 dark:text-slate-400">
                    Une question, une remarque ou une suggestion ? N'hésitez pas à nous écrire via le formulaire ci-dessous.
                </p>
            </div>
        </section>

        <!-- Formulaire + informations -->
        <div class="mx-auto grid max-w-7xl gap-10 px-6 py-16 lg:grid-cols-12 lg:gap-14 lg:px-8">

            <section class="contact-section lg:col-span-7" aria-labelledby="titre-formulaire">
                <div class="rounded-3xl border border-slate-200 bg-white p-8 shadow-soft sm:p-10 dark:border-slate-800 dark:bg-slate-900">
                    <h2 id="titre-formulaire" class="font-display text-2xl font-extrabold tracking-tight text-slate-900 dark:text-white">
                        Formulaire de message
                    </h2>
                    <p class="mt-2 text-[15px] text-slate-500 dark:text-slate-400">
                        Les champs marqués d'un astérisque sont obligatoires.
                    </p>

                    <form id="contact-form" action="/api/contact" method="post"
                          data-endpoint="/api/contact" data-method="POST"
                          class="mt-8 grid gap-5">
                        <div class="grid gap-5 sm:grid-cols-2">
                            <div>
                                <label for="nom" class="block text-sm font-medium text-slate-700 dark:text-slate-300">Nom complet *</label>
                                <input type="text" id="nom" name="nom" required autocomplete="name" placeholder="Votre nom et prénom"
                                       class="mt-2 w-full rounded-xl border-slate-200 bg-white px-4 py-3 text-sm text-slate-900 shadow-sm transition-colors placeholder:text-slate-400 focus:border-brand-500 focus:ring-4 focus:ring-brand-500/10 dark:border-slate-700 dark:bg-slate-950 dark:text-white">
                            </div>
                            <div>
                                <label for="email" class="block text-sm font-medium text-slate-700 dark:text-slate-300">Adresse e-mail *</label>
                                <input type="email" id="email" name="email" required autocomplete="email" placeholder="exemple@domaine.com"
                                       class="mt-2 w-full rounded-xl border-slate-200 bg-white px-4 py-3 text-sm text-slate-900 shadow-sm transition-colors placeholder:text-slate-400 focus:border-brand-500 focus:ring-4 focus:ring-brand-500/10 dark:border-slate-700 dark:bg-slate-950 dark:text-white">
                            </div>
                        </div>

                        <div>
                            <label for="sujet" class="block text-sm font-medium text-slate-700 dark:text-slate-300">Sujet du message *</label>
                            <select name="sujet" id="sujet" required
                                    class="mt-2 w-full rounded-xl border-slate-200 bg-white py-3 pl-4 pr-10 text-sm text-slate-900 shadow-sm transition-colors focus:border-brand-500 focus:ring-4 focus:ring-brand-500/10 dark:border-slate-700 dark:bg-slate-950 dark:text-white">
                                <option value="" disabled selected>Choisissez un sujet</option>
                                <option value="question">Question sur un cours ou un exercice</option>
                                <option value="erreur">Signalement d'une erreur</option>
                                <option value="suggestion">Proposition d'amélioration</option>
                                <option value="technique">Problème technique / compte</option>
                                <option value="autre">Autre demande</option>
                            </select>
                        </div>

                        <div>
                            <label for="message" class="block text-sm font-medium text-slate-700 dark:text-slate-300">Votre message *</label>
                            <textarea id="message" name="message" rows="7" required placeholder="Rédigez votre message ici…"
                                      class="mt-2 w-full rounded-xl border-slate-200 bg-white px-4 py-3 text-sm leading-relaxed text-slate-900 shadow-sm transition-colors placeholder:text-slate-400 focus:border-brand-500 focus:ring-4 focus:ring-brand-500/10 dark:border-slate-700 dark:bg-slate-950 dark:text-white"></textarea>
                        </div>

                        <button type="submit"
                                class="mt-2 inline-flex items-center justify-center gap-2 self-start rounded-2xl bg-brand-600 px-7 py-3.5 text-sm font-semibold text-white shadow-glow transition-all duration-300 hover:-translate-y-0.5 hover:bg-brand-700">
                            Envoyer le message
                            <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m22 2-7 20-4-9-9-4Z"/><path d="M22 2 11 13"/></svg>
                        </button>
                    </form>
                </div>
            </section>

            <section class="contact-info lg:col-span-5" aria-labelledby="titre-infos">
                <div class="rounded-3xl border border-slate-200 bg-white p-8 shadow-soft dark:border-slate-800 dark:bg-slate-900">
                    <h2 id="titre-infos" class="font-display text-xl font-bold tracking-tight text-slate-900 dark:text-white">
                        Informations de contact
                    </h2>

                    <ul class="mt-6 grid gap-6">
                        <li class="flex gap-4">
                            <span class="grid h-11 w-11 shrink-0 place-items-center rounded-2xl bg-brand-50 text-brand-600 dark:bg-brand-500/10 dark:text-brand-400" aria-hidden="true">
                                <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
                            </span>
                            <div class="min-w-0">
                                <h3 class="text-xs font-semibold uppercase tracking-[0.16em] text-slate-400 dark:text-slate-500">Adresse e-mail</h3>
                                <a href="mailto:oussamaelhani3@gmail.com" class="mt-1 block truncate text-[15px] font-medium text-slate-900 underline-offset-4 hover:underline dark:text-white">oussamaelhani3@gmail.com</a>
                            </div>
                        </li>

                        <li class="flex gap-4">
                            <span class="grid h-11 w-11 shrink-0 place-items-center rounded-2xl bg-flask-50 text-flask-600 dark:bg-flask-500/10 dark:text-flask-400" aria-hidden="true">
                                <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M14 9a2 2 0 0 1-2 2H6l-4 4V4a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2Z"/><path d="M18 9h2a2 2 0 0 1 2 2v11l-4-4h-6a2 2 0 0 1-2-2v-1"/></svg>
                            </span>
                            <div class="min-w-0">
                                <h3 class="text-xs font-semibold uppercase tracking-[0.16em] text-slate-400 dark:text-slate-500">Support pédagogique</h3>
                                <a href="mailto:support@psychi.org" class="mt-1 block truncate text-[15px] font-medium text-slate-900 underline-offset-4 hover:underline dark:text-white">support@psychi.org</a>
                            </div>
                        </li>

                        <li class="flex gap-4">
                            <span class="grid h-11 w-11 shrink-0 place-items-center rounded-2xl bg-brand-50 text-brand-600 dark:bg-brand-500/10 dark:text-brand-400" aria-hidden="true">
                                <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg>
                            </span>
                            <div>
                                <h3 class="text-xs font-semibold uppercase tracking-[0.16em] text-slate-400 dark:text-slate-500">Horaires de réponse</h3>
                                <p class="mt-1 text-[15px] font-medium text-slate-900 dark:text-white">Du lundi au vendredi, 9h00 – 18h00</p>
                            </div>
                        </li>
                    </ul>
                </div>

                <div class="mt-6 rounded-3xl border border-slate-200 bg-white p-8 shadow-soft dark:border-slate-800 dark:bg-slate-900">
                    <h2 class="font-display text-lg font-bold tracking-tight text-slate-900 dark:text-white">
                        Avant de nous écrire
                    </h2>
                    <p class="mt-2 text-[15px] leading-relaxed text-slate-500 dark:text-slate-400">
                        La réponse à votre question se trouve peut-être déjà dans notre foire aux questions.
                    </p>
                    <a href="/faq" class="group mt-5 inline-flex items-center gap-2 rounded-2xl border border-slate-200 px-5 py-3 text-sm font-semibold text-slate-900 transition-colors hover:bg-slate-50 dark:border-slate-700 dark:text-white dark:hover:bg-slate-800">
                        Consulter la FAQ
                        <svg class="h-4 w-4 transition-transform duration-300 group-hover:translate-x-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
                    </a>
                </div>
            </section>
        </div>
    </main>

    <!-- ==================================================================
         PIED DE PAGE
         ================================================================== -->
    <%- include('partials/footer') %>
</body>
</html>

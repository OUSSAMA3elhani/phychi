<!DOCTYPE html>
<html lang="fr" class="scroll-smooth">
<%- include('partials/head') %>

<body class="bg-slate-50 font-sans text-slate-600 antialiased selection:bg-brand-600 selection:text-white dark:bg-slate-950 dark:text-slate-400">
<%- include('partials/header') %>

<main id="main-content" class="min-h-screen bg-slate-50 py-10 dark:bg-slate-950">
    <div class="mx-auto max-w-7xl px-6 lg:px-8">

        <!-- ================= HERO HEADER ================= -->
        <header class="relative overflow-hidden rounded-3xl bg-gradient-to-br from-slate-900 via-brand-950 to-slate-900 p-8 text-white shadow-lift sm:p-12">
            <div class="absolute -right-20 -top-20 h-80 w-80 rounded-full bg-brand-500/10 blur-3xl" aria-hidden="true"></div>
            <div class="absolute -bottom-20 -left-20 h-80 w-80 rounded-full bg-flask-500/10 blur-3xl" aria-hidden="true"></div>

            <div class="relative max-w-3xl">
                <span class="inline-flex items-center gap-2 rounded-full bg-white/10 px-4 py-1.5 text-xs font-semibold uppercase tracking-wider text-brand-300 backdrop-blur-md">
                    <svg width="16" height="16" class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 19.5v-15A2.5 2.5 0 0 1 6.5 2H20v20H6.5a2.5 2.5 0 0 1-2.5-2.5Z"/><path d="M6 6h10"/></svg>
                    Bibliothèque de Référence CPGE
                </span>
                <h1 class="mt-4 font-display text-3xl font-extrabold tracking-tight sm:text-4xl lg:text-5xl">
                    <%= filters.discipline === 'Physique' ? 'Livres & Manuels de Physique' : (filters.discipline === 'Chimie' ? 'Livres & Manuels de Chimie' : 'Livres & Manuels de Référence') %>
                </h1>
                <p class="mt-4 text-base leading-relaxed text-slate-300 sm:text-lg">
                    <%= filters.discipline === 'Physique' ? 'Collection complète des manuels de cours, exercices corrigés et problèmes de Physique pour classes préparatoires (Pérez, Lumbroso, H-Prépa, Nathan, Garing).' : (filters.discipline === 'Chimie' ? 'Collection complète des manuels de cours, exercices corrigés et problèmes de Chimie pour classes préparatoires (Grécias, Dunod, H-Prépa).' : 'Accédez à la collection complète des manuels de cours, exercices corrigés et problèmes de Physique et Chimie pour classes préparatoires (H-Prépa, Lumbroso, Pérez, Nathan CPGE, Garing, Dunod...).') %>
                </p>

                <div class="mt-8 flex flex-wrap gap-4 text-sm font-semibold">
                    <div class="rounded-xl bg-white/10 px-4 py-2 backdrop-blur-sm">
                        <span class="block text-xl font-bold text-white"><%= pagination.total.toLocaleString() %></span>
                        <span class="text-xs text-slate-300">Livres numérisés</span>
                    </div>
                    <div class="rounded-xl bg-white/10 px-4 py-2 backdrop-blur-sm">
                        <span class="block text-xl font-bold text-brand-300"><%= filters.discipline || 'Physique & Chimie' %></span>
                        <span class="text-xs text-slate-300">Grandes Collections CPGE</span>
                    </div>
                    <div class="rounded-xl bg-white/10 px-4 py-2 backdrop-blur-sm">
                        <span class="block text-xl font-bold text-emerald-400">100% PDF</span>
                        <span class="text-xs text-slate-300">Consultation &amp; Téléchargement</span>
                    </div>
                </div>
            </div>
        </header>

        <!-- ================= ONGLETS PAR DISCIPLINE ================= -->
        <section class="mt-8" aria-label="Filtre par Discipline">
            <div class="flex flex-wrap gap-2">
                <a href="/livres" class="inline-flex items-center gap-2 rounded-xl border <%= !filters.discipline ? 'border-brand-500 bg-brand-50 font-bold text-brand-700 dark:bg-brand-500/10 dark:text-brand-400' : 'border-slate-200 bg-white font-medium text-slate-700 hover:bg-slate-50 dark:border-slate-800 dark:bg-slate-900 dark:text-slate-300' %> px-4 py-2.5 text-xs transition-all">
                    Tous les livres
                </a>
                <a href="/livres/physique" class="inline-flex items-center gap-2 rounded-xl border <%= filters.discipline === 'Physique' ? 'border-brand-500 bg-brand-50 font-bold text-brand-700 dark:bg-brand-500/10 dark:text-brand-400' : 'border-slate-200 bg-white font-medium text-slate-700 hover:bg-slate-50 dark:border-slate-800 dark:bg-slate-900 dark:text-slate-300' %> px-4 py-2.5 text-xs transition-all">
                    <svg class="h-4 w-4 text-brand-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/></svg>
                    <span>Livres de Physique (56)</span>
                </a>
                <a href="/livres/chimie" class="inline-flex items-center gap-2 rounded-xl border <%= filters.discipline === 'Chimie' ? 'border-flask-500 bg-flask-50 font-bold text-flask-700 dark:bg-flask-500/10 dark:text-flask-400' : 'border-slate-200 bg-white font-medium text-slate-700 hover:bg-slate-50 dark:border-slate-800 dark:bg-slate-900 dark:text-slate-300' %> px-4 py-2.5 text-xs transition-all">
                    <svg class="h-4 w-4 text-flask-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10 2v7.31a2 2 0 0 1-.24.95l-5.5 9.9A2 2 0 0 0 6 23h12a2 2 0 0 0 1.74-2.84l-5.5-9.9a2 2 0 0 1-.24-.95V2"/><path d="M8.5 2h7"/><path d="M7 16h10"/></svg>
                    <span>Livres de Chimie (19)</span>
                </a>
            </div>
        </section>

        <!-- ================= BARRE DE RECHERCHE ET FILTRES ================= -->
        <section class="mt-6 rounded-3xl border border-slate-200 bg-white p-6 shadow-soft dark:border-slate-800 dark:bg-slate-900" aria-label="Filtres des livres">
            <form method="GET" action="<%= filters.discipline === 'Physique' ? '/livres/physique' : (filters.discipline === 'Chimie' ? '/livres/chimie' : '/livres') %>" class="grid gap-4 sm:grid-cols-2 lg:grid-cols-5">
                
                <!-- Recherche texte -->
                <div class="lg:col-span-2">
                    <label for="search" class="block text-xs font-semibold uppercase tracking-wider text-slate-500 dark:text-slate-400">Rechercher un livre</label>
                    <div class="relative mt-1.5">
                        <input type="text" id="search" name="search" value="<%= filters.search || '' %>"
                               placeholder="Auteur, collection, thème (ex: Perez, Electromagnétisme...)"
                               class="w-full rounded-xl border border-slate-200 bg-slate-50 py-2.5 pl-10 pr-4 text-sm font-medium text-slate-900 transition-colors focus:border-brand-500 focus:bg-white focus:outline-none dark:border-slate-800 dark:bg-slate-950 dark:text-white dark:focus:border-brand-400">
                        <svg width="16" height="16" class="pointer-events-none absolute left-3 top-3 h-4 w-4 text-slate-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
                    </div>
                </div>

                <!-- Filtre Collection -->
                <div>
                    <label for="collection" class="block text-xs font-semibold uppercase tracking-wider text-slate-500 dark:text-slate-400">Collection</label>
                    <select id="collection" name="collection" class="mt-1.5 w-full rounded-xl border border-slate-200 bg-slate-50 py-2.5 px-3 text-sm font-medium text-slate-900 transition-colors focus:border-brand-500 focus:bg-white focus:outline-none dark:border-slate-800 dark:bg-slate-950 dark:text-white">
                        <option value="">Toutes les collections</option>
                        <% filterOptions.collections.forEach(function(col) { %>
                            <option value="<%= col %>" <%= filters.collection === col ? 'selected' : '' %>><%= col %></option>
                        <% }); %>
                    </select>
                </div>

                <!-- Filtre Discipline -->
                <div>
                    <label for="discipline" class="block text-xs font-semibold uppercase tracking-wider text-slate-500 dark:text-slate-400">Discipline</label>
                    <select id="discipline" name="discipline" class="mt-1.5 w-full rounded-xl border border-slate-200 bg-slate-50 py-2.5 px-3 text-sm font-medium text-slate-900 transition-colors focus:border-brand-500 focus:bg-white focus:outline-none dark:border-slate-800 dark:bg-slate-950 dark:text-white">
                        <option value="">Toutes les disciplines</option>
                        <option value="Physique" <%= filters.discipline === 'Physique' ? 'selected' : '' %>>Physique</option>
                        <option value="Chimie" <%= filters.discipline === 'Chimie' ? 'selected' : '' %>>Chimie</option>
                    </select>
                </div>

                <!-- Boutons -->
                <div class="flex items-end gap-2 sm:col-span-2 lg:col-span-1">
                    <button type="submit" class="w-full inline-flex items-center justify-center gap-2 rounded-xl bg-brand-600 px-4 py-2.5 text-xs font-semibold text-white shadow-soft transition-all hover:bg-brand-700">
                        Filtrer
                    </button>
                    <% if (filters.discipline || filters.collection || filters.search) { %>
                        <a href="/livres" class="inline-flex items-center justify-center rounded-xl border border-slate-200 px-3 py-2.5 text-xs font-semibold text-slate-600 transition-colors hover:bg-slate-100 dark:border-slate-800 dark:text-slate-300 dark:hover:bg-slate-900" title="Réinitialiser">
                            ✕
                        </a>
                    <% } %>
                </div>
            </form>
        </section>

        <!-- ================= LISTE DES LIVRES ================= -->
        <section class="mt-8" aria-label="Liste des livres de référence">
            <% if (booksList.length === 0) { %>
                <div class="rounded-3xl border border-dashed border-slate-300 bg-white p-12 text-center dark:border-slate-800 dark:bg-slate-900">
                    <svg width="48" height="48" class="mx-auto h-12 w-12 text-slate-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
                    <h2 class="mt-4 text-lg font-bold text-slate-900 dark:text-white">Aucun livre ne correspond à votre recherche</h2>
                    <p class="mt-2 text-sm text-slate-500 dark:text-slate-400">Essayez de modifier vos critères de filtrage.</p>
                    <a href="/livres" class="mt-6 inline-flex items-center gap-2 rounded-xl bg-brand-600 px-5 py-2.5 text-xs font-semibold text-white shadow-soft transition-all hover:bg-brand-700">
                        Voir tous les livres
                    </a>
                </div>
            <% } else { %>
                <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
                    <% booksList.forEach(function(book) { %>
                        <article class="group relative flex flex-col justify-between rounded-3xl border border-slate-200 bg-white p-6 shadow-soft transition-all duration-300 hover:-translate-y-1 hover:border-brand-300 hover:shadow-lift dark:border-slate-800 dark:bg-slate-900 dark:hover:border-brand-700">
                            <div>
                                <!-- Entête Badges -->
                                <div class="flex flex-wrap items-center gap-2">
                                    <span class="inline-flex items-center rounded-lg bg-brand-50 px-2.5 py-1 text-xs font-extrabold text-brand-700 dark:bg-brand-500/10 dark:text-brand-400">
                                        <%= book.collection %>
                                    </span>
                                    <span class="inline-flex items-center rounded-lg <%= book.discipline === 'Chimie' ? 'bg-flask-50 text-flask-700 dark:bg-flask-500/10 dark:text-flask-400' : 'bg-amber-50 text-amber-700 dark:bg-amber-500/10 dark:text-amber-400' %> px-2.5 py-1 text-xs font-bold">
                                        <%= book.discipline %>
                                    </span>
                                    <span class="inline-flex items-center rounded-lg bg-slate-100 px-2 py-0.5 text-xs font-medium text-slate-700 dark:bg-slate-800 dark:text-slate-300">
                                        <%= book.niveau %>
                                    </span>
                                </div>

                                <!-- Titre du livre -->
                                <h3 class="mt-4 font-display text-base font-bold text-slate-900 transition-colors group-hover:text-brand-600 dark:text-white dark:group-hover:text-brand-400">
                                    <%= book.titre %>
                                </h3>

                                <p class="mt-2 text-xs font-medium text-slate-500 dark:text-slate-400">
                                    Auteur : <span class="font-semibold text-slate-700 dark:text-slate-300"><%= book.auteur %></span>
                                </p>
                            </div>

                            <!-- Actions Consultation & Demande de Téléchargement -->
                            <div class="mt-6 border-t border-slate-100 pt-4 dark:border-slate-800">
                                <div class="grid grid-cols-2 gap-2" data-download-slot>
                                    
                                    <!-- Bouton Consulter le livre -->
                                    <button type="button"
                                            data-file-modal
                                            data-file-url="<%= book.pdf_file %>"
                                            data-file-title="<%= book.titre %>"
                                            data-file-label="<%= book.collection %> — <%= book.discipline %>"
                                            class="inline-flex items-center justify-center gap-1.5 rounded-xl border border-slate-200 bg-slate-50 px-3 py-2.5 text-xs font-bold text-slate-800 shadow-sm transition-all hover:bg-slate-100 hover:text-brand-600 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 dark:hover:bg-slate-700">
                                        <svg width="14" height="14" class="h-3.5 w-3.5 text-brand-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z"/><circle cx="12" cy="12" r="3"/></svg>
                                        Consulter
                                    </button>

                                    <!-- Demande de Téléchargement / Téléchargement Autorisé -->
                                    <% var st = (typeof downloadStatus !== 'undefined' && downloadStatus) ? downloadStatus.get(book.id) : null; %>
                                    <% if (st === 'approved') { %>
                                        <a href="<%= book.pdf_file %>"
                                           download
                                           class="inline-flex items-center justify-center gap-1.5 rounded-xl bg-emerald-600 px-3 py-2.5 text-xs font-bold text-white shadow-sm transition-all hover:bg-emerald-700">
                                            <svg width="14" height="14" class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
                                            Télécharger
                                        </a>
                                    <% } else if (st === 'pending') { %>
                                        <span class="inline-flex items-center justify-center gap-1 rounded-xl bg-amber-50 px-2 py-2.5 text-[11px] font-bold text-amber-700 border border-amber-200 dark:bg-amber-500/10 dark:border-amber-500/30 dark:text-amber-400">
                                            <svg class="h-3.5 w-3.5 animate-spin text-amber-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10" stroke-dasharray="32" stroke-dashoffset="10"></circle></svg>
                                            <span>En attente...</span>
                                        </span>
                                    <% } else { %>
                                        <button type="button"
                                                data-download-request
                                                data-item-type="book"
                                                data-item-id="<%= book.id %>"
                                                class="inline-flex items-center justify-center gap-1 rounded-xl bg-brand-600 px-2 py-2.5 text-[11px] font-bold text-white shadow-sm transition-all hover:bg-brand-700 hover:shadow-soft">
                                            <svg width="14" height="14" class="h-3.5 w-3.5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><path d="m7 10 5 5 5-5"/><path d="M12 15V3"/></svg>
                                            <span><%= st === 'rejected' ? 'Redemander' : 'Demander PDF' %></span>
                                        </button>
                                    <% } %>

                                    <% var isFavBk = (typeof favoriteBookIds !== 'undefined' && favoriteBookIds ? favoriteBookIds : []).indexOf(book.id) !== -1; %>
                                    <button type="button"
                                            data-fav-toggle
                                            data-item-type="book"
                                            data-item-id="<%= book.id %>"
                                            data-favorited="<%= isFavBk ? 'true' : 'false' %>"
                                            aria-pressed="<%= isFavBk ? 'true' : 'false' %>"
                                            class="col-span-2 inline-flex items-center justify-center gap-1.5 rounded-xl border border-slate-200 bg-white py-2 text-xs font-semibold text-slate-700 transition-all hover:border-rose-300 hover:bg-rose-50 hover:text-rose-600 dark:border-slate-800 dark:bg-slate-900 dark:text-slate-200">
                                        <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="<%= isFavBk ? 'currentColor' : 'none' %>" stroke="currentColor" stroke-width="2"><path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z"/></svg>
                                        <span data-fav-label><%= isFavBk ? 'Favori' : 'Ajouter aux favoris' %></span>
                                    </button>
                                </div>
                            </div>
                        </article>
                    <% }); %>
                </div>

                <!-- Pagination -->
                <div class="mt-10">
                    <%- include('partials/pagination') %>
                </div>
            <% } %>
        </section>

    </div>
</main>

<%- include('partials/file-modal') %>
<%- include('partials/footer') %>
</body>
</html>

<!DOCTYPE html>
<html lang="fr" class="scroll-smooth">
<%- include('partials/head') %>

<body class="bg-slate-50 font-sans text-slate-600 antialiased selection:bg-brand-600 selection:text-white dark:bg-slate-950 dark:text-slate-400">

    <a href="#contenu" class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-[60] focus:rounded-xl focus:bg-brand-600 focus:px-5 focus:py-3 focus:text-sm focus:font-semibold focus:text-white">
        Aller au contenu principal
    </a>

    <%- include('partials/header') %>

    <main id="contenu">

        <!-- En-tête du chapitre -->
        <section class="relative isolate overflow-hidden border-b border-slate-200 bg-white dark:border-slate-800 dark:bg-slate-950">
            <%- include('partials/hero-decor', { heroAccent: isChimie ? 'flask' : 'brand' }) %>

            <div class="relative mx-auto max-w-7xl px-6 py-16 sm:py-20 lg:px-8">
                <nav aria-label="Fil d'Ariane" class="mb-8">
                    <ol class="flex flex-wrap items-center gap-2 text-sm text-slate-500 dark:text-slate-400">
                        <li><a href="/" class="transition-colors hover:text-brand-600 dark:hover:text-brand-400">Accueil</a></li>
                        <li aria-hidden="true" class="text-slate-300 dark:text-slate-600">/</li>
                        <li><a href="/cours" class="transition-colors hover:text-brand-600 dark:hover:text-brand-400">Cours</a></li>
                        <li aria-hidden="true" class="text-slate-300 dark:text-slate-600">/</li>
                        <li class="font-medium text-slate-900 dark:text-white"><%= chapter.titre %></li>
                    </ol>
                </nav>

                <div class="flex flex-wrap items-center gap-2">
                    <span class="inline-flex items-center rounded-full px-3 py-1 text-xs font-semibold <%= isChimie ? 'bg-flask-50 text-flask-700 dark:bg-flask-500/10 dark:text-flask-400' : 'bg-brand-50 text-brand-700 dark:bg-brand-500/10 dark:text-brand-400' %>">
                        <%= chapter.discipline_nom %>
                    </span>
                    <span class="inline-flex items-center rounded-full bg-slate-100 px-3 py-1 text-xs font-semibold uppercase text-slate-700 dark:bg-slate-800 dark:text-slate-300">
                        <%= chapter.niveau %>
                    </span>
                </div>

                <h1 class="mt-5 max-w-4xl font-display text-3xl font-extrabold leading-tight tracking-tight text-slate-900 sm:text-4xl dark:text-white">
                    <%= chapter.titre %>
                </h1>
                <p class="mt-4 max-w-2xl text-lg leading-relaxed text-slate-600 dark:text-slate-400">
                    <%= chapter.description %>
                </p>
            </div>
        </section>

        <!-- Grille : contenu principal (2 colonnes) + latérale (1 colonne) -->
        <div class="mx-auto grid max-w-7xl gap-8 px-6 py-14 lg:grid-cols-3 lg:px-8">

            <!-- ================= COLONNE PRINCIPALE ================= -->
            <div class="min-w-0 lg:col-span-2">

                <!-- Structure Hiérarchisée du Cours et des Exercices Associés -->
                <section class="rounded-3xl border border-slate-200 bg-white p-7 shadow-soft sm:p-8 dark:border-slate-800 dark:bg-slate-900"
                         aria-labelledby="titre-fiches">
                    <div class="flex flex-wrap items-baseline justify-between gap-3 border-b border-slate-100 pb-5 dark:border-slate-800">
                        <div>
                            <h2 id="titre-fiches" class="font-display text-xl font-bold tracking-tight text-slate-900 dark:text-white">
                                Structure du cours et exercices associés
                            </h2>
                            <p class="mt-1 text-sm text-slate-500 dark:text-slate-400">
                                Chaque partie du cours est directement liée aux exercices d'application correspondants.
                            </p>
                        </div>
                        <p class="text-sm font-semibold text-brand-600 dark:text-brand-400"><%= courses.length %> partie<%= courses.length > 1 ? 's' : '' %></p>
                    </div>

                    <% if (courses.length === 0) { %>
                        <p class="mt-5 rounded-2xl border border-dashed border-slate-300 p-6 text-center text-sm text-slate-500 dark:border-slate-700 dark:text-slate-400">
                            Aucune leçon n'est encore publiée dans ce chapitre.
                        </p>
                    <% } else { %>
                        <div class="mt-6 space-y-8">
                            <% courses.forEach(function (course, cIdx) { %>
                                <article class="course-card rounded-2xl border border-slate-200 bg-slate-50/50 p-6 transition-colors dark:border-slate-800 dark:bg-slate-950/40">
                                    <div class="flex items-start gap-4">
                                        <span class="mt-0.5 grid h-8 w-8 shrink-0 place-items-center rounded-xl bg-brand-600 font-display text-sm font-bold text-white shadow-sm" aria-hidden="true">
                                            <%= cIdx + 1 %>
                                        </span>
                                        <div class="min-w-0 flex-1">
                                            <h3 class="font-display text-lg font-bold tracking-tight text-slate-900 dark:text-white"><%= course.titre %></h3>
                                            <p class="mt-1 text-sm leading-relaxed text-slate-500 dark:text-slate-400"><%= course.description %></p>

                                            <!-- Actions du cours -->
                                            <div class="mt-4 flex flex-wrap items-center gap-2">
                                                <% if (course.course_file) { %>
                                                    <button type="button"
                                                            data-file-modal
                                                            data-file-url="<%= course.course_file %>"
                                                            data-file-title="<%= course.titre %>"
                                                            data-file-label="Support de cours — <%= (typeof chapter !== 'undefined' && chapter && chapter.discipline_nom) ? chapter.discipline_nom : ((typeof discipline !== 'undefined' && discipline) ? discipline.nom : 'Physique & Chimie') %>"
                                                            class="inline-flex items-center gap-1.5 rounded-xl <%= isChimie ? 'bg-flask-600 hover:bg-flask-700' : 'bg-brand-600 hover:bg-brand-700' %> px-4 py-2 text-xs font-semibold text-white shadow-glow transition-all hover:-translate-y-0.5">
                                                        <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z"/><circle cx="12" cy="12" r="3"/></svg>
                                                        <span>Consulter le cours</span>
                                                    </button>
                                                <% } %>

                                                <%- include('partials/download-button', {
                                                    dlType: 'course',
                                                    dlId: course.id,
                                                    dlFile: course.course_file,
                                                    dlStatus: downloadStatus.get(course.id),
                                                    dlLabel: 'le cours'
                                                }) %>

                                                <% var isFavCrs = (typeof favoriteCourseIds !== 'undefined' && favoriteCourseIds ? favoriteCourseIds : []).indexOf(course.id) !== -1; %>
                                                <button type="button"
                                                        data-fav-toggle
                                                        data-item-type="course"
                                                        data-item-id="<%= course.id %>"
                                                        data-favorited="<%= isFavCrs ? 'true' : 'false' %>"
                                                        aria-pressed="<%= isFavCrs ? 'true' : 'false' %>"
                                                        class="inline-flex items-center gap-1.5 rounded-xl border px-4 py-2 text-xs font-semibold transition-all <%= isFavCrs ? 'border-rose-300 bg-rose-50 text-rose-600' : 'border-slate-200 bg-white text-slate-700 hover:bg-slate-50' %> dark:border-slate-800 dark:bg-slate-900 dark:text-slate-200">
                                                    <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="<%= isFavCrs ? 'currentColor' : 'none' %>" stroke="currentColor" stroke-width="2"><path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z"/></svg>
                                                    <span data-fav-label><%= isFavCrs ? 'Favori' : 'Favoris' %></span>
                                                </button>
                                            </div>

                                            <!-- Exercices associés directement à cette partie du cours -->
                                            <div class="mt-6 border-t border-slate-200/80 pt-5 dark:border-slate-800">
                                                <div class="flex items-center justify-between gap-2">
                                                    <h4 class="text-xs font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300">
                                                        Exercices associés à cette partie (<%= (course.exercises || []).length %>)
                                                    </h4>
                                                </div>

                                                <% if (course.exercises && course.exercises.length > 0) { %>
                                                    <ul class="mt-3 grid gap-3">
                                                        <% course.exercises.forEach(function (exo) { %>
                                                            <li>
                                                                <a href="/exercices/<%= exo.id %>"
                                                                   class="group flex flex-wrap items-center justify-between gap-3 rounded-xl border border-slate-200 bg-white p-4 transition-all hover:-translate-y-0.5 hover:border-brand-300 hover:shadow-soft dark:border-slate-800 dark:bg-slate-900 dark:hover:border-brand-700">
                                                                    <div class="min-w-0 flex-1">
                                                                        <div class="flex flex-wrap items-center gap-1.5">
                                                                            <span class="inline-flex items-center rounded-full bg-slate-100 px-2 py-0.5 text-[10px] font-semibold uppercase text-slate-600 dark:bg-slate-800 dark:text-slate-300"><%= exo.niveau %></span>
                                                                            <span class="inline-flex items-center rounded-full bg-amber-50 px-2 py-0.5 text-[10px] font-semibold capitalize text-amber-700 dark:bg-amber-500/10 dark:text-amber-400"><%= exo.difficulte %></span>
                                                                        </div>
                                                                        <p class="mt-1 text-sm font-bold text-slate-900 transition-colors group-hover:text-brand-600 dark:text-white dark:group-hover:text-brand-400"><%= exo.titre %></p>
                                                                    </div>
                                                                    <span class="inline-flex items-center gap-1 text-xs font-semibold text-brand-600 transition-transform group-hover:translate-x-1 dark:text-brand-400">
                                                                        Résoudre →
                                                                    </span>
                                                                </a>
                                                            </li>
                                                        <% }); %>
                                                    </ul>
                                                <% } else { %>
                                                    <p class="mt-2 text-xs italic text-slate-400 dark:text-slate-500">
                                                        Les exercices spécifiques à cette partie sont consultables dans la banque globale.
                                                    </p>
                                                <% } %>
                                            </div>

                                        </div>
                                    </div>
                                </article>
                            <% }); %>
                        </div>
                    <% } %>
                </section>

                <!-- Navigation entre cours & Retour -->
                <div class="mt-8 flex flex-wrap items-center justify-between gap-4 border-t border-slate-200 pt-6 dark:border-slate-800">
                    <a href="/cours" class="inline-flex items-center gap-2 rounded-xl border border-slate-200 bg-white px-4 py-2.5 text-sm font-semibold text-slate-700 shadow-sm transition-all hover:bg-slate-50 dark:border-slate-800 dark:bg-slate-900 dark:text-slate-200 dark:hover:bg-slate-800">
                        <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 12H5"/><path d="m12 19-7-7 7-7"/></svg>
                        ← Retour à la liste des cours
                    </a>

                    <div class="flex items-center gap-2">
                        <% if (typeof prevCourse !== 'undefined' && prevCourse) { %>
                            <a href="/cours/<%= prevCourse.id %>" class="inline-flex items-center gap-1.5 rounded-xl border border-slate-200 bg-white px-4 py-2.5 text-xs font-semibold text-slate-700 shadow-sm transition-all hover:border-brand-300 dark:border-slate-800 dark:bg-slate-900 dark:text-slate-200">
                                ← <%= prevCourse.titre %>
                            </a>
                        <% } %>
                        <% if (typeof nextCourse !== 'undefined' && nextCourse) { %>
                            <a href="/cours/<%= nextCourse.id %>" class="inline-flex items-center gap-1.5 rounded-xl border border-slate-200 bg-white px-4 py-2.5 text-xs font-semibold text-slate-700 shadow-sm transition-all hover:border-brand-300 dark:border-slate-800 dark:bg-slate-900 dark:text-slate-200">
                                <%= nextCourse.titre %> →
                            </a>
                        <% } %>
                    </div>
                </div>
            </div>

            <!-- ================= COLONNE LATÉRALE ================= -->
            <aside class="min-w-0 lg:col-span-1" aria-label="Chapitres liés">
                <div class="grid gap-6 lg:sticky lg:top-24">
                    <section class="rounded-3xl border border-slate-200 bg-white p-6 shadow-soft dark:border-slate-800 dark:bg-slate-900"
                             aria-labelledby="titre-lies">
                        <h2 id="titre-lies" class="font-display text-base font-bold tracking-tight text-slate-900 dark:text-white">
                            Chapitres liés
                        </h2>

                        <% if (siblings.length === 0) { %>
                            <p class="mt-3 text-sm text-slate-500 dark:text-slate-400">Aucun autre chapitre dans cette discipline pour l'instant.</p>
                        <% } else { %>
                            <ul class="mt-4 grid gap-3">
                                <% siblings.forEach(function (sib) { %>
                                    <li>
                                        <a href="/chapitres/<%= sib.id %>"
                                           class="group block rounded-2xl border border-slate-200 p-4 transition-all hover:-translate-y-0.5 hover:border-brand-300 hover:shadow-soft dark:border-slate-800 dark:hover:border-brand-700">
                                            <span class="inline-flex items-center rounded-full bg-slate-100 px-2 py-0.5 text-[11px] font-semibold uppercase text-slate-600 dark:bg-slate-800 dark:text-slate-300"><%= sib.niveau %></span>
                                            <p class="mt-2 text-sm font-semibold leading-snug text-slate-900 transition-colors group-hover:text-brand-600 dark:text-white dark:group-hover:text-brand-400">
                                                <%= sib.titre %>
                                            </p>
                                            <p class="mt-1 text-xs text-slate-400 dark:text-slate-500"><%= sib.courses_count %> fiche<%= sib.courses_count > 1 ? 's' : '' %></p>
                                        </a>
                                    </li>
                                <% }); %>
                            </ul>
                        <% } %>

                        <a href="/cours" class="mt-5 inline-flex items-center gap-1.5 text-sm font-semibold text-brand-600 transition-colors hover:text-brand-700 dark:text-brand-400">
                            Tous les chapitres
                            <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
                        </a>
                    </section>
                </div>
            </aside>
        </div>
    </main>

    <%- include('partials/footer') %>
    <%- include('partials/file-modal') %>

    <% if (!user) { %>
        <%- include('partials/login-wall') %>
    <% } %>
</body>
</html>

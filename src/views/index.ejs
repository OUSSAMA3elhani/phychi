                            <svg class="h-5 w-5 transition-transform duration-300 group-hover:translate-x-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
                        </a>
                        <a href="/login"
                           class="inline-flex w-full items-center justify-center rounded-2xl border border-white/20 px-7 py-4 text-base font-semibold text-white transition-colors duration-300 hover:bg-white/10 sm:w-auto">
                            J'ai déjà un compte
                        </a>
                    </div>
                </div>
            </div>
        </section>
    </main>

    <!-- ==================================================================
         PIED DE PAGE
         ================================================================== -->
    <%- include('partials/footer') %>

    <script>
        window.HERO_EQUATIONS = <%- JSON.stringify(typeof allEquations !== 'undefined' ? allEquations : []) %>;
        (function () {
            const equations = window.HERO_EQUATIONS;
            if (!Array.isArray(equations) || equations.length === 0) return;

            let currentIndex = 0;

            function updateHeroEquation(eq) {
                const mainCard = document.getElementById('hero-main-card');
                const floatingCard = document.getElementById('hero-floating-card');
                if (!mainCard || !floatingCard) return;

                mainCard.classList.add('opacity-30');
                floatingCard.classList.add('opacity-30');

                setTimeout(() => {
                    const badge = document.getElementById('hero-discipline-badge');
                    if (badge) {
                        badge.textContent = eq.discipline;
                        badge.className = eq.disciplineSlug === 'chimie'
                            ? 'inline-flex items-center gap-1.5 rounded-full px-3 py-1 text-xs font-semibold bg-flask-50 text-flask-700 dark:bg-flask-500/10 dark:text-flask-400'
                            : 'inline-flex items-center gap-1.5 rounded-full px-3 py-1 text-xs font-semibold bg-brand-50 text-brand-700 dark:bg-brand-500/10 dark:text-brand-400';
                    }

                    const tag = document.getElementById('hero-chapter-tag');
                    if (tag) tag.textContent = eq.chapterTag;

                    const title = document.getElementById('hero-card-title');
                    if (title) title.textContent = eq.title;

                    const desc = document.getElementById('hero-card-desc');
                    if (desc) desc.textContent = eq.description;

                    const formula = document.getElementById('hero-card-formula');
                    if (formula) formula.innerHTML = eq.formulaHtml;

                    const formulaName = document.getElementById('hero-card-formula-name');
                    if (formulaName) formulaName.textContent = eq.formulaName;

                    const progText = document.getElementById('hero-card-progression-text');
                    if (progText) progText.innerHTML = eq.progression + '&nbsp;%';

                    const progBar = document.getElementById('hero-card-progression-bar');
                    if (progBar) progBar.style.width = eq.progression + '%';

                    const fTitle = document.getElementById('hero-floating-title');
                    if (fTitle) fTitle.textContent = eq.floating.title;

                    const fSub = document.getElementById('hero-floating-subtitle');
                    if (fSub) fSub.textContent = eq.floating.subtitle;

                    const fFormula = document.getElementById('hero-floating-formula');
                    if (fFormula) fFormula.innerHTML = eq.floating.formulaHtml;

                    mainCard.classList.remove('opacity-30');
                    floatingCard.classList.remove('opacity-30');
                }, 200);
            }

            function pickNextRandom() {
                let nextIdx;
                do {
                    nextIdx = Math.floor(Math.random() * equations.length);
                } while (nextIdx === currentIndex && equations.length > 1);
                currentIndex = nextIdx;
                updateHeroEquation(equations[currentIndex]);
            }

            const btnShuffle = document.getElementById('btn-shuffle-equation');
            if (btnShuffle) {
                btnShuffle.addEventListener('click', function() {
                    pickNextRandom();
                });
            }

            // Changement d'équation aléatoire automatique toutes les 7 secondes
            setInterval(pickNextRandom, 7000);
        })();
    </script>
</body>
</html>
